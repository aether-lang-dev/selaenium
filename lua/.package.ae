// Lua consumer package. The rock is consumed in-place (its loader reads src/ +
// the built C extension + the staged native/), so packaging stages the engine
// .so into native/ (dlopen'd at run time via SELENIUM_CORE_LIB / the bundled
// copy), builds the Lua 5.4 C extension (selenium_core_native.so) via
// lua.c_extension, and publishes the module dir on the "package_dir" edge for the
// consumer-install proof (lua/.example.ae). Skipped by preflight when no C
// compiler / lua headers.
import bldr
import lua
import lua (c_source, ext_output, host_source)
import copy

aeb(cap) {
    bldr.build() {
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("native/libselenium_core.so")
        }
        lua.c_extension() {
            c_source("src/selenium_core.c")
            ext_output("selenium_core_native.so")
            host_source("host/lua54.c")
        }
        publish_artifact("package_dir", bldr._get(builder_context(), "source_dir"))
    }
}
