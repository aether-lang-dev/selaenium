// Lua consumer-install proof: prove the packaged rock drives the engine from a
// CLEAN environment for a third party. lua.consumer_example stages the package
// (selenium.lua + the C extension + native/.so + consumer.lua — no core/)
// as lua-pkg, asserts the .so shipped, then runs the consumer from that dir with
// LUA_PATH/LUA_CPATH pointed there, SEL_MODE=<mode> (via a shell wrapper) and
// SELENIUM_CORE_LIB unset — so only the bundled .so satisfies the load. Modes:
// ffi/discovery/live. Skipped by the gate when a Lua 5.4 runner is absent.
import bldr
import lua
import lua (stage, run_in, run_cmd, run_arg, assert_file)

aeb(cap) {
    bldr.build() {
        dep("lua/.package.ae")
        lua.consumer_example() {
            stage("src/selenium.lua", "lua-pkg/selenium.lua")
            stage("selenium_core_native.so", "lua-pkg/selenium_core_native.so")
            stage("native/libselenium_core.so", "lua-pkg/native/libselenium_core.so")
            stage("example/consumer.lua", "lua-pkg/consumer.lua")
            assert_file("lua-pkg/native/libselenium_core.so")
            run_in("lua-pkg")
            // SEL_MODE is passed as $1 via a shell wrapper (the run builder
            // appends the mode as an argv, which becomes $1 for the consumer).
            run_cmd("sh -c 'SEL_MODE=\"$1\" LUA_PATH=./?.lua LUA_CPATH=./?.so lua5.4 consumer.lua' _")
            run_arg("ffi")
            run_arg("discovery")
            run_arg("live")
        }
    }
}
