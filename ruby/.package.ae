// Ruby consumer package (the gem). Bundles the engine .so into lib/ (what the
// gemspec's Dir['lib/**/*'] ships) then builds the gem from the hand-written
// selenium-webdriver.gemspec via ruby.gem(){ build(...) } (aeb v0.303 — was
// ruby.package(){ gemspec(...) } before), which publishes the dist dir on the
// "gem_dir" edge for the consumer-install proof (ruby/.example.ae). The .so
// staging is declarative (copy.file) into the SOURCE lib tree so the gem picks
// it up. Skipped by preflight when ruby is absent (prereq ruby:3).
import bldr
import ruby
import ruby (rbenv, build)
import copy

aeb(cap) {
    bldr.build() {
        prereq("ruby:3")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("lib/selenium/native/libselenium_core.so")
        }
        ruby.gem() {
            rbenv()   // rbenv-managed Ruby (see ruby/.tests.ae; aeb v0.306 grammar)
            build("selenium-webdriver.gemspec")
        }
    }
}
