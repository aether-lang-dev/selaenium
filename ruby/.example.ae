// Ruby consumer-install proof: prove the packaged gem installs + runs from a
// CLEAN environment for a third party. ruby.consumer_example does `gem install
// --local` of the dep's built .gem into an isolated GEM_HOME (no source tree),
// then runs the consumer with GEM_HOME/GEM_PATH = that dir and SELENIUM_CORE_LIB
// unset — so `require 'selenium_core'` resolves the INSTALLED gem and only its
// bundled .so satisfies the load. Modes: ffi/discovery/live (live self-skips).
// Skipped by preflight when ruby is absent (prereq ruby:3).
import bldr
import ruby
import ruby (consumer_script, consumer_arg)

aeb(cap) {
    bldr.build() {
        prereq("ruby:3")
        dep("ruby/.package.ae")
        ruby.consumer_example() {
            consumer_script("example/consumer_example.rb")
            consumer_arg("ffi")
            consumer_arg("discovery")
            consumer_arg("live")
        }
    }
}
