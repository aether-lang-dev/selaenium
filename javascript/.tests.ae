// JavaScript/Node binding tests (koffi). The loader honors SELENIUM_CORE_LIB,
// injected here from the engine's shared_lib artifact. The tests are real
// node:test suites (no jest): the no-browser FFI facts (ffi_test) plus the
// live-Chrome smoke+surface (live_test), which spawns its own content server +
// chromedriver and self-skips when chromedriver is absent. `npm test` runs
// `node --test test/`; npm_install() resolves koffi (offline if cached) first.
// Skipped by preflight when node is absent (prereq node:18).
import bldr
import javascript

aeb(cap) {
    bldr.build() {
        prereq("node:18")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        javascript.test() {
            env("SELENIUM_CORE_LIB", lib)
            npm_install("--silent --no-audit --no-fund")
        }
    }
}
