// JavaScript/Node binding tests (koffi). The loader honors SELENIUM_CORE_LIB,
// which we point at the shared engine artifact this node deps. Tests use the
// built-in node:test runner (no jest), so we run them directly with `node
// --test`. The live test spawns its own out-of-process content server and
// chromedriver, and self-skips if chromedriver is absent. Ensures koffi is
// installed first.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    jsdir = "${root}/javascript"

    // Ensure koffi is present (offline if cached). node_modules is gitignored.
    ins = os.system("cd \"${jsdir}\" && (test -d node_modules/koffi || npm install --silent --no-audit --no-fund)")
    if ins != 0 {
        println("js tests: npm install (koffi) failed")
        return 1
    }
    rc = os.system("cd \"${jsdir}\" && SELENIUM_CORE_LIB=\"${lib}\" node --test test/ffi_test.js")
    if rc != 0 {
        println("js tests: ffi_test FAILED")
        return 1
    }
    rc2 = os.system("cd \"${jsdir}\" && SELENIUM_CORE_LIB=\"${lib}\" node --test test/live_test.js")
    if rc2 != 0 {
        println("js tests: live_test FAILED")
        return 1
    }
    println("js tests: PASSED (ffi + live+surface)")
    return 0
}
