// JavaScript/Node consumer package (the npm tarball). Bundles the engine .so
// into native/ (in the package.json "files" whitelist, so npm pack ships it)
// then packs the tarball via javascript.pack, which publishes the pkgout dir on
// the "tarball_dir" edge for the consumer-install proof (javascript/.example.ae).
// copy.file stages the .so declaratively. Skipped by preflight when node is
// absent (prereq node:18).
import bldr
import javascript
import copy

aeb(cap) {
    bldr.build() {
        prereq("node:18")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("native/libselenium_core.so")
        }
        javascript.pack() {
        }
    }
}
