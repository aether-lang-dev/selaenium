// Aggregate target set: everything that must be green before pushing the Aether
// Selenium core. A named set is just dep() edges — bldr.build() with no builders,
// only prerequisites. Running `aeb .presubmit.ae` from the repo root builds the
// engine + drives every binding's test node (each skips green where its
// toolchain is absent).
//
// 24 language bindings over ONE pure-Aether engine (libselenium_core.so, the flat
// aether_sel_embed_* C ABI) — see README.md for the whole picture. The native
// Aether client is the only no-FFI binding; the JVM/CLR/BEAM families ride one
// shared binding each (Java jar / C# P/Invoke / Erlang NIF).
//
// The .example.ae consumer-install proofs ARE wired in (bottom of the list).
// They had been omitted on the belief that they still needed an aeb
// consumer_example() builder; they do not — all eleven run under aeb v0.309.
// Leaving them out had a cost: `.tests.ae` proves the binding against the
// SOURCE tree, so nothing was checking that the thing we publish actually
// works. Four were broken when first run (2026-09-13) — the python wheel
// shipped no engine .so at all, the packaged rust crate could not compile, and
// the javascript consumer was on a renamed package plus the pre-async API —
// none of which any `.tests.ae` can see. See docs/Consumer-Install.md.
import bldr

aeb(cap) {
    bldr.build() {
        // engine + its no-browser probe
        dep("selenium_core/.build.ae")
        dep("selenium_core/tests/.tests.ae")

        // the standalone Grid hub (server side) + its pure routing probe. The
        // LIVE hub is proven separately by `grid/run-grid-test.sh --hub`, which
        // needs a driver and so is not part of a toolchain-only presubmit.
        dep("grid/.build.ae")
        dep("grid/.tests.ae")

        // the native Aether client (no FFI — drives the engine in-process)
        dep("aether/.tests.ae")

        // FFI bindings
        dep("python/.tests.ae")
        dep("go/.tests.ae")
        dep("ruby/.tests.ae")
        dep("javascript/.tests.ae")
        dep("java/.tests.ae")
        dep("dotnet/SeleniumCore.Tests/.tests.ae")
        dep("rust/.tests.ae")
        dep("dart/.tests.ae")
        dep("nim/.tests.ae")
        dep("zig/.tests.ae")
        dep("lua/.tests.ae")
        dep("php/.tests.ae")
        dep("haskell/.tests.ae")
        dep("swift/.tests.ae")
        dep("julia/.tests.ae")
        dep("crystal/.tests.ae")

        // JVM family — ride the ONE Java FFM jar over JVM interop (no second FFI).
        dep("kotlin/.tests.ae")
        dep("clojure/.tests.ae")
        dep("groovy/.tests.ae")
        dep("scala/.tests.ae")

        // CLR family — ride the ONE C# P/Invoke binding.
        dep("fsharp/.tests.ae")

        // BEAM family — Erlang owns the shared NIF; Elixir/Gleam/LFE ride it.
        dep("erlang/.tests.ae")
        dep("gleam/.tests.ae")
        dep("elixir/.tests.ae")
        dep("lfe/.tests.ae")

        // Consumer-install proofs: build the distributable (wheel / gem / npm
        // package / jar / crate / module), install it into a CLEAN environment
        // with no source tree and no SELENIUM_CORE_LIB, and drive the engine
        // from it. This is the only layer that can catch a packaging break —
        // a relative -L that resolves against the consumer's directory, an
        // asset that never made it into the archive, a module the staging list
        // forgot. All eleven green as of 2026-09-13.
        //
        // swift/ has NO .example.ae, and that is exactly where a
        // consumer-only bug was found by hand (a relative "-L native" in
        // Package.swift); worth adding.
        dep("python/.example.ae")
        dep("ruby/.example.ae")
        dep("javascript/.example.ae")
        dep("java/.example.ae")
        dep("go/.example.ae")
        dep("rust/.example.ae")
        dep("dart/.example.ae")
        dep("nim/.example.ae")
        dep("zig/.example.ae")
        dep("lua/.example.ae")
        dep("d/.example.ae")
    }
}
