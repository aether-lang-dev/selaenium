// core/embed.ae — the flat C ABI over the pure-Aether Selenium engine.
//
// Build as a shared library and dlsym/link the exports:
//
//     ae build --emit=lib --with=net core/embed.ae \
//         --extra core/_embed_strdup.c -o core/native/libselenium_core.so
//
// No protocol logic lives here — the command catalog, route table, path
// templating, By/capabilities normalization, W3C error decode and the HTTP
// round-trip all stay in core/selenium_core.ae. This layer adds only the
// embedding seam a raw module surface lacks:
//
//   * caller-owned C strings — every string result is duplicated via
//     sel_embed_dup; the host frees it with sel_embed_free_string;
//   * an opaque handle (the *Session pointer) so N independent sessions
//     coexist in one process;
//   * flat, scalar-only signatures — no Aether tuples/structs/closures cross
//     the boundary, so a ctypes/Fiddle/koffi/Panama binding can describe every
//     symbol with primitive types alone.
//
// Export naming: every function is prefixed `sel_embed_`, so under --emit=lib
// it lands as `aether_sel_embed_<name>`. The ABI is append-only — never
// renumber a constant, never change a signature; add a new symbol instead.
//
// Lifecycle: open -> execute (repeatedly) -> quit -> close.
//
//     void* h = aether_sel_embed_open("http://127.0.0.1:9515");
//     int rc  = aether_sel_embed_execute(h, "newSession", capsJson);
//     char* v = aether_sel_embed_last_value(h);   // JSON result payload
//     ...
//     aether_sel_embed_execute(h, "quit", "{}");
//     aether_sel_embed_close(h);

import selenium_core
import selenium_core (Session)
import driver
import selenium_bidi
import std.string

// Caller-owned-string helper (core/_embed_strdup.c): malloc/strdup a C string
// the host owns and later frees via sel_embed_free_string.
extern sel_embed_dup(s: string) -> string
extern sel_embed_free(s: string)

// ---- lifecycle ----

// Create a session handle bound to a remote-end base URL, e.g.
// "http://127.0.0.1:9515" (chromedriver) or a Grid hub URL. No network I/O
// happens until sel_embed_execute(h, "newSession", ...). Returns the opaque
// handle (never null under normal allocation).
sel_embed_open(base_url: string) -> ptr {
    return selenium_core.session_new(base_url)
}

// Release the session handle. Does NOT send a "quit" — a well-behaved host
// executes "quit" first to end the browser session, then closes the handle.
// NULL-safe.
sel_embed_close(h: ptr) {
    selenium_core.session_free(h)
}

// ---- TLS for an https:// remote end (Grid over HTTPS; ae 0.606+) ----
// A plain https:// base_url already follows the system CA store. For a
// self-hosted Grid with its own CA, pin it (verify against THIS cert); for a
// self-signed dev Grid, skip verification. Call before the first execute().

// Pin the peer cert against a private CA file ("" reverts to the system store).
sel_embed_set_ca(h: ptr, ca_path: string) {
    selenium_core.session_set_ca(h, ca_path)
}

// Skip TLS verification (self-signed dev/staging Grid). on=1 to skip, 0 to verify.
sel_embed_set_insecure(h: ptr, on: int) {
    selenium_core.session_set_insecure(h, on)
}

// ---- the one workhorse ----

// Execute a WebDriver command by name with JSON parameters (params_json may be
// "" or "{}" for none). Returns 0 on success, a non-zero W3C error code on a
// protocol error (see sel_embed_error_code_name), or -1 on transport failure.
// After the call, drain the result via the accessors below.
sel_embed_execute(h: ptr, name: string, params_json: string) -> int {
    return selenium_core.execute(h, name, params_json)
}

// ---- atom-backed commands (no direct W3C endpoint; run in-page via a JS atom) ----
//
// isDisplayed / getAttribute / getText have no W3C HTTP route — classic Selenium
// implements them as injected JS "atoms". The engine owns the ONE atom source
// (core/atoms.ae) and runs it via executeScript, so a binding calls these like
// any other command instead of re-implementing the JS. Result drains via
// last_value (a JSON boolean / string / null). Returns 0 / W3C error code / -1.

// Run an atom by name (isDisplayed / getAttribute / getText) against an element.
// extra_json is a JSON array of extra args (e.g. "[\"href\"]" for getAttribute),
// "" or "[]" for none.
sel_embed_execute_atom(h: ptr, atom_name: string, elem_id: string, extra_json: string) -> int {
    return selenium_core.execute_atom(h, atom_name, elem_id, extra_json)
}

// Convenience: is the element displayed? last_value is a JSON boolean.
sel_embed_is_displayed(h: ptr, elem_id: string) -> int {
    return selenium_core.execute_atom(h, "isDisplayed", elem_id, "")
}

// Convenience: the classic getAttribute(name) (property-or-attribute). last_value
// is a JSON string or null.
sel_embed_get_attribute(h: ptr, elem_id: string, name: string) -> int {
    return selenium_core.execute_atom(h, "getAttribute", elem_id, sel_embed_atom_str_arg(name))
}

// Build a one-string JSON array arg ["<s>"] for an atom's extra_json. Caller frees.
sel_embed_atom_str_arg(s: string) -> string {
    return sel_embed_dup(selenium_core.atom_str_arg(s))
}

// Relative locators (findElementsRelative atom): candidates matching base_sel
// (CSS), filtered by spatial relations to anchors. filters_json is a JSON array
// of {kind, sel[, dist]} with kind in above/below/left/right/near. last_value is
// a JSON array of element references (nearest anchor first).
sel_embed_find_relative(h: ptr, base_sel: string, filters_json: string) -> int {
    return selenium_core.execute_relative(h, base_sel, filters_json)
}

// ---- result accessors (drain after execute) ----

// The response `value` as JSON text (the useful payload: a string, number,
// object or array — the binding parses it in its own language). Caller frees.
sel_embed_last_value(h: ptr) -> string {
    return sel_embed_dup(selenium_core.last_value_of(h))
}

// HTTP status of the last response (0 = transport failure before a response).
sel_embed_last_status(h: ptr) -> int {
    return selenium_core.last_status_of(h)
}

// Decoded W3C error code of the last execute (0 = success). Maps to a stable
// integer via selenium_core.error_code(); see sel_embed_error_code_name.
sel_embed_last_error_code(h: ptr) -> int {
    return selenium_core.last_error_code_of(h)
}

// Human-readable error / transport-failure message of the last execute.
// Empty on success. Caller frees.
sel_embed_last_error(h: ptr) -> string {
    return sel_embed_dup(selenium_core.last_error_of(h))
}

// The current session id ("" until a newSession has succeeded). Caller frees.
sel_embed_session_id(h: ptr) -> string {
    return sel_embed_dup(selenium_core.session_id_of(h))
}

// ---- pure helpers a binding may want without a live session ----

// The W3C locator JSON {"using":...,"value":...} for a (strategy, value) pair,
// with id/name/className rewritten to CSS exactly as the JS/Python bindings do.
// Caller frees. A binding uses this to build findElement params.
sel_embed_by_locator(strategy: string, value: string) -> string {
    return sel_embed_dup(selenium_core.by_locator(strategy, value))
}

// The "METHOD PATH" route for a command name, or "" if unknown. Exposed for
// bindings that want to inspect the protocol mapping. Caller frees.
sel_embed_route(name: string) -> string {
    return sel_embed_dup(selenium_core.route(name))
}

// The concrete wire request for a command WITHOUT sending it: returns
// "METHOD\tPATH\tBODY" (tab-separated) or "ERR\t<message>\t". Lets a binding
// (or a test) inspect exactly what the engine would send. Caller frees.
sel_embed_build_request(name: string, session_id: string, params_json: string) -> string {
    return sel_embed_dup(selenium_core.build_request(name, session_id, params_json))
}

// Map a W3C error string to its stable integer code (0 = success). Lets a
// binding share the ONE code table rather than duplicating it.
sel_embed_error_code(w3c_error: string) -> int {
    return selenium_core.error_code(w3c_error)
}

// ---- driver-process orchestration (launch layer) ----
//
// Spawn, reach, and reap the driver process (chromedriver/geckodriver/…) so no
// binding re-implements process management. See docs/Driver-Orchestration-ABI.md.
// The resolution verb (resolve/ensure) is v1 = PATH lookup and GROWS into full
// driver management (detect→version→match→cache→download→CfT) with no ABI change.
// Lifecycle: ensure_driver → driver_url → open → … → close → stop_driver.

// Resolve the driver binary for `browser` ("chrome"/"firefox"/"edge"/… or a
// driver name directly). v1: the conventional driver on PATH. `hint` is a
// reserved opts/JSON string. Returns an absolute path or "" (caller frees).
sel_embed_resolve_driver(browser: string, hint: string) -> string {
    return sel_embed_dup(driver.resolve_driver(browser, hint))
}

// Spawn an explicit driver binary on a free port and wait up to timeout_ms for
// readiness. Returns an opaque driver handle, or null if it never came up.
sel_embed_launch_driver(driver_path: string, timeout_ms: int) -> ptr {
    return driver.launch(driver_path, timeout_ms)
}

// resolve_driver(browser,hint) then launch. Returns a driver handle, or null —
// the binding's cue to SKIP a live test (same "no driver" semantics as before).
sel_embed_ensure_driver(browser: string, hint: string, timeout_ms: int) -> ptr {
    return driver.ensure(browser, hint, timeout_ms)
}

// The "http://127.0.0.1:<port>" to pass to sel_embed_open(). Caller frees.
sel_embed_driver_url(dh: ptr) -> string {
    return sel_embed_dup(driver.url_of(dh))
}

// The driver's spawn token / pid (diagnostics). -1 if the handle is null.
sel_embed_driver_pid(dh: ptr) -> int {
    return driver.pid_of(dh)
}

// Kill + reap the driver process and free the handle. NULL-safe.
sel_embed_stop_driver(dh: ptr) {
    driver.stop(dh)
}

// ---- WebDriver-BiDi (shape C: central demux, non-blocking poll) ----
//
// The multiplexed BiDi transport over the session's webSocketUrl. The engine
// owns the ONE demux (single reader → id-keyed reply table + bounded event
// queue) exposed through non-blocking poll calls; the engine holds NO thread —
// a binding drives the wait with its own event loop (poll the fd / pump), then
// drains replies+events. See docs/WebDriver-BiDi.md. Append-only; strings
// caller-owned. Needs the ws primitives in ae 0.607+ (ws_recv_timeout/poll/fd).
//
// Flow: a W3C newSession with webSocketUrl:true (over the existing execute ABI)
// yields a webSocketUrl → bidi_open(url) → send(id, method, params) → wait on
// bidi_fd / pump → poll_reply(id) / poll_event → close.

// Open the BiDi channel to a session's webSocketUrl. Returns an opaque handle
// (null on connect failure), independent of the W3C session handle.
sel_embed_bidi_open(ws_url: string) -> ptr {
    return selenium_bidi.bidi_open(ws_url)
}

sel_embed_bidi_close(h: ptr) {
    selenium_bidi.bidi_close(h)
}

// Frame + send one command; the CALLER supplies the id (so concurrent commands
// stay distinct and compose with the binding's async). Returns 0 sent / -1 err.
sel_embed_bidi_send(h: ptr, id: int, method: string, params_json: string) -> int {
    return selenium_bidi.bidi_send(h, id, method, params_json)
}

// Advance the single demux ONE step: read up to one frame (bounded by
// timeout_ms via ws_recv_timeout) and route it (reply→id-table, event→queue).
// Returns 1 routed / 0 timed out / -1 closed. No engine thread — the binding
// loops this (or waits on the fd) then drains via the poll calls below.
sel_embed_bidi_pump(h: ptr, timeout_ms: int) -> int {
    return selenium_bidi.bidi_pump(h, timeout_ms)
}

// The readable socket fd, for a native event loop (asyncio.add_reader/epoll).
// Readiness is a HINT: on wake, always drain via bidi_pump(h, 0) until 0.
sel_embed_bidi_fd(h: ptr) -> int {
    return selenium_bidi.bidi_fd(h)
}

// The reply JSON for a command id if it has arrived (and consume it), else "".
// Returns immediately. Caller frees.
sel_embed_bidi_poll_reply(h: ptr, id: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_poll_reply(h, id))
}

// The next queued event JSON (and dequeue), or "". Returns immediately. Frees.
sel_embed_bidi_poll_event(h: ptr) -> string {
    return sel_embed_dup(selenium_bidi.bidi_poll_event(h))
}

// How many events the bounded queue dropped, then resets to 0 (so a consumer
// knows it missed events — BEEP's flow-control lesson).
sel_embed_bidi_lost_events(h: ptr) -> int {
    return selenium_bidi.bidi_lost_events(h)
}

// A waiter gave up: drop its pending-reply slot so a late reply is discarded.
sel_embed_bidi_cancel(h: ptr, id: int) {
    selenium_bidi.bidi_cancel(h, id)
}

// ---- BiDi events (subscribe + wait) ----
//
// The bidirectional half: session.subscribe to event names, then receive the
// async events on the demux queue. These are convenience verbs over the
// send/pump/poll primitives above — a binding can also drive subscribe by hand
// via bidi_send("session.subscribe", …) + poll_event. events_csv is a
// comma-separated list of BiDi event names (e.g.
// "log.entryAdded,browsingContext.load"). Caller supplies the id.

// session.subscribe to events_csv; waits for the ack. Returns the ack JSON (""
// on failure). After it returns, matching events land on the queue. Caller frees.
sel_embed_bidi_subscribe(h: ptr, id: int, events_csv: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_subscribe(h, id, events_csv, timeout_ms))
}

// session.unsubscribe from events_csv; waits for the ack. Caller frees.
sel_embed_bidi_unsubscribe(h: ptr, id: int, events_csv: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_unsubscribe(h, id, events_csv, timeout_ms))
}

// Pump the demux until an event with method `method` arrives, or timeout_ms.
// Returns the event JSON, or "" on timeout/close. Non-matching events dequeued
// while waiting are dropped by this helper — a binding that needs every event
// drives bidi_pump + bidi_poll_event itself. Caller frees.
sel_embed_bidi_wait_event(h: ptr, method: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_wait_event(h, method, timeout_ms))
}

// ---- typed BiDi convenience commands (thin wrappers over bidi_command) ----

// browsingContext.getTree — result.contexts[] with each context's id. Caller frees.
sel_embed_bidi_get_tree(h: ptr, id: int, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_get_tree(h, id, timeout_ms))
}

// script.evaluate an expression in context_id's realm (awaiting a promise). The
// reply's result.result is the BiDi-serialized value. Caller frees.
sel_embed_bidi_script_evaluate(h: ptr, id: int, expression: string, context_id: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_script_evaluate(h, id, expression, context_id, timeout_ms))
}

// browsingContext.navigate context_id to url (wait:complete). Caller frees.
sel_embed_bidi_navigate(h: ptr, id: int, context_id: string, url: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_navigate(h, id, context_id, url, timeout_ms))
}

// ---- network interception (network.*) ----
// The BiDi capability classic WebDriver lacks: observe/modify/block requests.
// All return the reply JSON (caller frees). request ids come from the
// network.beforeRequestSent event; the intercept id from add_intercept's reply.

// network.addIntercept for a URL pattern (substring; "" = all) at phases_csv
// (e.g. "beforeRequestSent"). Reply's result.intercept is the intercept id.
sel_embed_bidi_network_add_intercept(h: ptr, id: int, phases_csv: string, url_pattern: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_add_intercept(h, id, phases_csv, url_pattern, timeout_ms))
}

sel_embed_bidi_network_remove_intercept(h: ptr, id: int, intercept_id: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_remove_intercept(h, id, intercept_id, timeout_ms))
}

// Let a paused (intercepted) request proceed unchanged.
sel_embed_bidi_network_continue_request(h: ptr, id: int, request_id: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_continue_request(h, id, request_id, timeout_ms))
}

// Block a paused request (ad/tracker blocking).
sel_embed_bidi_network_fail_request(h: ptr, id: int, request_id: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_fail_request(h, id, request_id, timeout_ms))
}

// Fulfill a paused request with a MOCK response (network.provideResponse) — the
// request-mocking capability. status is the HTTP status; content_type sets
// Content-Type ("" to omit); body is the raw response body ("" for none).
sel_embed_bidi_network_provide_response(h: ptr, id: int, request_id: string, status: int, content_type: string, body: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_provide_response(h, id, request_id, status, content_type, body, timeout_ms))
}

// Answer an HTTP auth challenge (a paused authRequired request) with credentials.
sel_embed_bidi_network_continue_with_auth(h: ptr, id: int, request_id: string, username: string, password: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_continue_with_auth(h, id, request_id, username, password, timeout_ms))
}

// Set the session HTTP cache behavior ("bypass" to disable, "default" to restore).
sel_embed_bidi_network_set_cache_behavior(h: ptr, id: int, behavior: string, timeout_ms: int) -> string {
    return sel_embed_dup(selenium_bidi.bidi_network_set_cache_behavior(h, id, behavior, timeout_ms))
}

// ---- string ownership ----

// Free any char* returned by a sel_embed_* function above.
sel_embed_free_string(s: string) {
    sel_embed_free(s)
}
