// cache.ae — the driver binary cache + download/unpack (the FS + NET-download
// edge of the Selenium-Manager pipeline). Ports the cache-path derivation +
// download/unzip/chmod from the classic Rust files.rs/downloads.rs (see
// docs/Selenium-Manager-chromedriver-algorithm.md).
//
// Cache-first: derive <cache>/<driver>/<label>/<version>/<driver>, return it if
// present (the fast, offline, common path); else download the resolved zip,
// unzip (stripping the 115+ top-level folder), chmod 0755, and return it. unzip
// is shelled (a system tool, at the FS-adapter edge, exactly as the Rust
// uncompress shells to format tools).
import std.os
import std.list
import std.string
import std.file
import std.fs
import std.http.client

// default_cache_root() — <home>/.cache/selenium (SE_CACHE_PATH overrides).
// On Windows prefer USERPROFILE (a native C:\... path) over HOME: under
// MSYS/git-bash HOME is set to a POSIX-style /c/Users/... which PowerShell's
// -LiteralPath (used by the unzip step) rejects as "not a valid file system
// path". Backslashes are normalized to forward slashes, which the Windows file
// APIs accept, so the cache layout is uniform across OSes.
default_cache_root() -> string {
    env = os.getenv("SE_CACHE_PATH")
    if string.length(env) > 0 { return env }
    home = ""
    if _is_windows() == 1 {
        home = os.getenv("USERPROFILE")
        home = string.replace_all(home, "\\", "/")
    }
    if string.length(home) == 0 { home = os.getenv("HOME") }
    if string.length(home) == 0 { home = "/tmp" }
    return string.concat(home, "/.cache/selenium")
}

// driver_path_in_cache(root, driver_name, label, version) — the spec's
// compose_driver_path_in_cache: <root>/<driver>/<label>/<version>/<driver>.
driver_path_in_cache(root: string, driver_name: string, label: string, version: string) -> string {
    d = string.concat(root, string.concat("/", driver_name))
    d = string.concat(d, string.concat("/", label))
    d = string.concat(d, string.concat("/", version))
    return string.concat(d, string.concat("/", driver_name))
}

// cached(path) — 1 if the driver binary is already present (cache hit).
cached(path: string) -> int {
    return file_exists(path)
}

// ensure(root, driver_name, label, version, url, proxy) — return an absolute
// path to a runnable driver: the cache hit if present, else download `url`
// (through `proxy` if non-empty) + unpack into the cache. "" on failure.
ensure(root: string, driver_name: string, label: string, version: string, url: string, proxy: string) -> string {
    target = driver_path_in_cache(root, driver_name, label, version)
    if file_exists(target) == 1 {
        return target
    }
    if string.length(url) == 0 { return "" }

    // Destination dir <root>/<driver>/<label>/<version>/
    dest_dir = _dirname(target)
    _md = fs.mkdir_p(dest_dir)

    // Each miss stages privately. Parallel test processes may resolve the same
    // driver at once; fixed archive names and extraction paths in dest_dir let
    // one process overwrite or delete another's in-progress download.
    temp_dir, temp_err = fs.make_temp_dir(dest_dir, "_selenium_driver_")
    if string.length(temp_err) > 0 { return "" }
    extracted = string.concat(temp_dir, string.concat("/", driver_name))

    // Archive kind from the URL suffix: geckodriver ships .tar.gz on
    // macOS/Linux, everything else (chromedriver, msedgedriver, geckodriver on
    // Windows) is .zip. tar.gz carries a bare binary (no wrapper dir); the zips
    // may wrap files in a top folder (chromedriver 115+, msedgedriver), so the
    // zip paths flatten. Windows has no /bin/sh or unzip -> PowerShell.
    if _is_targz(url) == 1 {
        arc_path = string.concat(temp_dir, "/_download.tar.gz")
        if _download(url, arc_path, proxy) != 0 {
            _cleanup = fs.remove_tree(temp_dir)
            return ""
        }
        argv = list.new()
        list.add(argv, "-c")
        list.add(argv, "tar -xzf '${arc_path}' -C '${temp_dir}' >/dev/null 2>&1")
        _u, ustat, _ue = os.run_capture("/bin/sh", argv, null)
        list.free(argv)
    } else {
        zip_path = string.concat(temp_dir, "/_download.zip")
        if _download(url, zip_path, proxy) != 0 {
            _cleanup = fs.remove_tree(temp_dir)
            return ""
        }
        if _is_windows() == 1 {
            _unzip_windows(zip_path, temp_dir, driver_name)
        } else {
            argv = list.new()
            list.add(argv, "-c")
            list.add(argv, "unzip -o -j '${zip_path}' -d '${temp_dir}' >/dev/null 2>&1")
            _u, ustat, _ue = os.run_capture("/bin/sh", argv, null)
            list.free(argv)
        }
    }

    if file_exists(extracted) == 0 {
        _cleanup = fs.remove_tree(temp_dir)
        return ""
    }
    // chmod 0755 (0o755 == 493) — a no-op semantically on Windows but harmless.
    // The staged archive and extracted tree are removed after publication.
    _c = fs.chmod(extracted, 493)
    result = install_staged(extracted, target)
    _cleanup = fs.remove_tree(temp_dir)
    return result
}

// Atomically publish one complete driver binary. If another process won the
// race, its installed artifact is the cache hit we need.
install_staged(staged: string, target: string) -> string {
    if file_exists(target) == 1 { return target }
    _ren = fs.rename(staged, target)
    if file_exists(target) == 1 { return target }
    return ""
}

// browser_dir_in_cache(root, browser_name, label, version) — the browser cache
// DIR (no trailing binary): <root>/<browser>/<label>/<version>. The caller joins
// the OS-specific binary sub-path (lib.rs:1316 get_browser_path_in_cache).
browser_dir_in_cache(root: string, browser_name: string, label: string, version: string) -> string {
    d = string.concat(root, string.concat("/", browser_name))
    d = string.concat(d, string.concat("/", label))
    return string.concat(d, string.concat("/", version))
}

// ensure_browser(root, browser_name, label, version, url, bin_subpath) — return
// an absolute path to a runnable BROWSER binary. Each cache miss downloads and
// expands privately; the versioned tree is merged before the executable is
// atomically renamed into place. That executable is the cache-ready marker, so
// another process never observes a partial browser install.
ensure_browser(root: string, browser_name: string, label: string, version: string, url: string, bin_subpath: string, proxy: string) -> string {
    dir = browser_dir_in_cache(root, browser_name, label, version)
    target = string.concat(dir, string.concat("/", bin_subpath))
    if file_exists(target) == 1 {
        _c0 = fs.chmod(target, 493)
        return target
    }
    if string.length(url) == 0 { return "" }
    parent = _dirname(dir)
    _md = fs.mkdir_p(parent)
    temp_dir, temp_err = fs.make_temp_dir(parent, "_selenium_browser_")
    if string.length(temp_err) > 0 { return "" }

    // Archive kind from the URL: a CfT Chrome .zip, or a Firefox-Linux tarball
    // (.tar.xz / .tar.bz2). Both wrap files in one top folder (chrome-linux64/,
    // firefox/) that is stripped so <dir>/<bin_subpath> resolves.
    if _is_browser_tarball(url) == 1 {
        arc = string.concat(temp_dir, "/_browser.tar")
        if _download(url, arc, proxy) != 0 {
            _cleanup = fs.remove_tree(temp_dir)
            return ""
        }
        _ub = _expand_browser_tar(arc, temp_dir, url)
        _rmt = _remove(arc)
    } else {
        zip_path = string.concat(temp_dir, "/_browser.zip")
        if _download(url, zip_path, proxy) != 0 {
            _cleanup = fs.remove_tree(temp_dir)
            return ""
        }
        stage = string.concat(temp_dir, "/_extract")
        if _is_windows() == 1 {
            _ub = _expand_browser_windows(zip_path, stage, temp_dir)
        } else {
            _ub = _expand_browser_posix(zip_path, stage, temp_dir)
        }
        _rm = _remove(zip_path)
    }

    staged_binary = string.concat(temp_dir, string.concat("/", bin_subpath))
    if file_exists(staged_binary) == 0 {
        _cleanup = fs.remove_tree(temp_dir)
        return ""
    }
    _c = fs.chmod(staged_binary, 493)
    result = install_browser_staged(temp_dir, dir, bin_subpath)
    _cleanup = fs.remove_tree(temp_dir)
    return result
}

// Publish a complete browser tree from a private staging directory. The tree
// contents are version-addressed and identical between concurrent installers;
// the executable itself is moved out, the supporting files are merged, and the
// executable is atomically renamed last as the readiness marker.
install_browser_staged(staged_root: string, dir: string, bin_subpath: string) -> string {
    target = string.concat(dir, string.concat("/", bin_subpath))
    if file_exists(target) == 1 { return target }
    staged_binary = string.concat(staged_root, string.concat("/", bin_subpath))
    if file_exists(staged_binary) == 0 { return "" }
    md_err = fs.mkdir_p(dir)
    if string.length(md_err) > 0 { return "" }
    sentinel = string.concat(staged_root, ".browser-binary")
    _move = fs.rename(staged_binary, sentinel)
    if file_exists(sentinel) == 0 {
        if file_exists(target) == 1 { return target }
        return ""
    }

    copy_status = _copy_browser_tree(staged_root, dir)
    if copy_status != 0 { return "" }
    _parent = fs.mkdir_p(_dirname(target))
    _publish = fs.rename(sentinel, target)
    if file_exists(target) == 1 { return target }
    return ""
}

_copy_browser_tree(staged_root: string, dir: string) -> int {
    if _is_windows() == 1 {
        ps = "$ErrorActionPreference='Stop';"
        ps = string.concat(ps, "Copy-Item -Force -Recurse -Path '${staged_root}/*' -Destination '${dir}';")
        argv = list.new()
        list.add(argv, "-NoProfile")
        list.add(argv, "-NonInteractive")
        list.add(argv, "-Command")
        list.add(argv, ps)
        _o, status, _e = os.run_capture("powershell", argv, null)
        list.free(argv)
        return status
    } else {
        argv = list.new()
        list.add(argv, "-c")
        list.add(argv, "cp -a '${staged_root}'/. '${dir}'/")
        _o, status, _e = os.run_capture("/bin/sh", argv, null)
        list.free(argv)
        return status
    }
}

// A browser archive that is a gzip/xz/bzip2 tarball (Firefox-Linux) rather than
// a zip (CfT Chrome). tar handles all three compressions via its auto-detect.
_is_browser_tarball(url: string) -> int {
    if string.ends_with(url, ".tar.xz") == 1 { return 1 }
    if string.ends_with(url, ".tar.bz2") == 1 { return 1 }
    if string.ends_with(url, ".tar.gz") == 1 { return 1 }
    return 0
}

// Untar into a private staging directory, stripping the archive's top folder.
_expand_browser_tar(arc: string, dir: string, url: string) -> int {
    argv = list.new()
    list.add(argv, "-c")
    list.add(argv, "tar --strip-components=1 -xf '${arc}' -C '${dir}' >/dev/null 2>&1")
    _o, _s, _e = os.run_capture("/bin/sh", argv, null)
    list.free(argv)
    return 0
}

// POSIX: unzip into private stage, then move the single top folder's contents
// into the private browser root. Shared cache paths are never extraction paths.
_expand_browser_posix(zip_path: string, stage: string, dir: string) -> int {
    sh = "set -e; mkdir -p '${stage}';"
    sh = string.concat(sh, "unzip -o -q '${zip_path}' -d '${stage}' >/dev/null 2>&1;")
    // The zip has one top folder; copy its contents (incl. dotfiles) into dir.
    sh = string.concat(sh, "top=$(ls '${stage}'); ")
    sh = string.concat(sh, "if [ $(echo \"$top\" | wc -l) -eq 1 ]; then cp -a '${stage}'/\"$top\"/. '${dir}'/; else cp -a '${stage}'/. '${dir}'/; fi;")
    sh = string.concat(sh, "rm -rf '${stage}'")
    argv = list.new()
    list.add(argv, "-c")
    list.add(argv, sh)
    _o, _s, _e = os.run_capture("/bin/sh", argv, null)
    list.free(argv)
    return 0
}

// Windows: Expand-Archive into private stage, then move the single top folder's
// children into the private browser root.
_expand_browser_windows(zip_path: string, stage: string, dir: string) -> int {
    ps = "$ErrorActionPreference='Stop';"
    ps = string.concat(ps, "if(Test-Path '${stage}'){Remove-Item -Recurse -Force '${stage}'};")
    ps = string.concat(ps, "Expand-Archive -Force -LiteralPath '${zip_path}' -DestinationPath '${stage}';")
    ps = string.concat(ps, "$tops=Get-ChildItem -Force '${stage}';")
    ps = string.concat(ps, "if($tops.Count -eq 1 -and $tops[0].PSIsContainer){")
    ps = string.concat(ps, "Get-ChildItem -Force $tops[0].FullName | ForEach-Object{Move-Item -Force -LiteralPath $_.FullName -Destination '${dir}'}}")
    ps = string.concat(ps, "else{Get-ChildItem -Force '${stage}' | ForEach-Object{Move-Item -Force -LiteralPath $_.FullName -Destination '${dir}'}};")
    ps = string.concat(ps, "Remove-Item -Recurse -Force '${stage}'")
    argv = list.new()
    list.add(argv, "-NoProfile")
    list.add(argv, "-NonInteractive")
    list.add(argv, "-Command")
    list.add(argv, ps)
    _o, _s, _e = os.run_capture("powershell", argv, null)
    list.free(argv)
    return 0
}

_is_windows() -> int {
    if string.equals(os.getenv("OS"), "Windows_NT") == 1 { return 1 }
    return 0
}

// True if the download URL is a gzip tarball (geckodriver on macOS/Linux).
_is_targz(url: string) -> int {
    return string.ends_with(url, ".tar.gz")
}

// Windows unpack: Expand-Archive into a temp subdir, then copy the driver .exe
// (nested one folder deep in the CfT zip) up to <dest_dir>/<driver_name>. Uses
// PowerShell, always present on modern Windows. Best-effort (return ignored;
// the caller checks file_exists on the target).
_unzip_windows(zip_path: string, dest_dir: string, driver_name: string) -> int {
    stage = string.concat(dest_dir, "/_x")
    // -Command with a here-string of PowerShell: expand, then Get-ChildItem
    // -Recurse -Filter <driver_name> and Copy-Item the first match to dest.
    ps = "$ErrorActionPreference='Stop';"
    ps = string.concat(ps, "Expand-Archive -Force -LiteralPath '${zip_path}' -DestinationPath '${stage}';")
    ps = string.concat(ps, "$f=Get-ChildItem -Path '${stage}' -Recurse -Filter '${driver_name}' | Select-Object -First 1;")
    ps = string.concat(ps, "if($f){Copy-Item -LiteralPath $f.FullName -Destination '${dest_dir}/${driver_name}' -Force}")
    argv = list.new()
    list.add(argv, "-NoProfile")
    list.add(argv, "-NonInteractive")
    list.add(argv, "-Command")
    list.add(argv, ps)
    _o, _s, _e = os.run_capture("powershell", argv, null)
    list.free(argv)
    return 0
}

// ---- internals ----

// Download `url` to `path` via the engine's http client. Returns 0 on success.
// The body is a driver ZIP: binary with embedded NULs and high bytes, so it
// MUST be written with the byte-length-explicit binary path. file.write() is a
// text write that re-encodes high bytes (UTF-8), inflating the zip and
// corrupting it (observed: +41525 bytes on the win64 driver). Use
// response_body_length + fs.write_binary — the binary-safe pair.
_download(url: string, path: string, proxy: string) -> int {
    req = client.request("GET", url)
    // Follow redirects: GitHub's releases/download/... 302s to
    // objects.githubusercontent.com (geckodriver), and other CDNs redirect too;
    // without this the download gets a 30x and fails the 200 check below.
    _fr = client.set_follow_redirects(req, 10)
    // Bound the driver-zip download (default 0ns = block forever). The zip is
    // ~10-25MB and runs over pure-Aether TLS on cross-builds (~25s observed);
    // 300s is generous while still failing cleanly on a stalled transfer.
    _to = client.set_timeout(req, 300s)
    // Route through an explicit forward proxy (hint/SE_PROXY) when set.
    if string.length(proxy) > 0 { _px = client.use_http_proxy(req, proxy) }
    resp, err = client.send_request(req)
    if string.length(err) > 0 { return 1 }
    if client.response_status(resp) != 200 { return 1 }
    // Binary-safe: the archive as a byte view of the response (Aether 0.758+).
    werr = fs.write_binary(path, client.response_body_bytes(resp))
    if string.length(werr) > 0 { return 1 }
    return 0
}

_dirname(p: string) -> string {
    idx = _last_slash(p)
    if idx < 0 { return "." }
    return string.substring(p, 0, idx)
}

_last_slash(p: string) -> int {
    n = string.length(p)
    i = n - 1
    while i >= 0 {
        ch = string.substring(p, i, i + 1)
        if string.equals(ch, "/") == 1 { return i }
        i = i - 1
    }
    return -1
}

_remove(path: string) -> int {
    argv = list.new()
    list.add(argv, "-c")
    list.add(argv, "rm -f '${path}'")
    _o, _s, _e = os.run_capture("/bin/sh", argv, null)
    list.free(argv)
    return 0
}
