// proc.ae — run a child process for the driver manager, tolerating a host that
// has SIGCHLD set to "ignore".
//
// Why this exists. The BEAM VM (Erlang, Elixir, Gleam, LFE) starts with SIGCHLD
// ignored, and that disposition is inherited by the engine's in-process
// os.run_capture. With SIGCHLD ignored the kernel reaps children by itself, so
// os.run_capture's final waitpid fails with ECHILD and the call reports
// (stdout, -1, "waitpid failed") even though the child ran to completion and
// every byte of its stdout was read. Callers that treated "err is not empty" as
// "the command failed" then lost a perfectly good `chromium --version` line, saw
// no browser version, and silently chose the newest chromedriver instead of the
// one for the installed browser (the BEAM bindings failed with "This version of
// ChromeDriver only supports Chrome version 158" on a Chromium 156 host).
//
// The rule here: stdout that was captured is evidence the child ran. A lost exit
// status is "unknown", not "failed". This is a marked workaround for the
// stdlib behaviour; see the report in docs/Selenium-Manager-Port.md.
import std.os
import std.list
import std.string

// capture_stdout(prog, argv) — the child's stdout, or "" when it could not be
// started or printed nothing. A reap failure after output was read is ignored.
capture_stdout(prog: string, argv: ptr) -> string {
    out, _status, _err = os.run_capture(prog, argv, null)
    return out
}

// exit_ok(prog, argv) — 1 when the child ran and exited 0, or ran and its exit
// status was lost to an ignored SIGCHLD (the caller must then verify the effect,
// as extraction and copy callers do by looking for the file). 0 on a non-zero
// exit or a failed start.
exit_ok(prog: string, argv: ptr) -> int {
    _out, status, err = os.run_capture(prog, argv, null)
    if string.length(err) > 0 {
        if _is_reap_failure(err) == 1 { return 1 }
        return 0
    }
    if status == 0 { return 1 }
    return 0
}

_is_reap_failure(err: string) -> int {
    return string.contains(err, "waitpid")
}

// capture_lenient(prog, argv) — (stdout, status) where a status lost to an
// ignored SIGCHLD reads as 0 and a failed start as -1. Use only where the
// caller also checks the output, since a lost status is assumed to be success.
capture_lenient(prog: string, argv: ptr) -> (string, int) {
    out, status, err = os.run_capture(prog, argv, null)
    if string.length(err) > 0 {
        if _is_reap_failure(err) == 1 { return out, 0 }
        return out, -1
    }
    return out, status
}
