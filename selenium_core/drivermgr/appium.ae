// appium.ae — the desktop half of the driver manager: Selenium-Manager's
// "resolve, and install if missing" for Appium-hosted desktop drivers.
//
// A browser driver is one executable (chromedriver). A desktop driver is an
// Appium SERVER plus a driver plugin (appium-novawindows-driver, ...), both npm
// packages. So "resolve" here means: find node, `npm i -g appium` if it is not
// installed, `appium driver install <pkg>` if the plugin is not installed, and
// hand back appium's entry script. driver.ae then runs `node <script>` on a
// free loopback port, exactly as it runs chromedriver.
//
// Node itself is NOT provisioned: it is a runtime with an OS installer, like a
// browser — the same line resolve.ae draws for Firefox/Edge. No node, no
// driver: "" is returned and the caller's live test skips.
//
// Everything runs through node.exe directly (`node npm-cli.js ...`, `node
// appium/index.js ...`), never through the npm.cmd / appium.cmd shims: a .cmd
// is a cmd.exe batch file, and a process we spawn must be the process we later
// kill — killing a cmd.exe wrapper leaves its node child running.
import std.string
import std.os
import std.list
import std.fs

// The npm package that provides an Appium driver, by the name a binding passes
// to ensure_driver(). "" means "not an Appium-hosted driver". PURE.
npm_pkg(name: string) -> string {
    if string.equals(name, "novawindows") == 1 { return "appium-novawindows-driver" }
    if string.equals(name, "mac2") == 1 { return "appium-mac2-driver" }
    return ""
}

// The name Appium lists an installed driver under (`driver list --installed`),
// which is also what `appium:automationName` selects, lower-cased. PURE.
installed_key(name: string) -> string {
    return name
}

// Does `appium driver list --installed --json` output list `name`? The JSON is
// an object keyed by driver name. PURE.
lists_driver(list_json: string, name: string) -> int {
    key = string.concat("\"", string.concat(installed_key(name), "\""))
    if string.index_of(list_json, key) >= 0 { return 1 }
    return 0
}

// Directory part of a path, either separator (Windows paths come back from
// os.which with backslashes, npm prints either). "" when there is none. PURE.
dirname(p: string) -> string {
    cut = -1
    i = 0
    n = string.length(p)
    while i < n {
        a = string.index_of_from(p, "/", i)
        b = string.index_of_from(p, "\\", i)
        nxt = a
        if nxt < 0 { nxt = b }
        if b >= 0 && b < nxt { nxt = b }
        if nxt < 0 {
            i = n
        } else {
            cut = nxt
            i = nxt + 1
        }
    }
    if cut < 0 { return "" }
    return string.substring(p, 0, cut)
}

// npm's CLI script, relative to the directory holding node: layout 0 is
// Windows (npm ships beside node.exe), layout 1 is Unix (under ../lib). PURE.
npm_cli_candidate(node_dir: string, layout: int) -> string {
    if layout == 0 { return string.concat(node_dir, "/node_modules/npm/bin/npm-cli.js") }
    return string.concat(node_dir, "/../lib/node_modules/npm/bin/npm-cli.js")
}

node_path() -> string {
    return string.trim(os.which("node"))
}

// Each candidate is returned straight from the call that built it. An earlier
// cut collected them in a local list and returned the one that existed: the
// string outlived its list's scope, and on Windows node was intermittently
// handed a freed path ("C", or garbage) — half of all resolves failed.
_npm_cli(node: string) -> string {
    d = dirname(node)
    beside = npm_cli_candidate(d, 0)
    if fs.exists(beside) == 1 { return beside }
    under_lib = npm_cli_candidate(d, 1)
    if fs.exists(under_lib) == 1 { return under_lib }
    return ""
}

// Run `node <script> <args...>`, return (stdout, exit status).
_node_run(node: string, script: string, args: ptr) -> (string, int) {
    argv = list.new()
    list.add(argv, script)
    i = 0
    while i < list.size(args) {
        a, _g = list.get(args, i)
        list.add(argv, a)
        i = i + 1
    }
    out, status, _err = os.run_capture(node, argv, null)
    list.free(argv)
    return string.trim(out), status
}

_appium_main(node: string, npm_cli: string) -> string {
    a = list.new()
    list.add(a, "root")
    list.add(a, "-g")
    root, st = _node_run(node, npm_cli, a)
    list.free(a)
    if st != 0 { return "" }
    if string.length(root) == 0 { return "" }
    entry = string.concat(root, "/appium/index.js")
    if fs.exists(entry) == 0 { return "" }
    return entry
}

_offline(hint: string) -> int {
    if string.index_of(hint, "offline") >= 0 { return 1 }
    return 0
}

// resolve(name, hint) -> appium's entry script with driver `name` installed,
// or "". Installs appium and/or the driver on first use unless `hint` says
// "offline". Both installs are idempotent, so a second call is two cheap
// probes and no network.
resolve(name: string, hint: string) -> string {
    pkg = npm_pkg(name)
    if string.length(pkg) == 0 { return "" }
    node = node_path()
    if string.length(node) == 0 { return "" }
    npm_cli = _npm_cli(node)
    if string.length(npm_cli) == 0 { return "" }

    entry = _appium_main(node, npm_cli)
    if string.length(entry) == 0 {
        if _offline(hint) == 1 { return "" }
        a = list.new()
        list.add(a, "install")
        list.add(a, "-g")
        list.add(a, "appium")
        _o, _s = _node_run(node, npm_cli, a)
        list.free(a)
        entry = _appium_main(node, npm_cli)
        if string.length(entry) == 0 { return "" }
    }

    l = list.new()
    list.add(l, "driver")
    list.add(l, "list")
    list.add(l, "--installed")
    list.add(l, "--json")
    listed, _ls = _node_run(node, entry, l)
    list.free(l)
    if lists_driver(listed, name) == 1 { return entry }
    if _offline(hint) == 1 { return "" }

    d = list.new()
    list.add(d, "driver")
    list.add(d, "install")
    list.add(d, "--source=npm")
    list.add(d, pkg)
    _io, _is = _node_run(node, entry, d)
    list.free(d)

    l2 = list.new()
    list.add(l2, "driver")
    list.add(l2, "list")
    list.add(l2, "--installed")
    list.add(l2, "--json")
    listed2, _ls2 = _node_run(node, entry, l2)
    list.free(l2)
    if lists_driver(listed2, name) == 1 { return entry }
    return ""
}
