// resolve.ae — the driver-manager orchestrator: detect browser -> resolve driver
// version via CfT -> find-in-cache-or-download -> return a runnable driver path.
// This is the Selenium-Manager pipeline end to end (docs/Selenium-Manager-Port
// .md), composing the pieces: browser.ae (PROC detect), version.ae (PURE),
// cft.ae (PURE navigation), drivercache.ae (FS/NET edge). The NET fetch for the CfT
// JSON lives HERE (the edge); the resolution navigation stays pure.
import browser
import version
import cft
import gecko
import edgedriver
import drivercache
import std.string
import std.http.client
import std.os
// Links the pure-Aether TLS 1.3 client so std.http.client can do https in a
// cross-built engine (no OpenSSL is linked into an `ae build --target=` lib).
// Without this import the CfT metadata/download fetch fails on every
// cross-compiled artifact (aether-lang-dev/aether#1849, fixed in ae 0.622.0).
import std.cryptography.tls13_client

// resolve_chrome(hint) -> absolute path to a runnable chromedriver, or "".
// The transparent path behind webdriver.chrome() / sel_embed_ensure_driver:
//   1. detect the installed (or cached) Chrome + its version,
//   2. resolve the matching chromedriver version + download URL via CfT,
//   3. return the cached driver if present, else download+unpack it.
// Falls back to a chromedriver already on PATH when detection/resolution can't
// proceed (the user-supplied / PATH short-circuit).
resolve_chrome(hint: string) -> string {
    label = version.platform_label(_os(), _arch())

    // 1. detect the browser version. Prefer system Chrome; if none is
    //    installed, self-provision a Chrome-for-Testing browser into the cache
    //    (Capability 9) and use ITS version to match the driver. That downloaded
    //    Chrome is also what a session should point goog:chromeOptions.binary at
    //    (exposed via chrome_browser_binary()).
    bpath = browser.chrome_path()
    bver = ""
    if string.length(bpath) > 0 {
        bver = browser.chrome_version(bpath)
    } else {
        bver = _ensure_chrome_browser_version(label)
    }

    // 2. resolve the driver version + url via CfT (fetch at the edge).
    which = cft.which_endpoint(bver)
    resolved = null
    if string.equals(which, "latest") == 1 {
        body = _fetch(cft.latest_versions_url())
        resolved = cft.resolve_latest_stable_from(body, label)
    } else {
        if string.equals(which, "good") == 1 {
            body = _fetch(cft.known_good_url())
            resolved = cft.resolve_known_good_from(body, bver, label)
        }
    }

    // Resolution failed (offline, below-CfT-floor, unknown) -> PATH fallback.
    if resolved == null {
        return _which_driver()
    }

    dver = cft.resolved_version(resolved)
    durl = cft.resolved_url(resolved)
    if string.length(dver) == 0 {
        return _which_driver()
    }

    // 3. cache-or-download. The driver binary is chromedriver(.exe on Windows).
    root = drivercache.default_cache_root()
    got = drivercache.ensure(root, _driver_name(), label, dver, durl)
    if string.length(got) > 0 { return got }
    return _which_driver()
}

// The chromedriver binary filename for the host OS (Windows appends .exe).
_driver_name() -> string {
    if string.equals(_os(), "windows") == 1 { return "chromedriver.exe" }
    return "chromedriver"
}

// resolve_firefox(hint) -> absolute path to a runnable geckodriver, or "".
// Ports firefox.rs request_driver_version: detect Firefox + major, fetch the
// SeleniumHQ geckodriver-support table and range-match (first match wins); on a
// table-fetch failure, fall back to the GitHub releases/latest redirect. Then
// cache-or-download the matching release asset. PATH fallback throughout.
resolve_firefox(hint: string) -> string {
    o = _os()
    a = _arch()

    // 1. detect Firefox + its major version.
    bpath = browser.firefox_path()
    bver = ""
    if string.length(bpath) > 0 { bver = browser.firefox_version(bpath) }
    fmaj = version.major(bver)

    // 2. resolve the geckodriver version + url. Primary = support table.
    resolved = null
    body = _fetch(gecko.support_url())
    if string.length(body) > 0 {
        if fmaj >= 0 {
            resolved = gecko.resolve_support_from(body, fmaj, o, a)
        }
    }
    // Fallback = the releases/latest redirect (firefox.rs:283-298), used when
    // the table couldn't be read OR no row matched the detected major.
    if resolved == null {
        tag = _latest_geckodriver_tag()
        resolved = gecko.resolve_from_latest_tag(tag, o, a)
    }
    if resolved == null { return _which_named("geckodriver") }

    dver = gecko.resolved_version(resolved)
    durl = gecko.resolved_url(resolved)
    if string.length(dver) == 0 { return _which_named("geckodriver") }

    // 3. cache-or-download. geckodriver: <name>[.exe]; the archive kind is
    //    inferred from the URL suffix by drivercache (.tar.gz off Windows).
    root = drivercache.default_cache_root()
    label = gecko.platform_label(o, a)
    got = drivercache.ensure(root, _named(o, "geckodriver"), label, dver, durl)
    if string.length(got) > 0 { return got }
    return _which_named("geckodriver")
}

// resolve_edge(hint) -> absolute path to a runnable msedgedriver, or "".
// Ports edge.rs request_driver_version: fetch LATEST_STABLE to derive a major
// when the browser version is unknown, then LATEST_RELEASE_<major>_<OS> for the
// exact driver version, then cache-or-download the .zip. PATH fallback.
resolve_edge(hint: string) -> string {
    o = _os()
    a = _arch()

    // 1. detect Edge + its major (empty when absent -> LATEST_STABLE decides).
    bpath = browser.edge_path()
    bver = ""
    if string.length(bpath) > 0 { bver = browser.edge_version(bpath) }
    emaj = version.major(bver)

    // 2a. no concrete major -> read LATEST_STABLE to get one (edge.rs:247-270).
    if emaj < 0 {
        stable_body = _fetch(edgedriver.latest_stable_url())
        stable_ver = edgedriver.parse_version(stable_body)
        emaj = version.major(stable_ver)
    }
    if emaj < 0 { return _which_named("msedgedriver") }

    // 2b. LATEST_RELEASE_<major>_<OS> -> the exact driver version.
    rel_body = _fetch(edgedriver.latest_release_url(emaj, o))
    dver = edgedriver.parse_version(rel_body)
    if string.length(dver) == 0 { return _which_named("msedgedriver") }

    durl = edgedriver.driver_url(dver, o, a)
    if string.length(durl) == 0 { return _which_named("msedgedriver") }

    // 3. cache-or-download (.zip on all platforms).
    root = drivercache.default_cache_root()
    label = edgedriver.platform_label(o, a)
    got = drivercache.ensure(root, _named(o, "msedgedriver"), label, dver, durl)
    if string.length(got) > 0 { return got }
    return _which_named("msedgedriver")
}

// The geckodriver version from the releases/latest redirect: GET .../latest with
// redirects followed, read the effective URL (.../releases/tag/vX.Y.Z), pull the
// version out. "" on failure. firefox.rs:283-298 + downloads.rs:90-100.
_latest_geckodriver_tag() -> string {
    url = string.concat(gecko.RELEASES_URL(), "latest")
    req = client.request("GET", url)
    _fr = client.set_follow_redirects(req, 10)
    _to = client.set_timeout(req, 60s)
    resp, err = client.send_request(req)
    if string.length(err) > 0 { return "" }
    eff = client.response_url(resp)
    // .../releases/tag/v0.34.0 -> take the tail after the last '/', drop a
    // leading 'v'. version_extract_short pulls the numeric run out.
    return version.version_extract_short(eff)
}

// <name>[.exe] for the host OS.
_named(o: string, base: string) -> string {
    if string.equals(o, "windows") == 1 { return string.concat(base, ".exe") }
    return base
}

// A driver of the given base name on PATH, or "".
_which_named(base: string) -> string {
    return string.trim(os.which(base))
}

// ---- internals ----

_fetch(url: string) -> string {
    req = client.request("GET", url)
    // Bound the CfT metadata fetch: the std.http default (0ns) blocks forever,
    // so a stalled endpoint would wedge resolution with no error. The JSON is
    // small; 60s is ample and still catches a genuine stall.
    _to = client.set_timeout(req, 60s)
    resp, err = client.send_request(req)
    if string.length(err) > 0 { return "" }
    if client.response_status(resp) != 200 { return "" }
    return client.response_body(resp)
}

// Ensure a Chrome-for-Testing browser is present in the cache (download it if
// not) and return its version — so the driver resolution downstream matches it.
// This implements Capability 9's auto path: no system Chrome -> provision one.
// Returns "" if the browser can't be provisioned (offline / unsupported), which
// leaves resolve_chrome on the CfT "latest" path + PATH fallback.
_ensure_chrome_browser_version(label: string) -> string {
    p = _ensure_chrome_browser(label)
    if string.length(p) == 0 { return "" }
    return browser.chrome_version(p)
}

// chrome_browser_binary() — absolute path to a self-provisioned CfT Chrome
// binary for this host, downloading it if absent, or "" if a system Chrome
// exists (no download needed) or provisioning failed. A binding sets
// goog:chromeOptions.binary to this when there is no system Chrome.
chrome_browser_binary() -> string {
    if string.length(browser.chrome_path()) > 0 { return "" }
    return _ensure_chrome_browser(version.platform_label(_os(), _arch()))
}

// Download-or-cache the latest-stable CfT Chrome browser; return its binary
// path or "". Reads the CfT `chrome` artifact (not chromedriver) from the same
// last-known-good JSON. Linux arm64 is unsupported by CfT (returns "").
_ensure_chrome_browser(label: string) -> string {
    o = _os()
    if string.equals(o, "linux") == 1 {
        if string.equals(_arch(), "arm64") == 1 { return "" }
    }
    body = _fetch(cft.latest_versions_url())
    if string.length(body) == 0 { return "" }
    resolved = cft.resolve_latest_chrome_from(body, label)
    if resolved == null { return "" }
    cver = cft.resolved_version(resolved)
    curl = cft.resolved_url(resolved)
    if string.length(cver) == 0 { return "" }
    root = drivercache.default_cache_root()
    return drivercache.ensure_browser(root, "chrome", label, cver, curl, _chrome_binary_subpath())
}

// The CfT Chrome binary sub-path within its cache dir, per OS (chrome.rs
// get_browser_binary_path / CFT_MACOS_APP_NAME). The zip's top folder is
// stripped on unpack, so the sub-path has no chrome-<label>/ prefix.
_chrome_binary_subpath() -> string {
    o = _os()
    if string.equals(o, "macos") == 1 {
        return "Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
    }
    if string.equals(o, "windows") == 1 { return "chrome.exe" }
    return "chrome"
}

_which_driver() -> string {
    p = os.which("chromedriver")
    return string.trim(p)
}

// Host OS as a CfT platform token input: "windows" | "macos" | "linux".
// Windows sets the OS env var to "Windows_NT" (the stdlib itself keys off this,
// cf. std/path); elsewhere `uname -s` gives Darwin (macOS) or Linux.
_os() -> string {
    if string.equals(os.getenv("OS"), "Windows_NT") == 1 { return "windows" }
    sysname, _err = os.exec("uname -s")
    sn = string.trim(sysname)
    if string.contains(sn, "Darwin") == 1 { return "macos" }
    return "linux"
}

// Host arch: "arm64" | "x86_64". Windows exposes PROCESSOR_ARCHITECTURE
// (AMD64 / ARM64); elsewhere `uname -m` gives x86_64 / arm64 / aarch64.
_arch() -> string {
    if string.equals(os.getenv("OS"), "Windows_NT") == 1 {
        pa = os.getenv("PROCESSOR_ARCHITECTURE")
        if string.contains(pa, "ARM64") == 1 { return "arm64" }
        return "x86_64"
    }
    machine, _err = os.exec("uname -m")
    m = string.trim(machine)
    if string.contains(m, "arm64") == 1 { return "arm64" }
    if string.contains(m, "aarch64") == 1 { return "arm64" }
    return "x86_64"
}
