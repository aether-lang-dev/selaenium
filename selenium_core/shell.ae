// shell.ae — the engine-side interactive shell interpreter (Runner: the "wee
// shell language" for driving + inspecting a live session interactively).
//
// A single pure entry point, shell_eval(session, line) -> result JSON, parses a
// terse human-first line into (verb, args) and dispatches through the SAME
// command catalog every binding uses (execute / by_locator / the Phase-0 trace
// hooks). Because it lives in the engine, ALL 27 bindings — and every future
// front-end (a terminal REPL, an SUT-adjacent iframe, VS Code, Tauri) — become
// a shell by shipping a line down and rendering the result up; none re-implement
// the grammar. This is the interactive cousin of the .side runner: same command
// vocabulary, one typed live, one loaded from a file, one dispatch core.
//
// Informed by webautoma's SAM ("Step-Aside Mode") console (Apache-2.0); see
// NOTICE. Step/inspect/continue/jump debug verbs ride the same seam and land as
// front-ends drain the runner control lane (the named-channel demux) — this
// module is the language + immediate-execution half.
//
// Result shape (always JSON, so every front-end parses one thing):
//   {"ok":true,"value":<json>}      a command ran; value is its result payload
//   {"ok":true,"info":"<text>"}     a meta command (help, trace on) with no value
//   {"ok":false,"error":"<text>","code":<n>}   a failure (parse or W3C error)
import std.string
import std.json
import selenium_core

// shell_eval(sp, line) — parse and run one shell line against session `sp`.
// Never throws; every outcome is a JSON string. `sp` may be null (returns an
// error result rather than crashing).
shell_eval(sp: ptr, line: string) -> string {
    trimmed = string.trim(line)
    if string.length(trimmed) == 0 { return _info("") }         // blank line: no-op
    if string.starts_with(trimmed, "#") == 1 { return _info("") } // comment

    verb = _word(trimmed, 0)
    rest = _after(trimmed, verb)

    // ---- navigation ----
    if verb == "open" { return _cmd(sp, "get", _obj1("url", rest)) }
    if verb == "title" { return _cmd(sp, "getTitle", "{}") }
    if verb == "url" { return _cmd(sp, "getCurrentUrl", "{}") }
    if verb == "source" { return _cmd(sp, "getPageSource", "{}") }
    if verb == "back" { return _cmd(sp, "goBack", "{}") }
    if verb == "forward" { return _cmd(sp, "goForward", "{}") }
    if verb == "refresh" { return _cmd(sp, "refresh", "{}") }

    // ---- element actions: <verb> <selector> [text] ----
    if verb == "click" { return _el_action(sp, "clickElement", rest, "") }
    if verb == "clear" { return _el_action(sp, "clearElement", rest, "") }
    if verb == "text" { return _el_text(sp, rest) }
    if verb == "type" {
        sel = _word(rest, 0)
        txt = _after(rest, sel)
        return _el_action(sp, "sendKeysToElement", sel, txt)
    }

    // ---- scripts ----
    if verb == "eval" { return _cmd(sp, "executeScript", _script_obj(rest)) }

    // ---- raw escape hatch: `exec <command> <params-json>` ----
    if verb == "exec" {
        cmd = _word(rest, 0)
        params = string.trim(_after(rest, cmd))
        if string.length(params) == 0 { params = "{}" }
        return _cmd(sp, cmd, params)
    }

    // ---- Phase-0 trace + timers (the inspect surface) ----
    if verb == "trace" {
        arg = string.trim(rest)
        if arg == "on" { selenium_core.session_set_trace(sp, 1); return _info("trace on") }
        if arg == "off" { selenium_core.session_set_trace(sp, 0); return _info("trace off") }
        return _err("usage: trace on|off", 0)
    }
    if verb == "events" {
        return _ok_value(selenium_core.trace_json_of(sp))
    }
    if verb == "timer" {
        sub = _word(rest, 0)
        name = string.trim(_after(rest, sub))
        if sub == "start" { selenium_core.timer_start(sp, name); return _info(string.concat("timer start ", name)) }
        if sub == "stop" { selenium_core.timer_stop(sp, name); return _info(string.concat("timer stop ", name)) }
        return _err("usage: timer start|stop <name>", 0)
    }
    if verb == "timers" {
        return _ok_value(selenium_core.timers_json_of(sp))
    }

    // ---- meta ----
    if verb == "help" { return _info(_help_text()) }
    if verb == "sid" { return _info(selenium_core.session_id_of(sp)) }

    return _err(string.concat("unknown command: ", verb), 0)
}

// ---- dispatch helpers ------------------------------------------------------

// _cmd — run a W3C command by name with a params-JSON string; wrap last_value or
// the typed error as a result object.
_cmd(sp: ptr, name: string, params_json: string) -> string {
    if sp == null { return _err("no session", -1) }
    rc = selenium_core.execute(sp, name, params_json)
    if rc != 0 {
        return _err(selenium_core.last_error_of(sp), selenium_core.last_error_code_of(sp))
    }
    return _ok_value(selenium_core.last_value_of(sp))
}

// _el_action — find the element named by `sel`, then run an element-scoped
// command (click/clear/sendKeys) with the found id (+ optional text).
_el_action(sp: ptr, command: string, sel: string, text: string) -> string {
    eid = _find(sp, sel)
    if string.length(eid) == 0 { return _err(_find_err(sp, sel), selenium_core.last_error_code_of(sp)) }
    body = string.concat("{\"id\":", string.concat(_qs(eid), ""))
    if command == "sendKeysToElement" {
        body = string.concat(body, string.concat(",\"text\":", _qs(text)))
        body = string.concat(body, string.concat(",\"value\":[", string.concat(_qs(text), "]")))
    }
    body = string.concat(body, "}")
    return _cmd(sp, command, body)
}

// _el_text — find + getElementText.
_el_text(sp: ptr, sel: string) -> string {
    eid = _find(sp, string.trim(sel))
    if string.length(eid) == 0 { return _err(_find_err(sp, sel), selenium_core.last_error_code_of(sp)) }
    return _cmd(sp, "getElementText", string.concat("{\"id\":", string.concat(_qs(eid), "}")))
}

// _find(sp, sel) — resolve a selector shorthand to an element id, or "" on
// no-such-element. Shorthand: "#id" / ".class" / "css=<sel>" / "xpath=<x>" /
// "//..." (xpath) / bare token (css selector).
_find(sp: ptr, sel: string) -> string {
    s = string.trim(sel)
    strategy = "css selector"
    value = s
    if string.starts_with(s, "css=") == 1 { value = string.substring(s, 4, string.length(s)) }
    else { if string.starts_with(s, "xpath=") == 1 { strategy = "xpath"; value = string.substring(s, 6, string.length(s)) }
    else { if string.starts_with(s, "//") == 1 { strategy = "xpath"; value = s }
    else { if string.starts_with(s, "#") == 1 { strategy = "id"; value = string.substring(s, 1, string.length(s)) }
    else { value = s } } } }

    loc = selenium_core.by_locator(strategy, value)  // {"using":..,"value":..}
    rc = selenium_core.execute(sp, "findElement", loc)
    if rc != 0 { return "" }
    v = selenium_core.last_value_of(sp)
    return _json_field(v, "element-6066-11e4-a52e-4f735466cecf")
}

_find_err(sp: ptr, sel: string) -> string {
    e = selenium_core.last_error_of(sp)
    if string.length(e) > 0 { return e }
    return string.concat("no such element: ", sel)
}

// ---- result constructors ---------------------------------------------------

_ok_value(value_json: string) -> string {
    v = value_json
    if string.length(v) == 0 { v = "null" }
    return string.concat("{\"ok\":true,\"value\":", string.concat(v, "}"))
}
_info(text: string) -> string {
    return string.concat("{\"ok\":true,\"info\":", string.concat(_qs(text), "}"))
}
_err(text: string, code: int) -> string {
    return string.concat("{\"ok\":false,\"error\":", string.concat(_qs(text),
        string.concat(",\"code\":", string.concat(string.from_int(code), "}"))))
}

// ---- tiny string/JSON helpers (pure) ---------------------------------------

// _qs(s) — JSON-quote+escape a string (the fields we emit: text/errors/urls).
_qs(v: string) -> string {
    out = "\""
    n = string.length(v)
    i = 0
    while i < n {
        c = string.substring(v, i, i + 1)
        if c == "\"" { out = string.concat(out, "\\\"") }
        else { if c == "\\" { out = string.concat(out, "\\\\") }
        else { if c == "\n" { out = string.concat(out, "\\n") }
        else { if c == "\r" { out = string.concat(out, "\\r") }
        else { if c == "\t" { out = string.concat(out, "\\t") }
        else { out = string.concat(out, c) } } } } }
        i = i + 1
    }
    return string.concat(out, "\"")
}

// _obj1(k, v) — a one-field JSON object {"k":"v"} (v string-escaped).
_obj1(k: string, v: string) -> string {
    return string.concat("{", string.concat(_qs(k), string.concat(":", string.concat(_qs(string.trim(v)), "}"))))
}

// _script_obj(js) — {"script":<js>,"args":[]} for executeScript.
_script_obj(js: string) -> string {
    return string.concat("{\"script\":", string.concat(_qs(string.trim(js)), ",\"args\":[]}"))
}

// _word(s, i) — the i-th whitespace-separated word (i==0 → first). "" if absent.
_word(s: string, i: int) -> string {
    rest = string.trim(s)
    k = 0
    while k < i {
        sp = string.index_of(rest, " ")
        if sp < 0 { return "" }
        rest = string.trim(string.substring(rest, sp + 1, string.length(rest)))
        k = k + 1
    }
    sp2 = string.index_of(rest, " ")
    if sp2 < 0 { return rest }
    return string.substring(rest, 0, sp2)
}

// _after(s, word) — everything after the first occurrence of `word` (trimmed).
_after(s: string, word: string) -> string {
    t = string.trim(s)
    if string.length(word) == 0 { return t }
    at = string.index_of(t, word)
    if at < 0 { return "" }
    return string.trim(string.substring(t, at + string.length(word), string.length(t)))
}

// _json_field(json, key) — the string value of a flat "<key>":"<val>" field,
// or "". Thin scan sufficient for the element-ref payload.
_json_field(json: string, key: string) -> string {
    pat = string.concat("\"", string.concat(key, "\""))
    at = string.index_of(json, pat)
    if at < 0 { return "" }
    p = at + string.length(pat)
    // skip ": and whitespace to the opening quote
    while p < string.length(json) {
        c = string.substring(json, p, p + 1)
        if c == "\"" { p = p + 1; break }
        p = p + 1
    }
    start = p
    while p < string.length(json) {
        c = string.substring(json, p, p + 1)
        if c == "\"" { break }
        p = p + 1
    }
    return string.substring(json, start, p)
}

_help_text() -> string {
    return "commands: open <url> | title | url | source | back | forward | refresh | click <sel> | clear <sel> | text <sel> | type <sel> <text> | eval <js> | exec <cmd> <json> | trace on|off | events | timer start|stop <name> | timers | sid | help.  selectors: #id, .class, css=<sel>, xpath=<x> or //, bare=css"
}

// ==== .side (Selenium IDE) playback — folded into shell.ae ====
// A new top-level module currently trips an ae 0.677/near-threshold codegen bug
// (asks/aether-0677-sha1-free-ctx-wholeprogram.md), so .side playback lives here
// in shell.ae rather than its own file. It IS the shell in batch mode: every
// step runs through shell_eval, the same verbs a human types. Move back to a
// side_run.ae module once the compiler bug is fixed.
// Informed by webautoma's .side executor (Apache-2.0); see NOTICE.

side_run(session: ptr, side_json: string) -> string {
    root, perr = json.parse(side_json)
    if string.length(perr) > 0 {
        return string.concat("{\"error\":\"unparseable .side project: ", string.concat(_side_esc(perr), "\"}"))
    }
    name = _side_obj_str(root, "name")
    tests, _t = json.object_get(root, "tests")
    if tests == null {
        return string.concat("{\"name\":", string.concat(_qs(name), ",\"error\":\"no tests[] in project\"}"))
    }

    results = ""     // "," joined test-result objects
    tn = 0
    passed = 0
    failed = 0
    ti = 0
    tv, _tv0 = json.array_get(tests, ti)
    while tv != null {
        tr, ok = _side_run_test(session, tv)
        results = _side_append(results, tr)
        tn = tn + 1
        if ok == 1 { passed = passed + 1 } else { failed = failed + 1 }
        ti = ti + 1
        tv, _tvn = json.array_get(tests, ti)
    }

    return string.concat("{\"name\":", string.concat(_qs(name),
        string.concat(",\"tests\":", string.concat(string.from_int(tn),
        string.concat(",\"passed\":", string.concat(string.from_int(passed),
        string.concat(",\"failed\":", string.concat(string.from_int(failed),
        string.concat(",\"results\":[", string.concat(results, "]}"))))))))))
}

// _side_run_test(session, tv) — run one test's commands in order, stop-on-first-fail
// (Selenium IDE assert semantics: assert* aborts the test; verify* would not, but
// we treat both as hard here — a follow-up can split them). Returns (test_result
// json, ok 1|0).
_side_run_test(session: ptr, tv: ptr) -> (string, int) {
    tname = _side_obj_str(tv, "name")
    cmds, _c = json.object_get(tv, "commands")
    steps = ""
    ok = 1
    ci = 0
    cv, _cv0 = json.array_get(cmds, ci)
    while cv != null {
        step, sok = _side_run_command(session, cv)
        steps = _side_append(steps, step)
        if sok == 0 { ok = 0 }
        ci = ci + 1
        if sok == 0 { cv = null } else { cv, _cvn = json.array_get(cmds, ci) }  // abort test on failure
    }
    tr = string.concat("{\"test\":", string.concat(_qs(tname),
        string.concat(",\"ok\":", string.concat(_side_bool(ok),
        string.concat(",\"steps\":[", string.concat(steps, "]}"))))))
    return (tr, ok)
}

// _side_run_command(session, cv) — translate one .side command to a shell action (or
// an assertion) and run it. Returns (step json, ok 1|0).
_side_run_command(session: ptr, cv: ptr) -> (string, int) {
    command = _side_obj_str(cv, "command")
    target = _side_obj_str(cv, "target")
    value = _side_obj_str(cv, "value")

    // control-only / no-op commands
    if command == "" { return (_side_step(command, target, 1, "empty"), 1) }
    if command == "pause" { return (_side_step(command, target, 1, "pause (no-op in playback)"), 1) }
    if string.starts_with(command, "//") == 1 { return (_side_step(command, target, 1, "comment"), 1) }

    // navigation + simple element actions -> a shell line the shell already runs
    if command == "open" { return _side_via_shell(session, command, target, string.concat("open ", target)) }
    if command == "click" { return _side_via_shell(session, command, target, string.concat("click ", _side_sel(target))) }
    if command == "clickAndWait" { return _side_via_shell(session, command, target, string.concat("click ", _side_sel(target))) }
    if command == "clear" { return _side_via_shell(session, command, target, string.concat("clear ", _side_sel(target))) }
    if command == "type" {
        return _side_via_shell(session, command, target, string.concat("type ", string.concat(_side_sel(target), string.concat(" ", value))))
    }
    if command == "sendKeys" {
        return _side_via_shell(session, command, target, string.concat("type ", string.concat(_side_sel(target), string.concat(" ", value))))
    }
    if command == "setValue" {
        return _side_via_shell(session, command, target, string.concat("type ", string.concat(_side_sel(target), string.concat(" ", value))))
    }
    if command == "runScript" { return _side_via_shell(session, command, target, string.concat("eval ", target)) }
    if command == "executeScript" { return _side_via_shell(session, command, target, string.concat("eval ", target)) }

    // assertions / waits — run a shell read then compare
    if command == "assertText" { return _side_assert_text(session, command, target, value) }
    if command == "verifyText" { return _side_assert_text(session, command, target, value) }
    if command == "assertTitle" { return _side_assert_title(session, command, value) }
    if command == "assertElementPresent" { return _side_assert_present(session, command, target, 1) }
    if command == "assertElementNotPresent" { return _side_assert_present(session, command, target, 0) }
    if command == "waitForElementPresent" { return _side_assert_present(session, command, target, 1) }
    if command == "waitForElementVisible" { return _side_assert_present(session, command, target, 1) }

    // unknown command: record it as a skipped step (not a hard fail — an
    // unsupported IDE command shouldn't sink an otherwise-green test), but flag it.
    return (_side_step(command, target, 1, string.concat("unsupported command (skipped): ", command)), 1)
}

// _side_via_shell — run a shell line; ok iff the shell result is ok:true.
_side_via_shell(session: ptr, command: string, target: string, line: string) -> (string, int) {
    res = shell_eval(session, line)
    ok = _side_res_ok(res)
    detail = _side_res_detail(res)
    return (_side_step(command, target, ok, detail), ok)
}

// _side_assert_text — `text <sel>` then compare to the expected value (exact match;
// Selenium IDE also supports glob/regex prefixes, a follow-up can add them).
_side_assert_text(session: ptr, command: string, target: string, expected: string) -> (string, int) {
    res = shell_eval(session, string.concat("text ", _side_sel(target)))
    if _side_res_ok(res) == 0 { return (_side_step(command, target, 0, _side_res_detail(res)), 0) }
    got = _side_res_value_str(res)
    if got == expected { return (_side_step(command, target, 1, string.concat("text == ", _side_q(expected))), 1) }
    return (_side_step(command, target, 0, string.concat("expected ", string.concat(_side_q(expected), string.concat(", got ", _side_q(got))))), 0)
}

_side_assert_title(session: ptr, command: string, expected: string) -> (string, int) {
    res = shell_eval(session, "title")
    if _side_res_ok(res) == 0 { return (_side_step(command, "", 0, _side_res_detail(res)), 0) }
    got = _side_res_value_str(res)
    if got == expected { return (_side_step(command, "", 1, string.concat("title == ", _side_q(expected))), 1) }
    return (_side_step(command, "", 0, string.concat("expected title ", string.concat(_side_q(expected), string.concat(", got ", _side_q(got))))), 0)
}

// _side_assert_present — presence via `text <sel>`: ok:true means the element was
// found. `want` 1 asserts present, 0 asserts absent.
_side_assert_present(session: ptr, command: string, target: string, want: int) -> (string, int) {
    res = shell_eval(session, string.concat("text ", _side_sel(target)))
    found = _side_res_ok(res)
    if found == want { return (_side_step(command, target, 1, "presence as expected"), 1) }
    if want == 1 { return (_side_step(command, target, 0, string.concat("element not present: ", target)), 0) }
    return (_side_step(command, target, 0, string.concat("element unexpectedly present: ", target)), 0)
}

// ---- .side locator -> shell selector ----------------------------------------
// Selenium locators: id= / name= / css= / xpath= / linkText= / link= / //… .
// The shell speaks #id / .class / css= / xpath= / // / bare-css, so translate the
// ones it doesn't already take.
_side_sel(target: string) -> string {
    t = string.trim(target)
    if string.starts_with(t, "id=") == 1 { return string.concat("#", string.substring(t, 3, string.length(t))) }
    if string.starts_with(t, "name=") == 1 { return string.concat("css=[name=\"", string.concat(string.substring(t, 5, string.length(t)), "\"]")) }
    if string.starts_with(t, "linkText=") == 1 { return _side_link_xpath(string.substring(t, 9, string.length(t))) }
    if string.starts_with(t, "link=") == 1 { return _side_link_xpath(string.substring(t, 5, string.length(t))) }
    if string.starts_with(t, "css=") == 1 { return t }        // shell takes css= as-is
    if string.starts_with(t, "xpath=") == 1 { return t }      // and xpath=
    if string.starts_with(t, "//") == 1 { return t }          // and raw xpath
    return t                                                   // bare -> css (shell default)
}
_side_link_xpath(txt: string) -> string {
    return string.concat("xpath=//a[normalize-space()=\"", string.concat(txt, "\"]"))
}

// ---- shell-result inspection -------------------------------------------------
_side_res_ok(res_json: string) -> int {
    root, perr = json.parse(res_json)
    if string.length(perr) > 0 { return 0 }
    okv, _o = json.object_get(root, "ok")
    if okv == null { return 0 }
    return json.get_bool(okv)
}
_side_res_value_str(res_json: string) -> string {
    root, perr = json.parse(res_json)
    if string.length(perr) > 0 { return "" }
    vv, _v = json.object_get(root, "value")
    if vv == null { return "" }
    s, serr = json.get_string(vv)
    if string.length(serr) == 0 { return s }
    enc, _e = json.stringify(vv)
    return enc
}
_side_res_detail(res_json: string) -> string {
    root, perr = json.parse(res_json)
    if string.length(perr) > 0 { return res_json }
    ev, _e = json.object_get(root, "error")
    if ev != null { s, _s = json.get_string(ev); return s }
    iv, _i = json.object_get(root, "info")
    if iv != null { s, _s2 = json.get_string(iv); return s }
    return "ok"
}

// ---- json/report helpers -----------------------------------------------------
_side_step(command: string, target: string, ok: int, detail: string) -> string {
    return string.concat("{\"command\":", string.concat(_qs(command),
        string.concat(",\"target\":", string.concat(_qs(target),
        string.concat(",\"ok\":", string.concat(_side_bool(ok),
        string.concat(",\"detail\":", string.concat(_qs(detail), "}"))))))))
}
_side_append(acc: string, item: string) -> string {
    if string.length(acc) == 0 { return item }
    return string.concat(acc, string.concat(",", item))
}
_side_bool(v: int) -> string { if v == 1 { return "true" } return "false" }
_side_q(v: string) -> string { return string.concat("\"", string.concat(v, "\"")) }

_side_obj_str(obj: ptr, key: string) -> string {
    v, _v = json.object_get(obj, key)
    if v == null { return "" }
    s, serr = json.get_string(v)
    if string.length(serr) == 0 { return s }
    return ""
}
_side_esc(v: string) -> string {
    // minimal: strip quotes so a parse-error message can't break the JSON.
    return string.replace_all(v, "\"", "'")
}
