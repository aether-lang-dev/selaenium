// The shared Selenium WebDriver engine, built ONCE for the whole monorepo.
//
// Output: selenium_core/native/libselenium_core.so — every binding's node deps
// this and loads (ctypes/Fiddle/koffi/FFM) or links (cgo/NIF) that single
// artifact. aether.shared_lib() compiles embed.ae with `--emit=lib` and
// publishes the `shared_lib` artifact edge that the bindings dep_artifact.
//
// Source: embed.ae (the aether_sel_embed_* C ABI) imports the local
// `selenium_core` module (selenium_core.ae) — the WHOLE protocol runtime
// (command catalog, W3C route table, path templating, By/capabilities
// normalization, W3C error decode, and the HTTP round-trip) is PURE AETHER.
// The only C left is _embed_strdup.c (~15 lines): the caller-owned-string
// bridge, linked via extra_source. The engine uses std.http.client (caps net).
import bldr
import aether

aeb(cap) {
    bldr.build() {
        aether.shared_lib() {
            source("embed.ae")
            caps("net")
            extra_source("_embed_strdup.c")
            output("libselenium_core.so")
        }
    }
}
