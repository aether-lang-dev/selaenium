import bldr
import aether
import copy

aeb(cap) {
    bldr.build() {
        aether.shared_lib() {
            source("embed.ae")
            caps("net,os")
            extra_source("_embed_strdup.c")
            output("libselenium_core.so")
        }
        // Stage an in-tree copy for link-time bindings' fixed -L path. The
        // shared_lib .so lands at <repo>/target/build/selenium_core/lib/; from
        // this node's source_dir (selenium_core/) that is ../target/build/...
        copy.file() {
            from("../target/build/selenium_core/lib/libselenium_core.so")
            to("native/libselenium_core.so")
        }
    }
}
