import bldr
import aether
import copy

aeb(cap) {
    bldr.build() {
        aether.shared_lib() {
            source("embed.ae")
            // drivermgr/ modules (resolve/browser/version/cft/cache) import each
            // other by bare name and driver.ae imports `resolve` — add the subdir
            // as an aetherc module-search path so those resolve at compile time.
            lib("drivermgr")
            // extern: aether 0.801 (#2709) refuses an --emit=lib build that
            // declares externs without the grant. The engine genuinely calls C:
            // embed.ae's sel_embed_dup/sel_embed_free (the caller-owned-string
            // bridge in _embed_strdup.c below) — nothing broader.
            caps("net,os,fs,extern")
            extra_source("_embed_strdup.c")
            output("libselenium_core.so")
        }
        // Stage an in-tree copy for link-time bindings' fixed -L path. aeb emits
        // the shared_lib to the repo-root build tree under the node's name:
        // <repo-root>/target/build/selenium_core/lib/libselenium_core.so, i.e.
        // ../target/build/selenium_core/lib/ from this node's source dir.
        copy.file() {
            from("../target/build/selenium_core/lib/libselenium_core.so")
            to("native/libselenium_core.so")
        }
    }
}
