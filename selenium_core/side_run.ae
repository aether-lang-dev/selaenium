// side_run.ae — the .side (Selenium IDE) playback engine. This is the piece the
// interactive runner was always meant to sit on top of: give it a recorded
// Selenium IDE project (.side JSON) and it PLAYS it against a live session,
// producing a pass/fail report. The console (REPL / iframe / dashboard) then
// gains "play this .side" for free, because playback runs the SAME shell verbs a
// human types.
//
// Reuse, not reinvention: every browser-touching step goes through
// shell.shell_eval — so open/click/type/select and the assertions are exactly
// the shorthand the shell already speaks, and the .side vocabulary is a thin
// translation layer on top (command name -> shell line; .side locator -> shell
// selector). No new WebDriver plumbing.
//
// .side structure (Selenium IDE 3.x, "version":"2.0"):
//   { "name", "url", "tests":[ {"name","commands":[ {"command","target","value"} ]} ] }
// Locators in `target` use Selenium syntax: id= / name= / css= / xpath= /
// linkText= / link= / //… ; _side_selector maps them to the shell's shorthand.
//
// Report (JSON):
//   { "name", "tests":<n>, "passed":<n>, "failed":<n>,
//     "results":[ {"test","ok","steps":[ {"command","target","ok","detail"} ]} ] }
//
// PURE over the session boundary: side_run itself opens no socket and spawns no
// process — it drives whatever session it is handed, so a null/fake session
// unit-tests the command→shell translation + report shaping (side_probe.ae),
// and a live session runs it for real.
//
// Informed by webautoma's .side executor (Apache-2.0); see NOTICE.
import std.string
import std.json
import selenium_core
import shell

// side_run(session, side_json) — play a whole .side project. Returns the report
// JSON. Never throws: a malformed project yields a report with an error field.
side_run(session: ptr, side_json: string) -> string {
    root, perr = json.parse(side_json)
    if string.length(perr) > 0 {
        return string.concat("{\"error\":\"unparseable .side project: ", string.concat(_esc(perr), "\"}"))
    }
    name = _obj_str(root, "name")
    tests, _t = json.object_get(root, "tests")
    if tests == null {
        return string.concat("{\"name\":", string.concat(_qs(name), ",\"error\":\"no tests[] in project\"}"))
    }

    results = ""     // "," joined test-result objects
    tn = 0
    passed = 0
    failed = 0
    ti = 0
    tv, _tv0 = json.array_get(tests, ti)
    while tv != null {
        tr, ok = _run_test(session, tv)
        results = _append(results, tr)
        tn = tn + 1
        if ok == 1 { passed = passed + 1 } else { failed = failed + 1 }
        ti = ti + 1
        tv, _tvn = json.array_get(tests, ti)
    }

    return string.concat("{\"name\":", string.concat(_qs(name),
        string.concat(",\"tests\":", string.concat(string.from_int(tn),
        string.concat(",\"passed\":", string.concat(string.from_int(passed),
        string.concat(",\"failed\":", string.concat(string.from_int(failed),
        string.concat(",\"results\":[", string.concat(results, "]}"))))))))))
}

// _run_test(session, tv) — run one test's commands in order, stop-on-first-fail
// (Selenium IDE assert semantics: assert* aborts the test; verify* would not, but
// we treat both as hard here — a follow-up can split them). Returns (test_result
// json, ok 1|0).
_run_test(session: ptr, tv: ptr) -> (string, int) {
    tname = _obj_str(tv, "name")
    cmds, _c = json.object_get(tv, "commands")
    steps = ""
    ok = 1
    ci = 0
    cv, _cv0 = json.array_get(cmds, ci)
    while cv != null {
        step, sok = _run_command(session, cv)
        steps = _append(steps, step)
        if sok == 0 { ok = 0 }
        ci = ci + 1
        if sok == 0 { cv = null } else { cv, _cvn = json.array_get(cmds, ci) }  // abort test on failure
    }
    tr = string.concat("{\"test\":", string.concat(_qs(tname),
        string.concat(",\"ok\":", string.concat(_bool(ok),
        string.concat(",\"steps\":[", string.concat(steps, "]}"))))))
    return (tr, ok)
}

// _run_command(session, cv) — translate one .side command to a shell action (or
// an assertion) and run it. Returns (step json, ok 1|0).
_run_command(session: ptr, cv: ptr) -> (string, int) {
    command = _obj_str(cv, "command")
    target = _obj_str(cv, "target")
    value = _obj_str(cv, "value")

    // control-only / no-op commands
    if command == "" { return (_step(command, target, 1, "empty"), 1) }
    if command == "pause" { return (_step(command, target, 1, "pause (no-op in playback)"), 1) }
    if string.starts_with(command, "//") == 1 { return (_step(command, target, 1, "comment"), 1) }

    // navigation + simple element actions -> a shell line the shell already runs
    if command == "open" { return _via_shell(session, command, target, string.concat("open ", target)) }
    if command == "click" { return _via_shell(session, command, target, string.concat("click ", _sel(target))) }
    if command == "clickAndWait" { return _via_shell(session, command, target, string.concat("click ", _sel(target))) }
    if command == "clear" { return _via_shell(session, command, target, string.concat("clear ", _sel(target))) }
    if command == "type" {
        return _via_shell(session, command, target, string.concat("type ", string.concat(_sel(target), string.concat(" ", value))))
    }
    if command == "sendKeys" {
        return _via_shell(session, command, target, string.concat("type ", string.concat(_sel(target), string.concat(" ", value))))
    }
    if command == "setValue" {
        return _via_shell(session, command, target, string.concat("type ", string.concat(_sel(target), string.concat(" ", value))))
    }
    if command == "runScript" { return _via_shell(session, command, target, string.concat("eval ", target)) }
    if command == "executeScript" { return _via_shell(session, command, target, string.concat("eval ", target)) }

    // assertions / waits — run a shell read then compare
    if command == "assertText" { return _assert_text(session, command, target, value) }
    if command == "verifyText" { return _assert_text(session, command, target, value) }
    if command == "assertTitle" { return _assert_title(session, command, value) }
    if command == "assertElementPresent" { return _assert_present(session, command, target, 1) }
    if command == "assertElementNotPresent" { return _assert_present(session, command, target, 0) }
    if command == "waitForElementPresent" { return _assert_present(session, command, target, 1) }
    if command == "waitForElementVisible" { return _assert_present(session, command, target, 1) }

    // unknown command: record it as a skipped step (not a hard fail — an
    // unsupported IDE command shouldn't sink an otherwise-green test), but flag it.
    return (_step(command, target, 1, string.concat("unsupported command (skipped): ", command)), 1)
}

// _via_shell — run a shell line; ok iff the shell result is ok:true.
_via_shell(session: ptr, command: string, target: string, line: string) -> (string, int) {
    res = shell.shell_eval(session, line)
    ok = _res_ok(res)
    detail = _res_detail(res)
    return (_step(command, target, ok, detail), ok)
}

// _assert_text — `text <sel>` then compare to the expected value (exact match;
// Selenium IDE also supports glob/regex prefixes, a follow-up can add them).
_assert_text(session: ptr, command: string, target: string, expected: string) -> (string, int) {
    res = shell.shell_eval(session, string.concat("text ", _sel(target)))
    if _res_ok(res) == 0 { return (_step(command, target, 0, _res_detail(res)), 0) }
    got = _res_value_str(res)
    if got == expected { return (_step(command, target, 1, string.concat("text == ", _q(expected))), 1) }
    return (_step(command, target, 0, string.concat("expected ", string.concat(_q(expected), string.concat(", got ", _q(got))))), 0)
}

_assert_title(session: ptr, command: string, expected: string) -> (string, int) {
    res = shell.shell_eval(session, "title")
    if _res_ok(res) == 0 { return (_step(command, "", 0, _res_detail(res)), 0) }
    got = _res_value_str(res)
    if got == expected { return (_step(command, "", 1, string.concat("title == ", _q(expected))), 1) }
    return (_step(command, "", 0, string.concat("expected title ", string.concat(_q(expected), string.concat(", got ", _q(got))))), 0)
}

// _assert_present — presence via `text <sel>`: ok:true means the element was
// found. `want` 1 asserts present, 0 asserts absent.
_assert_present(session: ptr, command: string, target: string, want: int) -> (string, int) {
    res = shell.shell_eval(session, string.concat("text ", _sel(target)))
    found = _res_ok(res)
    if found == want { return (_step(command, target, 1, "presence as expected"), 1) }
    if want == 1 { return (_step(command, target, 0, string.concat("element not present: ", target)), 0) }
    return (_step(command, target, 0, string.concat("element unexpectedly present: ", target)), 0)
}

// ---- .side locator -> shell selector ----------------------------------------
// Selenium locators: id= / name= / css= / xpath= / linkText= / link= / //… .
// The shell speaks #id / .class / css= / xpath= / // / bare-css, so translate the
// ones it doesn't already take.
_sel(target: string) -> string {
    t = string.trim(target)
    if string.starts_with(t, "id=") == 1 { return string.concat("#", string.substring(t, 3, string.length(t))) }
    if string.starts_with(t, "name=") == 1 { return string.concat("css=[name=\"", string.concat(string.substring(t, 5, string.length(t)), "\"]")) }
    if string.starts_with(t, "linkText=") == 1 { return _link_xpath(string.substring(t, 9, string.length(t))) }
    if string.starts_with(t, "link=") == 1 { return _link_xpath(string.substring(t, 5, string.length(t))) }
    if string.starts_with(t, "css=") == 1 { return t }        // shell takes css= as-is
    if string.starts_with(t, "xpath=") == 1 { return t }      // and xpath=
    if string.starts_with(t, "//") == 1 { return t }          // and raw xpath
    return t                                                   // bare -> css (shell default)
}
_link_xpath(txt: string) -> string {
    return string.concat("xpath=//a[normalize-space()=\"", string.concat(txt, "\"]"))
}

// ---- shell-result inspection -------------------------------------------------
_res_ok(res_json: string) -> int {
    root, perr = json.parse(res_json)
    if string.length(perr) > 0 { return 0 }
    okv, _o = json.object_get(root, "ok")
    if okv == null { return 0 }
    return json.get_bool(okv)
}
_res_value_str(res_json: string) -> string {
    root, perr = json.parse(res_json)
    if string.length(perr) > 0 { return "" }
    vv, _v = json.object_get(root, "value")
    if vv == null { return "" }
    s, serr = json.get_string(vv)
    if string.length(serr) == 0 { return s }
    enc, _e = json.stringify(vv)
    return enc
}
_res_detail(res_json: string) -> string {
    root, perr = json.parse(res_json)
    if string.length(perr) > 0 { return res_json }
    ev, _e = json.object_get(root, "error")
    if ev != null { s, _s = json.get_string(ev); return s }
    iv, _i = json.object_get(root, "info")
    if iv != null { s, _s2 = json.get_string(iv); return s }
    return "ok"
}

// ---- json/report helpers -----------------------------------------------------
_step(command: string, target: string, ok: int, detail: string) -> string {
    return string.concat("{\"command\":", string.concat(_qs(command),
        string.concat(",\"target\":", string.concat(_qs(target),
        string.concat(",\"ok\":", string.concat(_bool(ok),
        string.concat(",\"detail\":", string.concat(_qs(detail), "}"))))))))
}
_append(acc: string, item: string) -> string {
    if string.length(acc) == 0 { return item }
    return string.concat(acc, string.concat(",", item))
}
_bool(v: int) -> string { if v == 1 { return "true" } return "false" }
_q(v: string) -> string { return string.concat("\"", string.concat(v, "\"")) }

_obj_str(obj: ptr, key: string) -> string {
    v, _v = json.object_get(obj, key)
    if v == null { return "" }
    s, serr = json.get_string(v)
    if string.length(serr) == 0 { return s }
    return ""
}
_esc(v: string) -> string {
    // minimal: strip quotes so a parse-error message can't break the JSON.
    return string.replace_all(v, "\"", "'")
}
_qs(v: string) -> string {
    out = "\""
    n = string.length(v)
    i = 0
    while i < n {
        c = string.substring(v, i, i + 1)
        if c == "\"" { out = string.concat(out, "\\\"") }
        else { if c == "\\" { out = string.concat(out, "\\\\") }
        else { if c == "\n" { out = string.concat(out, "\\n") }
        else { if c == "\r" { out = string.concat(out, "\\r") }
        else { if c == "\t" { out = string.concat(out, "\\t") }
        else { out = string.concat(out, c) } } } } }
        i = i + 1
    }
    return string.concat(out, "\"")
}
