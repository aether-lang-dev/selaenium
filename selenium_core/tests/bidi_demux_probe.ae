// core_tests/bidi_demux_probe.ae — pure-Aether unit test for the BiDi frame
// router (bidi_demux.ae, shape C), using std.spec. Proves the correctness core of
// the BiDi multiplexer with NO socket, NO browser, NO FFI: reply/event
// classification, id-keyed correlation (including out-of-order concurrent
// replies), uncorrelated-reply drop, cancel, event FIFO, and the bounded event
// queue's drop-oldest + lost-count. Run via core_tests/.tests.ae (lib("..")
// resolves bidi_demux). The live end-to-end BiDi slice is a separate,
// browser-dependent test (bidi_slice.ae / bidi_probe.ae).
//
// The it() blocks share ONE demux `d` and run in declaration order (std.spec
// executes them sequentially), so the stateful register->ingest->poll sequence is
// preserved. main() returns spec.run_summary(fw) — its verdict is the exit status
// (ae >= 0.612); a bare run_summary() would silently exit 0 on failure.
import bidi_demux
import std.string
import std.spec

main() {
    fw = spec.init()
    d = bidi_demux.demux_new()

    spec.describe(fw, "reply routing + correlation") {
        spec.it("a registered id's reply is routed and consumable once") callback {
            bidi_demux.demux_register(d, 1)
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"id\":1,\"result\":{\"ready\":true}}"), 1, "ingest reply -> 1")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 1), "{\"id\":1,\"result\":{\"ready\":true}}", "poll returns frame")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 1), "", "second poll empty (consumed)")
        }
        spec.it("an error reply is still id-routed") callback {
            bidi_demux.demux_register(d, 2)
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"id\":2,\"error\":\"unknown command\"}"), 1, "ingest error -> 1")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 2), "{\"id\":2,\"error\":\"unknown command\"}", "poll error frame")
        }
        spec.it("an uncorrelated reply is dropped, not kept") callback {
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"id\":999,\"result\":{}}"), 0, "unknown id -> 0")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 999), "", "poll(999) empty (mis-route guard)")
        }
        spec.it("out-of-order concurrent replies stay distinct") callback {
            bidi_demux.demux_register(d, 10)
            bidi_demux.demux_register(d, 11)
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"id\":11,\"result\":{\"tree\":\"B\"}}"), 1, "ingest 11 (before 10)")
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"id\":10,\"result\":{\"status\":\"A\"}}"), 1, "ingest 10")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 10), "{\"id\":10,\"result\":{\"status\":\"A\"}}", "poll(10) is A")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 11), "{\"id\":11,\"result\":{\"tree\":\"B\"}}", "poll(11) is B")
        }
        spec.it("cancel drops the slot: a late reply is discarded") callback {
            bidi_demux.demux_register(d, 20)
            bidi_demux.demux_cancel(d, 20)
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"id\":20,\"result\":{}}"), 0, "cancelled id -> 0")
            spec.assert_str_eq(bidi_demux.demux_poll_reply(d, 20), "", "poll(20) empty after cancel")
        }
    }

    spec.describe(fw, "event queue") {
        spec.it("an id-less frame routes to the event queue") callback {
            spec.assert_eq(bidi_demux.demux_ingest(d, "{\"type\":\"event\",\"method\":\"log.entryAdded\",\"params\":{}}"), 2, "ingest event -> 2")
            spec.assert_eq(bidi_demux.demux_event_count(d), 1, "event_count == 1")
            spec.assert_str_eq(bidi_demux.demux_poll_event(d), "{\"type\":\"event\",\"method\":\"log.entryAdded\",\"params\":{}}", "poll_event returns it")
            spec.assert_str_eq(bidi_demux.demux_poll_event(d), "", "poll_event empty after drain")
        }
        spec.it("events are FIFO") callback {
            _1 = bidi_demux.demux_ingest(d, "{\"type\":\"event\",\"method\":\"e1\"}")
            _2 = bidi_demux.demux_ingest(d, "{\"type\":\"event\",\"method\":\"e2\"}")
            spec.assert_str_eq(bidi_demux.demux_poll_event(d), "{\"type\":\"event\",\"method\":\"e1\"}", "FIFO 1st")
            spec.assert_str_eq(bidi_demux.demux_poll_event(d), "{\"type\":\"event\",\"method\":\"e2\"}", "FIFO 2nd")
        }
        spec.it("an unparseable frame routes nothing (-1)") callback {
            spec.assert_eq(bidi_demux.demux_ingest(d, "{not json"), -1, "garbage -> -1")
        }
        spec.it("the bounded queue drops oldest and counts the loss") callback {
            cap = bidi_demux.EVENT_QUEUE_MAX()
            over = cap + 5
            i = 0
            while i < over {
                _e = bidi_demux.demux_ingest(d, "{\"type\":\"event\",\"method\":\"flood\"}")
                i = i + 1
            }
            spec.assert_eq(bidi_demux.demux_event_count(d), cap, "queue bounded at EVENT_QUEUE_MAX")
            spec.assert_eq(bidi_demux.demux_lost_count(d), over - cap, "lost_count == overflow")
            spec.assert_eq(bidi_demux.demux_lost_count(d), 0, "lost_count resets to 0")
        }
    }

    _rc = spec.run_summary(fw)
    bidi_demux.demux_free(d)
    return _rc
}
