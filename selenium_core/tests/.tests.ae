// Pure-Aether engine probe — compiles selenium_core/tests/probe.ae against the
// LOCAL selenium_core module (one dir up, via lib("..")) and runs it. Proves the
// shared protocol logic (route table, path templating, By normalization, error
// map) with no browser and no FFI. caps("net") matches the engine's std.http
// use. The live-browser end-to-end test lives in the per-binding suites (e.g.
// python/.tests.ae).
import bldr
import aether

aeb(cap) {
    bldr.build() {
        aether.program_test() {
            source("probe.ae")
            lib("..")
            caps("net")
        }
        // BiDi frame-router unit test — pure demux logic (no socket/browser/FFI):
        // reply/event routing, out-of-order concurrent correlation, cancel, and
        // the bounded event queue. lib("..") resolves bidi_demux.
        aether.program_test() {
            source("bidi_demux_probe.ae")
            lib("..")
        }
        // Atom builders unit test — the executeScript params assembly for the
        // atom-backed commands (isDisplayed/getAttribute/getText), pure (no
        // browser/FFI). lib("..") resolves atoms.
        aether.program_test() {
            source("atoms_probe.ae")
            lib("..")
        }
        // Runner controller unit test — the interactive run/step/continue state
        // machine + runner-lane framing (reply correlation, paused/finished
        // events), pure (null session, no browser/FFI). lib("..") resolves
        // runner + shell + bidi_demux.
        aether.program_test() {
            source("runner_probe.ae")
            lib("..")
        }
        // iframe console bridge unit test — the pure correlation core
        // (bridge_process): feed the JSON the in-page outbox would yield, assert
        // the reply/event envelope (tagging, id correlation, batching, step-mode
        // framing). The executeScript page-I/O half is covered live. lib("..")
        // resolves iframe_bridge + runner + shell + bidi_demux.
        aether.program_test() {
            source("iframe_bridge_probe.ae")
            lib("..")
        }
        // .side (Selenium IDE) playback unit test — shell.side_run's project
        // parsing, per-command iteration, report shaping, stop-on-failure, and
        // unknown-command handling, pure (null session). lib("..") resolves shell.
        aether.program_test() {
            source("side_probe.ae")
            lib("..")
        }
        // Desktop-driver (WinAppDriver / Appium) proof — stands up a real
        // W3C-speaking HTTP endpoint that impersonates a desktop driver and
        // drives it through the engine. Proves the protocol path is genuinely
        // browser-agnostic (vendor caps, native locators, click/text/attribute)
        // and pins the one place it is not: By-normalization rewrites
        // id/name/class name to CSS, which desktop drivers reject. No Windows,
        // no Appium install, ~1s. caps("net") for the in-process server+client.
        aether.program_test() {
            source("desktop_probe.ae")
            lib("..")
            caps("net")
        }
        // Appium live proof — drives a REAL Appium server (not our fake
        // endpoint) through the engine: a browserless session from vendor
        // capabilities, native id/accessibility id/class name/xpath locators
        // surviving intact, a sendKeys->getText round trip, and Appium's own
        // error envelope decoding to the right W3C code. Self-skips green when
        // no Appium is reachable, so it is presubmit-safe on a box without one.
        // To run it: npm i appium && appium driver install --source=npm
        // @appium/fake-driver && appium --port 4723
        aether.program_test() {
            source("appium_live.ae")
            lib("..")
            caps("net")
        }
        // AT-SPI live proof — drives KDE's selenium-webdriver-at-spi (W3C
        // WebDriver over Linux AT-SPI2) against a REAL running application
        // (Kate): native accessibility id / name / xpath locators, reading a
        // live widget's text, and isDisplayed routing to the native endpoint
        // rather than a JS atom (there is no JS engine anywhere near AT-SPI).
        // Self-skips green when no such driver answers /status.
        aether.program_test() {
            source("atspi_live.ae")
            lib("..")
            caps("net")
        }
        // BiDi live slice — drives real Chrome through the shape-C demux:
        // commands, concurrency, AND the event round-trip (session.subscribe →
        // navigate → async browsingContext.load via the event queue). Self-skips
        // green when no driver is resolvable, so it's presubmit-safe on a
        // driverless box and gives real coverage where Chrome is present.
        // Needs net/os/fs (http + driver process + driver-manager cache).
        aether.program_test() {
            source("../bidi_slice.ae")
            lib("..")
            lib("../drivermgr")
            caps("net,os,fs")
        }
    }
}
