// Pure-Aether engine probe — compiles selenium_core/tests/probe.ae against the
// LOCAL selenium_core module (one dir up, via lib("..")) and runs it. Proves the
// shared protocol logic (route table, path templating, By normalization, error
// map) with no browser and no FFI. caps("net") matches the engine's std.http
// use. The live-browser end-to-end test lives in the per-binding suites (e.g.
// python/.tests.ae).
import bldr
import aether

aeb(cap) {
    bldr.build() {
        aether.program_test() {
            source("probe.ae")
            lib("..")
            caps("net")
        }
        // BiDi frame-router unit test — pure demux logic (no socket/browser/FFI):
        // reply/event routing, out-of-order concurrent correlation, cancel, and
        // the bounded event queue. lib("..") resolves bidi_demux.
        aether.program_test() {
            source("bidi_demux_probe.ae")
            lib("..")
        }
        // Atom builders unit test — the executeScript params assembly for the
        // atom-backed commands (isDisplayed/getAttribute/getText), pure (no
        // browser/FFI). lib("..") resolves atoms.
        aether.program_test() {
            source("atoms_probe.ae")
            lib("..")
        }
        // Runner controller unit test — the interactive run/step/continue state
        // machine + runner-lane framing (reply correlation, paused/finished
        // events), pure (null session, no browser/FFI). lib("..") resolves
        // runner + shell + bidi_demux.
        aether.program_test() {
            source("runner_probe.ae")
            lib("..")
        }
        // iframe console bridge unit test — the pure correlation core
        // (bridge_process): feed the JSON the in-page outbox would yield, assert
        // the reply/event envelope (tagging, id correlation, batching, step-mode
        // framing). The executeScript page-I/O half is covered live. lib("..")
        // resolves iframe_bridge + runner + shell + bidi_demux.
        aether.program_test() {
            source("iframe_bridge_probe.ae")
            lib("..")
        }
        // BiDi live slice — drives real Chrome through the shape-C demux:
        // commands, concurrency, AND the event round-trip (session.subscribe →
        // navigate → async browsingContext.load via the event queue). Self-skips
        // green when no driver is resolvable, so it's presubmit-safe on a
        // driverless box and gives real coverage where Chrome is present.
        // Needs net/os/fs (http + driver process + driver-manager cache).
        aether.program_test() {
            source("../bidi_slice.ae")
            lib("..")
            lib("../drivermgr")
            caps("net,os,fs")
        }
    }
}
