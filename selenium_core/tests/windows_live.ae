// Windows desktop — the third platform, same engine path as atspi_live.ae
// (Kate/Linux) and mac2_live.ae (Calculator/macOS). RUN and green against a real
// Windows 11 VM (2026-09-24): open Notepad, type into its edit control, read it
// back — the Win32 analogue of Kate's "New File" and Calculator's "1+2=3".
//
// DRIVER — NovaWindows, NOT WinAppDriver. Microsoft's WinAppDriver (last release
// 1.2.x, 2021) is effectively unmaintained and does NOT work on recent Windows 11
// builds (10.0.26200 here): appium-windows-driver launches it and it *listens* on
// its inner port, but it "fails to respond with a proper status" and never
// completes a session. appium-novawindows-driver drives UI Automation NATIVELY
// (no WinAppDriver.exe dependency) and works. Both still speak W3C to us; the
// engine's desktop path (native By, real /text and /displayed endpoints) is
// identical either way. Setup on the guest:
//
//   npm i -g appium
//   appium driver install --source=npm appium-novawindows-driver
//   appium --address 127.0.0.1 --port 4723    # run from the INTERACTIVE desktop
//                                             # session — a desktop driver needs a
//                                             # desktop; launched from a service
//                                             # (Session 0) session it cannot attach
//
// (Should a WinAppDriver that supports the current Windows build ever ship —
// e.g. microsoft/WinAppDriver#2022 — automationName "Windows" would work too;
// NovaWindows is what works today.)
//
// LOCATORS ARE NATIVE. Modern Notepad's edit area is a UIA Document with
// ClassName "RichEditD2DPT" and an empty AutomationId, so we find it by
// `class name` — the driver's own control class, NOT a CSS class. If a find
// fails, dump getPageSource and read the real tree rather than guessing.
import selenium_core
import std.string
import std.os
import std.spec

main() {
    // NO DEFAULT PORT, deliberately. 4723 is Appium's generic port and says
    // nothing about which driver is behind it — defaulting there made this test
    // open a session against a local fake-driver Appium and fail with
    // "invalid session id", which looks like a Windows bug and is not one.
    // An explicit URL is the only way to know the endpoint is the one meant.
    base = os.getenv("SEL_WINDOWS_URL")
    if string.length(base) == 0 {
        println("SKIPPED: SEL_WINDOWS_URL unset (point it at appium-windows-driver, e.g. http://<win-host>:4723)")
        return 0
    }
    ready = _ready(base)
    if ready == 0 {
        println("SKIPPED: no Appium/windows endpoint at ${base}")
        return 0
    }
    if ready < 0 {
        // NOT a skip. Something IS listening, it just speaks the wrong dialect
        // — overwhelmingly likely raw WinAppDriver on its default port. Skipping
        // green here would report "nothing to test" when the truth is "your
        // endpoint cannot be driven", which is the non-answer-as-negative-answer
        // trap this repo keeps a section about.
        println("FAILED: ${base} answered, but not as a W3C endpoint:")
        println("  ${_why(base)}")
        return 1
    }
    fw = spec.init()
    sp = selenium_core.session_new(base)

    spec.describe(fw, "windows: a real Windows application") {
        spec.it("opens a Notepad session (NovaWindows)") callback {
            // NovaWindows + Notepad (Win32). Forward-slash path avoids JSON
            // backslash-escaping; NovaWindows drives UIA natively.
            caps = "{\"capabilities\":{\"alwaysMatch\":{\"platformName\":\"Windows\",\"appium:automationName\":\"NovaWindows\",\"appium:app\":\"C:/Windows/System32/notepad.exe\"}}}"
            rc = selenium_core.execute(sp, "newSession", caps)
            spec.assert_eq(rc, 0, "newSession rc")
            spec.assert_true(string.length(selenium_core.session_id_of(sp)) > 0, "session id")
        }
        spec.it("is detected as native from the request capabilities") callback {
            // platformName Windows + appium:* and no browserName. This fires on
            // the REQUEST, so it works even if the driver echoes nothing back.
            spec.assert_eq(selenium_core.session_is_native(sp), 1, "native mode on")
        }
    }

    spec.describe(fw, "windows: driving the real UI") {
        // Notepad's edit area is a UIA Document with ClassName "RichEditD2DPT"
        // (empty AutomationId), so we locate it by `class name` — the driver's
        // OWN control class, not CSS. This id is held across the it() blocks.
        eid = ""
        spec.it("finds the editor by its native ClassName") callback {
            rc = selenium_core.execute(sp, "findElement",
                "{\"using\":\"class name\",\"value\":\"RichEditD2DPT\"}")
            spec.assert_eq(rc, 0, "find editor rc")
            eid = _elem_id(selenium_core.last_value_of(sp))
            spec.assert_true(string.length(eid) > 0, "editor element id")
        }
        spec.it("types text and reads it back off the real control") callback {
            spec.assert_true(string.length(eid) > 0, "have editor id")
            p = string.concat("{\"id\":\"", string.concat(eid,
                "\",\"text\":\"selaenium drives windows\"}"))
            rc = selenium_core.execute(sp, "sendKeysToElement", p)
            spec.assert_eq(rc, 0, "sendKeys rc")
            g = string.concat("{\"id\":\"", string.concat(eid, "\"}"))
            rc2 = selenium_core.execute(sp, "getElementText", g)
            spec.assert_eq(rc2, 0, "getElementText rc")
            spec.assert_contains(selenium_core.last_value_of(sp),
                "selaenium drives windows", "typed text reads back")
        }
        spec.it("quit closes the real session") callback {
            rc = selenium_core.execute(sp, "quit", "{}")
            spec.assert_eq(rc, 0, "quit rc")
        }
    }

    selenium_core.session_free(sp)
    return spec.run_summary(fw)
}

// 1 = a W3C endpoint is ready; 0 = nothing is listening (skip); -1 = something
// answered but we cannot drive it (fail, and say why).
_ready(base: string) -> int {
    probe = selenium_core.session_new(base)
    rc = selenium_core.execute(probe, "status", "{}")
    v = selenium_core.last_value_of(probe)
    err = selenium_core.last_error_of(probe)
    selenium_core.session_free(probe)
    if rc == 0 {
        if string.index_of(v, "ready") < 0 { return 0 }
        return 1
    }
    // A transport failure means nothing is there. Anything else means the port
    // answered and we could not use the answer.
    if string.index_of(err, "JSON Wire Protocol") >= 0 { return -1 }
    if string.index_of(err, "connection") >= 0 { return 0 }
    if string.index_of(err, "transport") >= 0 { return 0 }
    return 0
}

_why(base: string) -> string {
    probe = selenium_core.session_new(base)
    _rc = selenium_core.execute(probe, "status", "{}")
    e = selenium_core.last_error_of(probe)
    selenium_core.session_free(probe)
    return e
}

_KEY() -> string { return "\"element-6066-11e4-a52e-4f735466cecf\":\"" }

_elem_id(v: string) -> string {
    at = string.index_of(v, _KEY())
    if at < 0 { return "" }
    rest = string.substring(v, at + string.length(_KEY()), string.length(v))
    end = string.index_of(rest, "\"")
    if end < 0 { return "" }
    return string.substring(rest, 0, end)
}
