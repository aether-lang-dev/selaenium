// core_tests/atoms_probe.ae — pure-Aether unit test for the atom builders
// (atoms.ae). Proves the executeScript params assembly for atom-backed commands
// (isDisplayed / getAttribute / getText) with NO browser and NO FFI: the atom
// source is present, the args array carries the element ref first, extra args
// splice correctly, and unknown atoms yield "". Run via core_tests/.tests.ae
// (lib("..") resolves atoms). The live behavior is proven separately (a browser
// test that actually runs the atoms).
import atoms
import std.string

extern exit(code: int)

check(label: string, cond: int) -> int {
    if cond == 1 { println("  ok: ${label}"); return 0 }
    println("FAIL: ${label}"); return 1
}

check_eq(label: string, got: string, want: string) -> int {
    if string.equals(got, want) == 1 { println("  ok: ${label}"); return 0 }
    println("FAIL: ${label}")
    println("      got:  ${got}")
    println("      want: ${want}")
    return 1
}

has(hay: string, needle: string) -> int {
    if string.contains(hay, needle) == 1 { return 1 }
    return 0
}

main() {
    println("== atoms probe ==")
    fails = 0

    // ---- atom bodies exist for the known atoms, empty for unknown ----
    fails = fails + check("isDisplayed body present", _gt0(string.length(atoms.atom_body("isDisplayed"))))
    fails = fails + check("getAttribute body present", _gt0(string.length(atoms.atom_body("getAttribute"))))
    fails = fails + check("getText body present", _gt0(string.length(atoms.atom_body("getText"))))
    fails = fails + check_eq("unknown atom body empty", atoms.atom_body("noSuchAtom"), "")

    // ---- atom_script wraps the body as an applied function ----
    scr = atoms.atom_script("isDisplayed")
    fails = fails + check("script starts with return (", has(scr, "return (function(el)"))
    fails = fails + check("script applies arguments", has(scr, ".apply(null, arguments);"))
    fails = fails + check_eq("unknown atom script empty", atoms.atom_script("noSuchAtom"), "")

    // ---- atom_args: element ref first, then extras ----
    a0 = atoms.atom_args("e.1", "")
    fails = fails + check_eq("args, no extra",
             a0, "[{\"element-6066-11e4-a52e-4f735466cecf\":\"e.1\"}]")
    a1 = atoms.atom_args("e.2", "[\"href\"]")
    fails = fails + check_eq("args, one extra",
             a1, "[{\"element-6066-11e4-a52e-4f735466cecf\":\"e.2\"},\"href\"]")
    a2 = atoms.atom_args("e.3", "[]")
    fails = fails + check_eq("args, empty extra array",
             a2, "[{\"element-6066-11e4-a52e-4f735466cecf\":\"e.3\"}]")

    // ---- atom_params: full executeScript params {script,args} ----
    p = atoms.atom_params("getAttribute", "e.9", "[\"value\"]")
    fails = fails + check("params has script key", has(p, "\"script\":"))
    fails = fails + check("params has args key", has(p, "\"args\":"))
    fails = fails + check("params carries the element ref", has(p, "element-6066-11e4-a52e-4f735466cecf"))
    fails = fails + check("params carries the extra arg", has(p, "value"))
    // the script value is a JSON string literal: "script":"return (function...
    fails = fails + check("params script is a JSON string literal",
             has(p, "\"script\":\"return (function"))
    fails = fails + check_eq("unknown atom params empty", atoms.atom_params("noSuchAtom", "e.1", ""), "")

    // ---- relative locators: findElementsRelative params ----
    fails = fails + check("relative atom body present", _gt0(string.length(atoms.atom_body("findElementsRelative"))))
    rp = atoms.relative_params("button", "[{\"kind\":\"below\",\"sel\":\"#anchor\"}]")
    fails = fails + check("relative params has script", has(rp, "\"script\":"))
    fails = fails + check("relative params carries base sel", has(rp, "button"))
    fails = fails + check("relative params carries the filter", has(rp, "below"))
    fails = fails + check("relative params carries the anchor sel", has(rp, "#anchor"))
    // empty filters default to []
    rp0 = atoms.relative_params("a", "")
    fails = fails + check("relative params empty filters -> []", has(rp0, "\"args\":[\"a\",[]]"))

    if fails == 0 {
        println("PASS: all atoms probes green")
        exit(0)
    }
    println("FAILED: ${fails} probe(s)")
    exit(1)
}

_gt0(n: int) -> int { if n > 0 { return 1 } return 0 }
