// drivercache_probe.ae — verifies atomic publication behavior without network
// downloads or a browser. The second staged result represents another process
// finishing after a cache winner has already published the artifact.
import drivercache
import std.fs
import std.spec
import std.string

main() {
    fw = spec.init()
    spec.describe(fw, "driver cache staged install") {
        spec.it("keeps the first complete artifact when another installer races") callback {
            root, err = fs.make_temp_dir("", "selenium-cache-probe-")
            spec.assert_eq(string.length(err), 0, "create temp root")
            cache_dir = string.concat(root, "/cache")
            _md = fs.mkdir_p(cache_dir)
            target = string.concat(cache_dir, "/chromedriver")
            staged1 = string.concat(root, "/stage-one")
            staged2 = string.concat(root, "/stage-two")
            _w1 = fs.write(staged1, "first complete driver")
            _w2 = fs.write(staged2, "second complete driver")

            spec.assert_str_eq(drivercache.install_staged(staged1, target), target, "first installer publishes")
            spec.assert_str_eq(drivercache.install_staged(staged2, target), target, "later installer uses cache winner")
            content, read_err = fs.read(target)
            spec.assert_eq(string.length(read_err), 0, "read installed driver")
            spec.assert_str_eq(content, "first complete driver", "winner is not overwritten")
            _rm = fs.remove_tree(root)
        }
        spec.it("publishes browser support files before its executable marker") callback {
            root, err = fs.make_temp_dir("", "selenium-browser-cache-probe-")
            spec.assert_eq(string.length(err), 0, "create temp root")
            staged = string.concat(root, "/stage")
            staged_bin_dir = string.concat(staged, "/chrome-linux64")
            staged_data_dir = string.concat(staged_bin_dir, "/locales")
            _md1 = fs.mkdir_p(staged_data_dir)
            _wb = fs.write(string.concat(staged_bin_dir, "/chrome"), "complete browser binary")
            _wd = fs.write(string.concat(staged_data_dir, "/en-US.pak"), "browser support data")
            cache = string.concat(root, "/cache")
            target_dir = string.concat(cache, "/chrome/stable/123")

            result = drivercache.install_browser_staged(staged_bin_dir, target_dir, "chrome")
            target = string.concat(target_dir, "/chrome")
            spec.assert_str_eq(result, target, "browser installer publishes executable path")
            content, read_err = fs.read(target)
            spec.assert_eq(string.length(read_err), 0, "read published browser")
            spec.assert_str_eq(content, "complete browser binary", "published browser is complete")
            support, support_err = fs.read(string.concat(target_dir, "/locales/en-US.pak"))
            spec.assert_eq(string.length(support_err), 0, "support files published before executable")
            spec.assert_str_eq(support, "browser support data", "browser support data is complete")

            later = string.concat(root, "/later")
            _mdl = fs.mkdir_p(later)
            _wbl = fs.write(string.concat(later, "/chrome"), "losing browser binary")
            spec.assert_str_eq(drivercache.install_browser_staged(later, target_dir, "chrome"), target, "later installer accepts cache winner")
            _rm = fs.remove_tree(root)
        }
    }
    return spec.run_summary(fw)
}
