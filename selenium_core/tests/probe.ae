// core_tests/probe.ae — pure-Aether engine probe, using std.spec. Proves the
// protocol logic (route table, path templating, By normalization, build_request
// wire format, error-code map, response error detection) with NO live browser and
// NO FFI — testing the shared engine directly. Run via core_tests/.tests.ae.
//
// A live end-to-end session against a real chromedriver is a separate,
// browser-dependent test (see python/test); this probe is the fast gate that the
// shared protocol logic is correct. main() returns spec.run_summary(fw) — its
// verdict is the exit status (ae >= 0.612); a bare run_summary() would silently
// exit 0 on failure.

import selenium_core
import std.json
import std.string
import std.spec

main() {
    fw = spec.init()

    spec.describe(fw, "route table") {
        spec.it("known commands map to their W3C route") callback {
            spec.assert_str_eq(selenium_core.route("newSession"), "POST /session", "newSession")
            spec.assert_str_eq(selenium_core.route("quit"), "DELETE /session/:sessionId", "quit")
            spec.assert_str_eq(selenium_core.route("get"), "POST /session/:sessionId/url", "get")
            spec.assert_str_eq(selenium_core.route("findElement"), "POST /session/:sessionId/element", "findElement")
            spec.assert_str_eq(selenium_core.route("clickElement"), "POST /session/:sessionId/element/:id/click", "clickElement")
            spec.assert_str_eq(selenium_core.route("getElementText"), "GET /session/:sessionId/element/:id/text", "getElementText")
            spec.assert_str_eq(selenium_core.route("getDomAttribute"), "GET /session/:sessionId/element/:id/attribute/:name", "getDomAttribute")
        }
        spec.it("an unknown command has no route") callback {
            spec.assert_str_eq(selenium_core.route("no_such_command"), "", "unknown")
        }
    }

    spec.describe(fw, "path templating") {
        spec.it("substitutes :sessionId and :id") callback {
            params = json.obj()
            _e1 = json.set(params, "sessionId", json.str("abc123"))
            _e2 = json.set(params, "id", json.str("elem-9"))
            spec.assert_str_eq(selenium_core.build_path("/session/:sessionId/element/:id/click", params),
                "/session/abc123/element/elem-9/click", "click path")
            json.free(params)
        }
        spec.it("substitutes :name") callback {
            params2 = json.obj()
            _e3 = json.set(params2, "sessionId", json.str("S"))
            _e4 = json.set(params2, "name", json.str("cookieName"))
            spec.assert_str_eq(selenium_core.build_path("/session/:sessionId/cookie/:name", params2),
                "/session/S/cookie/cookieName", "cookie path")
            json.free(params2)
        }
    }

    spec.describe(fw, "By normalization") {
        spec.it("css passthrough + id/className/name rewritten to CSS") callback {
            spec.assert_str_eq(selenium_core.by_locator("css selector", "div.foo"),
                "{\"using\":\"css selector\",\"value\":\"div.foo\"}", "css")
            spec.assert_str_eq(selenium_core.by_locator("id", "main"),
                "{\"using\":\"css selector\",\"value\":\"*[id=\\\"main\\\"]\"}", "id -> css")
            spec.assert_str_eq(selenium_core.by_locator("className", "btn"),
                "{\"using\":\"css selector\",\"value\":\".btn\"}", "className -> css")
            spec.assert_str_eq(selenium_core.by_locator("name", "q"),
                "{\"using\":\"css selector\",\"value\":\"*[name=\\\"q\\\"]\"}", "name -> css")
            spec.assert_str_eq(selenium_core.by_locator("xpath", "//a"),
                "{\"using\":\"xpath\",\"value\":\"//a\"}", "xpath passthrough")
        }
    }

    spec.describe(fw, "build_request (the pure request builder)") {
        spec.it("path params, body split, unknown, and DELETE") callback {
            spec.assert_str_eq(selenium_core.build_request("getCookie", "S1", "{\"name\":\"foo\"}"),
                "GET\t/session/S1/cookie/foo\t", "getCookie")
            spec.assert_str_eq(selenium_core.build_request("get", "S1", "{\"url\":\"http://x/\"}"),
                "POST\t/session/S1/url\t{\"url\":\"http://x/\"}", "get(url)")
            spec.assert_str_eq(selenium_core.build_request("sendKeysToElement", "S1", "{\"id\":\"E9\",\"text\":\"hi\"}"),
                "POST\t/session/S1/element/E9/value\t{\"text\":\"hi\"}", "sendKeys (:id to path)")
            spec.assert_str_eq(selenium_core.build_request("newSession", "", "{\"capabilities\":{\"alwaysMatch\":{}}}"),
                "POST\t/session\t{\"capabilities\":{\"alwaysMatch\":{}}}", "newSession")
            spec.assert_str_eq(selenium_core.build_request("bogus", "S1", "{}"),
                "ERR\tUnrecognized command: bogus\t", "unknown -> ERR")
            spec.assert_str_eq(selenium_core.build_request("quit", "S1", "{}"),
                "DELETE\t/session/S1\t", "quit")
        }
        spec.it("surface commands pin the wire format for every binding") callback {
            spec.assert_str_eq(selenium_core.build_request("getWindowHandles", "S1", "{}"),
                "GET\t/session/S1/window/handles\t", "getWindowHandles")
            spec.assert_str_eq(selenium_core.build_request("setWindowRect", "S1", "{\"width\":800,\"height\":600}"),
                "POST\t/session/S1/window/rect\t{\"width\":800,\"height\":600}", "setWindowRect")
            spec.assert_str_eq(selenium_core.build_request("addCookie", "S1", "{\"cookie\":{\"name\":\"k\",\"value\":\"v\"}}"),
                "POST\t/session/S1/cookie\t{\"cookie\":{\"name\":\"k\",\"value\":\"v\"}}", "addCookie")
            spec.assert_str_eq(selenium_core.build_request("deleteCookie", "S1", "{\"name\":\"k\"}"),
                "DELETE\t/session/S1/cookie/k\t", "deleteCookie")
            spec.assert_str_eq(selenium_core.build_request("acceptAlert", "S1", "{}"),
                "POST\t/session/S1/alert/accept\t{}", "acceptAlert")
            spec.assert_str_eq(selenium_core.build_request("setAlertValue", "S1", "{\"text\":\"hi\"}"),
                "POST\t/session/S1/alert/text\t{\"text\":\"hi\"}", "setAlertValue")
            spec.assert_str_eq(selenium_core.build_request("actions", "S1", "{\"actions\":[]}"),
                "POST\t/session/S1/actions\t{\"actions\":[]}", "actions")
            spec.assert_str_eq(selenium_core.build_request("clearActions", "S1", "{}"),
                "DELETE\t/session/S1/actions\t", "clearActions")
            spec.assert_str_eq(selenium_core.build_request("setTimeout", "S1", "{\"implicit\":5000}"),
                "POST\t/session/S1/timeouts\t{\"implicit\":5000}", "setTimeout")
            spec.assert_str_eq(selenium_core.build_request("screenshot", "S1", "{}"),
                "GET\t/session/S1/screenshot\t", "screenshot")
        }
    }

    spec.describe(fw, "error-code map + response error detection") {
        spec.it("error_code maps W3C strings to stable ints") callback {
            spec.assert_eq(selenium_core.error_code(""), 0, "success")
            spec.assert_eq(selenium_core.error_code("no such element"), 17, "no such element")
            spec.assert_eq(selenium_core.error_code("stale element reference"), 23, "stale")
            spec.assert_eq(selenium_core.error_code("unknown command"), 28, "unknown command")
            spec.assert_eq(selenium_core.error_code("some new error"), 1, "unmapped -> unknown")
        }
        spec.it("response_error_code decodes error envelopes, not swallows them") callback {
            spec.assert_eq(selenium_core.response_error_code(
                "{\"value\":{\"error\":\"no such element\",\"message\":\"nope\"}}"), 17, "err no such element")
            spec.assert_eq(selenium_core.response_error_code(
                "{\"value\":{\"error\":\"stale element reference\"}}"), 23, "err stale")
            spec.assert_eq(selenium_core.response_error_code(
                "{\"value\":{\"element-6066-11e4-a52e-4f735466cecf\":\"e.1\"}}"), 0, "success object")
            spec.assert_eq(selenium_core.response_error_code("{\"value\":\"Some Title\"}"), 0, "success string")
            spec.assert_eq(selenium_core.response_error_code("{\"value\":null}"), 0, "success null")
        }
    }

    return spec.run_summary(fw)
}
