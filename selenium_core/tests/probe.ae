// core_tests/probe.ae — pure-Aether engine probe. Proves the protocol logic
// (route table, path templating, By normalization, error-code map) with NO
// live browser and NO FFI — the servirtium-vcr / html-sanitizer pattern of
// testing the engine directly. Run via core_tests/.tests.ae.
//
// A live end-to-end session against a real chromedriver is a separate,
// browser-dependent test (see python/test); this probe is the fast gate that
// the shared protocol logic is correct.

import selenium_core
import std.json
import std.string

extern exit(code: int)

// Each check returns 1 on failure, 0 on pass, so main() can sum them.
check_eq(label: string, got: string, want: string) -> int {
    if string.equals(got, want) == 1 {
        println("  ok: ${label}")
        return 0
    }
    println("FAIL: ${label}")
    println("      got:  ${got}")
    println("      want: ${want}")
    return 1
}

check_int(label: string, got: int, want: int) -> int {
    if got == want {
        println("  ok: ${label}")
        return 0
    }
    println("FAIL: ${label} got=${got} want=${want}")
    return 1
}

main() {
    println("== selenium_core engine probe ==")
    fails = 0

    // ---- route table ----
    fails = fails + check_eq("route newSession", selenium_core.route("newSession"), "POST /session")
    fails = fails + check_eq("route quit", selenium_core.route("quit"), "DELETE /session/:sessionId")
    fails = fails + check_eq("route get", selenium_core.route("get"), "POST /session/:sessionId/url")
    fails = fails + check_eq("route findElement", selenium_core.route("findElement"), "POST /session/:sessionId/element")
    fails = fails + check_eq("route clickElement", selenium_core.route("clickElement"),
             "POST /session/:sessionId/element/:id/click")
    fails = fails + check_eq("route getElementText", selenium_core.route("getElementText"),
             "GET /session/:sessionId/element/:id/text")
    fails = fails + check_eq("route getDomAttribute", selenium_core.route("getDomAttribute"),
             "GET /session/:sessionId/element/:id/attribute/:name")
    fails = fails + check_eq("route unknown", selenium_core.route("no_such_command"), "")

    // ---- path templating ----
    params = json.obj()
    _e1 = json.set(params, "sessionId", json.str("abc123"))
    _e2 = json.set(params, "id", json.str("elem-9"))
    p1 = selenium_core.build_path("/session/:sessionId/element/:id/click", params)
    fails = fails + check_eq("build_path click", p1, "/session/abc123/element/elem-9/click")
    json.free(params)

    params2 = json.obj()
    _e3 = json.set(params2, "sessionId", json.str("S"))
    _e4 = json.set(params2, "name", json.str("cookieName"))
    p2 = selenium_core.build_path("/session/:sessionId/cookie/:name", params2)
    fails = fails + check_eq("build_path cookie", p2, "/session/S/cookie/cookieName")
    json.free(params2)

    // ---- By normalization ----
    fails = fails + check_eq("by css", selenium_core.by_locator("css selector", "div.foo"),
             "{\"using\":\"css selector\",\"value\":\"div.foo\"}")
    fails = fails + check_eq("by id -> css", selenium_core.by_locator("id", "main"),
             "{\"using\":\"css selector\",\"value\":\"*[id=\\\"main\\\"]\"}")
    fails = fails + check_eq("by className -> css", selenium_core.by_locator("className", "btn"),
             "{\"using\":\"css selector\",\"value\":\".btn\"}")
    fails = fails + check_eq("by name -> css", selenium_core.by_locator("name", "q"),
             "{\"using\":\"css selector\",\"value\":\"*[name=\\\"q\\\"]\"}")
    fails = fails + check_eq("by xpath passthrough", selenium_core.by_locator("xpath", "//a"),
             "{\"using\":\"xpath\",\"value\":\"//a\"}")

    // ---- build_request (the pure request-builder shared with execute) ----
    // GET with a path param: :sessionId injected, :name from params, no body.
    fails = fails + check_eq("build_request getCookie",
             selenium_core.build_request("getCookie", "S1", "{\"name\":\"foo\"}"),
             "GET\t/session/S1/cookie/foo\t")
    // POST navigation: :sessionId injected, url stays in the body.
    fails = fails + check_eq("build_request get(url)",
             selenium_core.build_request("get", "S1", "{\"url\":\"http://x/\"}"),
             "POST\t/session/S1/url\t{\"url\":\"http://x/\"}")
    // Element command: :id consumed from params into the path, NOT the body.
    fails = fails + check_eq("build_request sendKeys",
             selenium_core.build_request("sendKeysToElement", "S1",
                 "{\"id\":\"E9\",\"text\":\"hi\"}"),
             "POST\t/session/S1/element/E9/value\t{\"text\":\"hi\"}")
    // newSession: no session yet, whole params object becomes the body.
    fails = fails + check_eq("build_request newSession",
             selenium_core.build_request("newSession", "",
                 "{\"capabilities\":{\"alwaysMatch\":{}}}"),
             "POST\t/session\t{\"capabilities\":{\"alwaysMatch\":{}}}")
    // Unknown command -> ERR envelope.
    fails = fails + check_eq("build_request unknown",
             selenium_core.build_request("bogus", "S1", "{}"),
             "ERR\tUnrecognized command: bogus\t")
    // DELETE with only a path param: empty body.
    fails = fails + check_eq("build_request quit",
             selenium_core.build_request("quit", "S1", "{}"),
             "DELETE\t/session/S1\t")

    // ---- surface commands (pin the wire format for every binding) ----
    // Windows.
    fails = fails + check_eq("build_request getWindowHandles",
             selenium_core.build_request("getWindowHandles", "S1", "{}"),
             "GET\t/session/S1/window/handles\t")
    fails = fails + check_eq("build_request setWindowRect",
             selenium_core.build_request("setWindowRect", "S1",
                 "{\"width\":800,\"height\":600}"),
             "POST\t/session/S1/window/rect\t{\"width\":800,\"height\":600}")
    // Cookies: POST body carries the cookie object; GET/:name uses the path.
    fails = fails + check_eq("build_request addCookie",
             selenium_core.build_request("addCookie", "S1",
                 "{\"cookie\":{\"name\":\"k\",\"value\":\"v\"}}"),
             "POST\t/session/S1/cookie\t{\"cookie\":{\"name\":\"k\",\"value\":\"v\"}}")
    fails = fails + check_eq("build_request deleteCookie",
             selenium_core.build_request("deleteCookie", "S1", "{\"name\":\"k\"}"),
             "DELETE\t/session/S1/cookie/k\t")
    // Alerts.
    fails = fails + check_eq("build_request acceptAlert",
             selenium_core.build_request("acceptAlert", "S1", "{}"),
             "POST\t/session/S1/alert/accept\t{}")
    fails = fails + check_eq("build_request setAlertValue",
             selenium_core.build_request("setAlertValue", "S1", "{\"text\":\"hi\"}"),
             "POST\t/session/S1/alert/text\t{\"text\":\"hi\"}")
    // Actions (the whole actions array is the body).
    fails = fails + check_eq("build_request actions",
             selenium_core.build_request("actions", "S1", "{\"actions\":[]}"),
             "POST\t/session/S1/actions\t{\"actions\":[]}")
    fails = fails + check_eq("build_request clearActions",
             selenium_core.build_request("clearActions", "S1", "{}"),
             "DELETE\t/session/S1/actions\t")
    // Timeouts.
    fails = fails + check_eq("build_request setTimeout",
             selenium_core.build_request("setTimeout", "S1", "{\"implicit\":5000}"),
             "POST\t/session/S1/timeouts\t{\"implicit\":5000}")
    // Screenshot (GET, empty body).
    fails = fails + check_eq("build_request screenshot",
             selenium_core.build_request("screenshot", "S1", "{}"),
             "GET\t/session/S1/screenshot\t")

    // ---- error code map ----
    fails = fails + check_int("err success", selenium_core.error_code(""), 0)
    fails = fails + check_int("err no such element", selenium_core.error_code("no such element"), 17)
    fails = fails + check_int("err stale", selenium_core.error_code("stale element reference"), 23)
    fails = fails + check_int("err unknown command", selenium_core.error_code("unknown command"), 28)
    fails = fails + check_int("err unmapped -> unknown", selenium_core.error_code("some new error"), 1)

    // ---- response error detection (pins the JSON-type-3 invariant) ----
    // A W3C error envelope must be decoded to its code, NOT swallowed as success.
    fails = fails + check_int("resp err no such element",
             selenium_core.response_error_code(
                 "{\"value\":{\"error\":\"no such element\",\"message\":\"nope\"}}"), 17)
    fails = fails + check_int("resp err stale",
             selenium_core.response_error_code(
                 "{\"value\":{\"error\":\"stale element reference\"}}"), 23)
    // A success payload (value is a plain object with no `error` key) is code 0.
    fails = fails + check_int("resp success object",
             selenium_core.response_error_code(
                 "{\"value\":{\"element-6066-11e4-a52e-4f735466cecf\":\"e.1\"}}"), 0)
    // A scalar value (e.g. a title string) is success.
    fails = fails + check_int("resp success string",
             selenium_core.response_error_code("{\"value\":\"Some Title\"}"), 0)
    // A null value is success.
    fails = fails + check_int("resp success null",
             selenium_core.response_error_code("{\"value\":null}"), 0)

    if fails == 0 {
        println("PASS: all engine probes green")
        exit(0)
    }
    println("FAILED: ${fails} probe(s)")
    exit(1)
}
