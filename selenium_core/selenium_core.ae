// selenium_core — the language-agnostic core of Selenium WebDriver, in pure
// Aether. One engine, many thin bindings (the servirtium-vcr / html-sanitizer
// shape). Everything a language binding used to reimplement — the W3C command
// catalog, the command -> (HTTP method, path template) route table, path
// templating, capabilities/By normalization, the W3C error-envelope decode,
// and the HTTP round-trip to the driver/Grid — lives HERE and is shared.
//
// A binding is a thin FFI shim (see core/embed.ae for the C ABI): it opens a
// session, issues commands by name with JSON params, and reads back the result
// value or a typed error. It carries NO protocol logic.
//
// Ported from javascript/selenium-webdriver/lib/{command,http,error,by}.js.
// W3C-only: the legacy JSON-wire (Selenium 2) client path is intentionally
// dropped — Selenium 4 speaks W3C to the remote end.

import std.http.client
import std.json
import std.string
import std.heap
import std.time
import atoms

// ---- Session handle ------------------------------------------------------
//
// One Session is one live (or nascent) WebDriver connection: the remote-end
// base URL, the session id (empty until newSession), and the drained result
// of the most recent execute() — the JSON `value` as a string, plus a decoded
// error code + message. A binding holds this as an opaque ptr and reads the
// last-result fields through the accessors below after each execute().

struct Session {
    base_url: string
    session_id: string
    last_status: int        // HTTP status of the last response (0 = transport failure)
    last_value: string      // JSON text of the response `value` (the useful payload)
    last_error_code: int    // decoded W3C error code (0 = success), see error_code()
    last_error: string      // human-readable error / transport-failure message
    ca_file: string         // TLS: pin the peer cert against THIS CA (""=system store)
    insecure: int           // TLS: 1 = skip verification (self-signed dev Grid); 0 = verify
    // --- desktop/native mode. 0 = browser (default), 1 = a native automation
    // endpoint: WinAppDriver, appium-windows-driver, appium-mac2-driver, and
    // the mobile drivers, all of which speak W3C WebDriver but have no CSS
    // engine. Set explicitly via session_set_native, or detected from the
    // newSession response (see _detect_native). Only by_locator_for reads it.
    native: int
    // --- Runner Phase 0: opt-in structured trace + named timers (shared by all
    // bindings). trace_on=1 makes execute() append a JSON Event per command to
    // trace_json; timers_json accumulates named spans. Both are drained + reset
    // via the trace_json/timers_json accessors. Off by default (zero overhead).
    trace_on: int           // 1 = record an Event per command; 0 = off (default)
    trace_json: string      // accumulated "[{event},{event},...]" or "" when empty
    trace_count: int        // number of events accumulated (for the array commas)
    timers_json: string     // accumulated "[{timer},...]" of stopped named spans
    timers_open: string     // "name\tstart_ms\n..." of currently-open timers
    // --- shell/.side variable store: values scraped from the page (the shell's
    // `store <name> <sel>`), interpolated into later shell lines via {{name}}.
    // "name\tvalue\n..." (same plain-string shape as timers_open; no map type).
    // Shell/.side/REPL only — the typed client API (get/sendKeys/...) never sees
    // {{...}}; a binding developer uses their own language's string building.
    vars: string
}

// Create a session bound to `base_url` (e.g. "http://127.0.0.1:9515" or a
// "https://grid.example.com" hub). No network I/O yet — call
// execute(s, "newSession", caps_json) to start one. HTTPS is native (ae 0.606+
// std.http.client): a plain https:// base_url follows the system CA store; for a
// private-CA or self-signed Grid, call session_set_ca / session_set_insecure.
session_new(base_url: string) -> ptr {
    s = heap.new(Session)
    // Copy the borrowed FFI string into an owned, ref-counted AetherString so
    // the struct field owns it — a bare store of the extern param would keep a
    // borrowed pointer that dangles once the caller's buffer is reused/freed.
    s.base_url = string.concat(base_url, "")
    s.session_id = ""
    s.last_status = 0
    s.last_value = ""
    s.last_error_code = 0
    s.last_error = ""
    s.ca_file = ""
    s.insecure = 0
    s.native = 0
    s.trace_on = 0
    s.trace_json = ""
    s.trace_count = 0
    s.timers_json = ""
    s.timers_open = ""
    s.vars = ""
    return s as ptr
}

// Pin the remote end's TLS cert against a private CA file (the "verify, but
// against THIS cert" mode — a self-hosted Grid with its own CA, courier the CA
// once). "" reverts to the system store. Strictly stronger than insecure.
session_set_ca(sp: ptr, ca_path: string) {
    if sp == null { return }
    s = sp as *Session
    s.ca_file = string.concat(ca_path, "")
}

// Skip TLS verification for this session (self-signed dev/staging Grid). Use
// only against hosts trusted out-of-band — session_set_ca is the safer knob.
session_set_insecure(sp: ptr, on: int) {
    if sp == null { return }
    s = sp as *Session
    s.insecure = on
}

session_free(sp: ptr) {
    if sp == null {
        return
    }
    heap.free(sp)
}

// ---- Runner Phase 0: structured trace + named timers ----------------------
// Opt-in, session-scoped, shared by every binding (they all funnel commands
// through execute()). A binding turns tracing on, drives its session, then
// drains the JSON. Off by default; a disabled session pays one int-compare.

// session_set_trace(sp, on) — 1 enables per-command Event recording, 0 disables.
// Desktop/native mode: 1 = the remote end is a native automation driver
// (WinAppDriver / Appium), 0 = a browser. Changes ONLY By-normalization, via
// by_locator_for: in native mode id/name/class name are the driver's own
// locator strategies and must reach the wire intact, where a browser wants them
// rewritten to CSS. Normally you do not call this — newSession detects it — but
// it is here for an endpoint that does not advertise itself clearly.
session_set_native(sp: ptr, on: int) {
    if sp == null { return }
    s = sp as *Session
    s.native = on
}

// 1 when this session is in desktop/native mode. Valid after newSession.
session_is_native(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *Session
    return s.native
}

session_set_trace(sp: ptr, on: int) {
    if sp == null { return }
    s = sp as *Session
    s.trace_on = on
}

// _json_str(s) — minimal JSON string escaping for the small fields we emit
// (command names, timer labels). Handles the quote/backslash/control cases a
// WebDriver command name or label realistically hits.
_json_str(v: string) -> string {
    out = "\""
    n = string.length(v)
    i = 0
    while i < n {
        c = string.substring(v, i, i + 1)
        if c == "\"" { out = string.concat(out, "\\\"") }
        else { if c == "\\" { out = string.concat(out, "\\\\") }
        else { out = string.concat(out, c) } }
        i = i + 1
    }
    return string.concat(out, "\"")
}

// _trace_record(s, command, rc, dur_ms) — append one Event to trace_json. Shape:
// {"command","timestamp","duration_ms","status","errorCode","passed"}. `passed`
// is rc==0; `status` is the HTTP status the command saw; `errorCode` the decoded
// W3C code. Timestamp is epoch seconds (wall clock). Called only when trace_on.
_trace_record(s: *Session, command: string, rc: int, dur_ms: long) {
    dt = time.now()
    ts = dt.epoch
    passed = "false"
    if rc == 0 { passed = "true" }
    ev = "{"
    ev = string.concat(ev, string.concat("\"command\":", _json_str(command)))
    ev = string.concat(ev, string.concat(",\"timestamp\":", string.from_long(ts)))
    ev = string.concat(ev, string.concat(",\"duration_ms\":", string.from_long(dur_ms)))
    ev = string.concat(ev, string.concat(",\"status\":", string.from_int(s.last_status)))
    ev = string.concat(ev, string.concat(",\"errorCode\":", string.from_int(s.last_error_code)))
    ev = string.concat(ev, string.concat(",\"passed\":", passed))
    ev = string.concat(ev, "}")
    if s.trace_count == 0 {
        s.trace_json = ev
    } else {
        s.trace_json = string.concat(s.trace_json, string.concat(",", ev))
    }
    s.trace_count = s.trace_count + 1
}

// trace_json_of(sp) — the accumulated events as a JSON array "[...]" ("[]" when
// none), then RESET the buffer (drain semantics — a binding polls periodically
// or once at the end). Owned string; the C ABI dups it.
trace_json_of(sp: ptr) -> string {
    if sp == null { return "[]" }
    s = sp as *Session
    out = string.concat("[", string.concat(s.trace_json, "]"))
    s.trace_json = ""
    s.trace_count = 0
    return out
}

// timer_start(sp, name) — begin a named span (records name + now_ms). Repeated
// starts of the same name overwrite (last start wins). No-op if tracing state
// is unavailable (null session).
timer_start(sp: ptr, name: string) {
    if sp == null { return }
    s = sp as *Session
    // epoch-ms is a long (~1.7e12) — NEVER store it as int (32-bit overflow).
    s.timers_open = string.concat(s.timers_open,
        string.concat(name, string.concat("\t", string.concat(string.from_long(time.now_ms()), "\n"))))
}

// timer_stop(sp, name) — close the most-recent open span of `name`, appending
// {"name","duration_ms"} to timers_json. Silently ignores an unknown name.
timer_stop(sp: ptr, name: string) {
    if sp == null { return }
    s = sp as *Session
    start_ms = _timers_open_take(s, name)
    if start_ms < 0 { return }
    dur = time.now_ms() - start_ms
    tm = string.concat("{\"name\":", string.concat(_json_str(name),
        string.concat(",\"duration_ms\":", string.concat(string.from_long(dur), "}"))))
    if string.length(s.timers_json) == 0 {
        s.timers_json = tm
    } else {
        s.timers_json = string.concat(s.timers_json, string.concat(",", tm))
    }
}

// _timers_open_take(s, name) — find the LAST "name\tstart\n" line for `name`,
// return its start_ms and remove that line; -1 if none open. Simple line scan
// (the open set is tiny — a handful of concurrently-timed spans).
_timers_open_take(s: *Session, name: string) -> long {
    pat = string.concat(name, "\t")
    body = s.timers_open
    found = -1 as long
    kept = ""
    rest = body
    while string.length(rest) > 0 {
        nl = string.index_of(rest, "\n")
        if nl < 0 { nl = string.length(rest) }
        line = string.substring(rest, 0, nl)
        rest = string.substring(rest, nl + 1, string.length(rest))
        if string.length(line) == 0 { continue }
        if string.starts_with(line, pat) == 1 {
            v = string.substring(line, string.length(pat), string.length(line))
            lv, _e = string.to_long(v)
            found = lv           // last match wins
        } else {
            kept = string.concat(kept, string.concat(line, "\n"))
        }
    }
    s.timers_open = kept
    return found
}

// timers_json_of(sp) — the accumulated stopped-timer spans as a JSON array,
// then reset. "[]" when none.
timers_json_of(sp: ptr) -> string {
    if sp == null { return "[]" }
    s = sp as *Session
    out = string.concat("[", string.concat(s.timers_json, "]"))
    s.timers_json = ""
    return out
}

// The base URL this session was opened against. Needed by the driver layer to
// tell a locally-launched driver from a remote Grid before it augments caps.
base_url_of(sp: ptr) -> string {
    if sp == null { return "" }
    s = sp as *Session
    return s.base_url
}

session_id_of(sp: ptr) -> string {
    if sp == null { return "" }
    s = sp as *Session
    return s.session_id
}

// var_set(sp, name, value) — store/replace a shell variable. Values hold
// "name\tvalue\n" rows; a re-set of an existing name drops the old row first.
// Newlines/tabs in the value would corrupt the row format, so they are
// space-normalized (a scraped page value is plain text for {{...}} splicing).
var_set(sp: ptr, name: string, value: string) {
    if sp == null { return }
    s = sp as *Session
    s.vars = _var_drop(s.vars, name)
    v = _var_clean(value)
    s.vars = string.concat(s.vars, string.concat(name, string.concat("\t", string.concat(v, "\n"))))
}

// var_get(sp, name) — the stored value for `name`, or "" if unset.
var_get(sp: ptr, name: string) -> string {
    if sp == null { return "" }
    s = sp as *Session
    key = string.concat(name, "\t")
    rows = s.vars
    // scan line-anchored: the row starts either at index 0 or right after a "\n".
    at = 0
    while at < string.length(rows) {
        line_start = at
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, line_start, line_end)
        if string.starts_with(row, key) == 1 {
            return string.substring(row, string.length(key), string.length(row))
        }
        if nl < 0 { return "" }
        at = line_end + 1
    }
    return ""
}

// _var_drop(rows, name) — the "name\t...\n" rows with `name`'s row removed.
_var_drop(rows: string, name: string) -> string {
    key = string.concat(name, "\t")
    out = ""
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.starts_with(row, key) == 0 {
            out = string.concat(out, string.concat(row, "\n"))
        }
        if nl < 0 { return out }
        at = line_end + 1
    }
    return out
}

// _var_clean(v) — replace \n and \t with spaces so a value can't break the
// row-delimited store.
_var_clean(v: string) -> string {
    out = ""
    i = 0
    while i < string.length(v) {
        c = string.substring(v, i, i + 1)
        if c == "\n" { out = string.concat(out, " ") }
        else { if c == "\t" { out = string.concat(out, " ") }
        else { out = string.concat(out, c) } }
        i = i + 1
    }
    return out
}

last_status_of(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *Session
    return s.last_status
}

last_value_of(sp: ptr) -> string {
    if sp == null { return "" }
    s = sp as *Session
    return s.last_value
}

last_error_code_of(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *Session
    return s.last_error_code
}

last_error_of(sp: ptr) -> string {
    if sp == null { return "" }
    s = sp as *Session
    return s.last_error
}

// ---- execute: the full command round-trip + W3C decode -------------------
//
// `name` is a command identifier (see route()); `params_json` is the JSON
// parameters object as text ("" or "{}" for none). The path parameters
// (:sessionId is injected from the session; :id/:name/etc. come from params)
// are substituted into the route path; the remaining params form the request
// body for POST. The response is decoded: on success last_value holds the JSON
// `value`; on a W3C error, last_error_code + last_error are set and the
// return is that non-zero code. Session id is captured on a newSession.
//
// Build the concrete HTTP request for a command WITHOUT sending it — the pure
// half of execute(), factored out so it can be unit-tested with no network and
// so a binding can inspect the wire form. Given a command `name`, a session id
// (""=none), and JSON params ("" or "{}"=none), returns "METHOD\tPATH\tBODY"
// (tab-separated) on success, or "ERR\t<message>\t" on an unknown command or
// bad params JSON. BODY is "" for non-POST methods.
build_request(name: string, session_id: string, params_json: string) -> string {
    spec = route(name)
    if spec == "" {
        return string.concat("ERR\tUnrecognized command: ", string.concat(name, "\t"))
    }
    sp_idx = string.index_of(spec, " ")
    method = string.substring(spec, 0, sp_idx)
    path_tmpl = string.substring(spec, sp_idx + 1, string.length(spec))

    pj = params_json
    if pj == "" {
        pj = "{}"
    }
    params, perr = json.parse(pj)
    if perr != "" {
        return string.concat("ERR\tInvalid params JSON: ", string.concat(perr, "\t"))
    }
    if session_id != "" {
        _si = json.set(params, "sessionId", json.str(session_id))
    }
    path = build_path(path_tmpl, params)
    body = ""
    if method == "POST" {
        body = body_without_path_params(params, path_tmpl)
    }
    json.free(params)

    out = string.concat(method, "\t")
    out = string.concat(out, path)
    out = string.concat(out, "\t")
    out = string.concat(out, body)
    return out
}

// Returns 0 on success, non-zero = the decoded error code (or -1 transport).
// execute(sp, name, params_json) — the single command chokepoint every binding
// funnels through. A thin tracing wrapper over _execute_inner: when the session
// has trace_on=1 it records a structured Event (command/timestamp/duration_ms/
// status/errorCode/passed) per call into trace_json — the Runner Phase 0 hook,
// shared by all 27 bindings for zero per-binding work. Off by default: one int
// test, no allocation, when tracing is disabled.
execute(sp: ptr, name: string, params_json: string) -> int {
    if sp == null {
        return -1
    }
    s = sp as *Session
    if s.trace_on == 0 {
        return _execute_inner(sp, name, params_json)
    }
    t0 = time.now_ms()
    rc = _execute_inner(sp, name, params_json)
    dur = time.now_ms() - t0
    _trace_record(s, name, rc, dur)
    return rc
}

// _is_find_command(name) — the six commands whose params carry a locator.
_is_find_command(name: string) -> int {
    if string.equals(name, "findElement") == 1 { return 1 }
    if string.equals(name, "findElements") == 1 { return 1 }
    if string.equals(name, "findChildElement") == 1 { return 1 }
    if string.equals(name, "findChildElements") == 1 { return 1 }
    if string.equals(name, "findElementFromShadowRoot") == 1 { return 1 }
    if string.equals(name, "findElementsFromShadowRoot") == 1 { return 1 }
    return 0
}

// _normalize_find_params(sp, name, params_json) — By-normalization at the ONE
// place that has both halves: the session (browser or desktop) and the params.
//
// This is where By-normalization was always supposed to happen. AGENTS.md says
// a binding's By.id("x") "carries {using: 'id'} and the ENGINE rewrites it",
// but until now the engine only offered it as a SEPARATE call (by_locator),
// which every binding had to make itself before calling execute. That pushed
// work outward for no reason, and when desktop mode arrived it meant twenty
// bindings each needed editing to reach it. Doing it here instead means a
// binding can hand over the raw strategy and get correct normalization for
// whatever kind of driver the session turned out to be — browser or desktop —
// with no FFI call of its own and no session handle to thread.
//
// IDEMPOTENT, which is what makes the migration safe. A binding that still
// pre-normalizes sends an already-normalized locator ("css selector",
// "accessibility id", "xpath"): every one of those hits the pass-through arm
// and comes back unchanged. So old and new bindings both work, and they can be
// converted one at a time.
//
// Note the one thing this CANNOT undo: a binding that pre-normalizes through
// the session-UNAWARE by_locator on a desktop session has already turned
// By.id into a CSS selector, and the original strategy is gone. That is why
// the bindings still want converting — not to make this work, but so desktop
// locators survive the trip.
_normalize_find_params(sp: ptr, name: string, params_json: string) -> string {
    if _is_find_command(name) == 0 { return params_json }
    root, perr = json.parse(params_json)
    if string.length(perr) > 0 { return params_json }
    uv, _uu = json.object_get(root, "using")
    vv, _vv = json.object_get(root, "value")
    if uv == null { json.free(root)  return params_json }
    if vv == null { json.free(root)  return params_json }
    using, _us = json.get_string(uv)
    value, _vs = json.get_string(vv)
    loc = by_locator_for(sp, using, value)
    lroot, lerr = json.parse(loc)
    if string.length(lerr) > 0 { json.free(root)  return params_json }
    nu, _nu = json.object_get(lroot, "using")
    nv, _nv = json.object_get(lroot, "value")
    if nu == null { json.free(lroot)  json.free(root)  return params_json }
    if nv == null { json.free(lroot)  json.free(root)  return params_json }
    nus, _ns = json.get_string(nu)
    nvs, _vs2 = json.get_string(nv)
    json.free(lroot)
    // Rewrite in place so every OTHER key the caller sent (the element id on a
    // child find, the shadow-root id) survives untouched.
    _su = json.set(root, "using", json.str(nus))
    _sv = json.set(root, "value", json.str(nvs))
    out, oerr = json.encode(root)
    json.free(root)
    if string.length(oerr) > 0 { return params_json }
    return out
}

_execute_inner(sp: ptr, name: string, params_json: string) -> int {
    if sp == null {
        return -1
    }
    s = sp as *Session
    s.last_status = 0
    s.last_value = ""
    s.last_error_code = 0
    s.last_error = ""

    // By-normalization lives here, not in the caller. See
    // _normalize_find_params: idempotent, so a binding that still pre-normalizes
    // is unaffected.
    eff_params = _normalize_find_params(sp, name, params_json)

    // Build the wire request (shared, tested path). Returns
    // "METHOD\tPATH\tBODY" or "ERR\t<message>\t".
    reqline = build_request(name, s.session_id, eff_params)
    t1 = string.index_of(reqline, "\t")
    field0 = string.substring(reqline, 0, t1)
    if field0 == "ERR" {
        // Extract the message between the two tabs.
        rest0 = string.substring(reqline, t1 + 1, string.length(reqline))
        t2 = string.index_of(rest0, "\t")
        msg = rest0
        if t2 >= 0 {
            msg = string.substring(rest0, 0, t2)
        }
        // An unknown command vs a bad-params error: classify by message prefix.
        if string.starts_with(msg, "Unrecognized command") == 1 {
            s.last_error_code = error_code("unknown command")
        } else {
            s.last_error_code = error_code("invalid argument")
        }
        s.last_error = msg
        return s.last_error_code
    }
    method = field0
    rest1 = string.substring(reqline, t1 + 1, string.length(reqline))
    t3 = string.index_of(rest1, "\t")
    path = string.substring(rest1, 0, t3)
    body = string.substring(rest1, t3 + 1, string.length(rest1))

    tagged = http_roundtrip(s.base_url, method, path, body, s.ca_file, s.insecure)
    // tagged is "ERR <msg>" or "OK <status> <body>"
    if string.starts_with(tagged, "ERR ") == 1 {
        s.last_error_code = -1
        s.last_error = string.substring(tagged, 4, string.length(tagged))
        return -1
    }
    // Strip "OK "
    rest = string.substring(tagged, 3, string.length(tagged))
    sp2 = string.index_of(rest, " ")
    status_str = string.substring(rest, 0, sp2)
    resp_body = string.substring(rest, sp2 + 1, string.length(rest))
    status, _sterr = string.to_int(status_str)
    s.last_status = status

    return decode_response(s, name, resp_body)
}

// execute_atom(sp, atom_name, elem_id, extra_json) — run a JS "atom" (a command
// with no direct W3C endpoint: isDisplayed / getAttribute / getText) against an
// element, via executeScript. The atom source + arg assembly live in atoms.ae,
// so every binding shares ONE implementation instead of hand-rolling it over
// executeScript. `elem_id` is a W3C element id; `extra_json` is a JSON array of
// any extra args (e.g. ["href"] for getAttribute), "" for none. Result drains via
// the normal last_value_of accessor. Returns 0 / a W3C error code / -1, exactly
// like execute(). An unknown atom is reported as "invalid argument".
// _atom_native(s, atom_name, elem_id, extra_json) — the NATIVE W3C endpoint
// that does the same job as an atom, for a desktop session.
//
// isDisplayed / getAttribute / getText have no W3C route in a BROWSER's world
// the way mainstream Selenium implements them: it injects a JS "atom" through
// executeScript, and we match that for wire fidelity. A desktop driver has no
// JS engine at all, so executeScript fails outright and those three commands —
// which every binding exposes as ordinary API — are dead on desktop.
//
// They do not have to be. W3C defines real HTTP endpoints for all three, and
// Appium / WinAppDriver implement them: /element/:id/displayed, /text and
// /attribute/:name. So on a native session we route to those instead of
// injecting JS. Returns "" when there is no native equivalent.
_atom_native(atom_name: string) -> string {
    if string.equals(atom_name, "isDisplayed") == 1 { return "isElementDisplayed" }
    if string.equals(atom_name, "getText") == 1 { return "getElementText" }
    if string.equals(atom_name, "getAttribute") == 1 { return "getDomAttribute" }
    return ""
}

// The attribute name out of an atom's extra-args array ("[\"href\"]" -> href).
_atom_first_arg(extra_json: string) -> string {
    arr, perr = json.parse(extra_json)
    if string.length(perr) > 0 { return "" }
    first, _f = json.array_get(arr, 0)
    if first == null { json.free(arr)  return "" }
    v, verr = json.get_string(first)
    json.free(arr)
    if string.length(verr) > 0 { return "" }
    return v
}

execute_atom(sp: ptr, atom_name: string, elem_id: string, extra_json: string) -> int {
    if sp == null { return -1 }
    s = sp as *Session
    // Desktop: use the real endpoint, not an injected script.
    if s.native == 1 {
        nat = _atom_native(atom_name)
        if string.length(nat) > 0 {
            p = json.obj()
            _pi = json.set(p, "id", json.str(elem_id))
            if string.equals(nat, "getDomAttribute") == 1 {
                _pn = json.set(p, "name", json.str(_atom_first_arg(extra_json)))
            }
            pj, _pe = json.encode(p)
            json.free(p)
            return execute(sp, nat, pj)
        }
    }
    params = atoms.atom_params(atom_name, elem_id, extra_json)
    if string.length(params) == 0 {
        s.last_status = 0
        s.last_value = ""
        s.last_error_code = error_code("invalid argument")
        s.last_error = string.concat("unknown atom: ", atom_name)
        return s.last_error_code
    }
    return execute(sp, "executeScript", params)
}

// execute_relative(sp, base_sel, filters_json) — run the relative-locators atom
// (findElementsRelative): candidates matching the base CSS selector, filtered by
// spatial relations (above/below/left/right/near) to anchor elements, nearest
// first. last_value is a JSON array of element references. filters_json is a JSON
// array of {kind, sel[, dist]}. Returns 0 / W3C error / -1 like execute().
execute_relative(sp: ptr, base_sel: string, filters_json: string) -> int {
    if sp == null { return -1 }
    params = atoms.relative_params(base_sel, filters_json)
    return execute(sp, "executeScript", params)
}

// atom_str_arg(s) — a JSON array holding one string: `["<s>"]`, s JSON-escaped.
// A binding uses this to pass e.g. getAttribute's name as the atom's extra arg.
atom_str_arg(s: string) -> string {
    j, _e = json.stringify(json.str(s))
    return string.concat("[", string.concat(j, "]"))
}

// Build a JSON object string of every param EXCEPT the path parameters and
// the injected sessionId, for use as the POST body. If nothing remains,
// returns "{}".
body_without_path_params(params: ptr, path_tmpl: string) -> string {
    out = json.obj()
    n = json.object_size(params)
    i = 0
    while i < n {
        key, val, _eerr = json.object_entry(params, i)
        keep = 1
        if key == "sessionId" {
            keep = 0
        }
        if is_path_param(path_tmpl, key) == 1 {
            keep = 0
        }
        if keep == 1 {
            // Deep-copy the value into the new object by re-parsing its
            // stringified form (values are owned by `params`).
            vs, _e = json.stringify(val)
            vcopy, _pe = json.parse(vs)
            _s = json.set(out, key, vcopy)
        }
        i = i + 1
    }
    result, _err = json.encode(out)
    json.free(out)
    return result
}

// _detect_native(s, value) — set desktop/native mode from the newSession
// response capabilities, so a binding gets desktop By-normalization without
// knowing it asked for it (the engine owns By-normalization; bindings carry no
// protocol logic).
//
// The test is deliberately asymmetric. A browser ALWAYS reports browserName in
// its returned capabilities, so an absent browserName is necessary — but it is
// not sufficient on its own, and we require a POSITIVE native signal too:
// appium:automationName, or a platformName that is a native platform. The two
// mistakes are not equally bad. Failing to detect a desktop session costs a
// caller one explicit session_set_native(sp, 1); wrongly flipping a browser
// session to native would silently break By.id/By.name for every browser user
// of every binding. So we only flip on evidence.
_detect_native(s: *Session, value: ptr) {
    caps, _cv = json.object_get(value, "capabilities")
    if caps == null { return }
    bn, _bv = json.object_get(caps, "browserName")
    if bn != null {
        bname, _bs = json.get_string(bn)
        if string.length(bname) > 0 { return }       // a browser; leave mode alone
    }
    // Positive signal 1: an Appium automation backend.
    an, _av = json.object_get(caps, "appium:automationName")
    if an == null { an, _av2 = json.object_get(caps, "automationName") }
    if an != null {
        aname, _as = json.get_string(an)
        if string.length(aname) > 0 { s.native = 1  return }
    }
    // Positive signal 2: a native platformName. "linux"/"any" are NOT in this
    // list — they are what a browser-only Grid node reports.
    pn, _pv = json.object_get(caps, "platformName")
    if pn == null { return }
    pname, _ps = json.get_string(pn)
    lower = string.to_lower(pname)
    if string.equals(lower, "windows") == 1 { s.native = 1  return }
    if string.equals(lower, "mac") == 1 { s.native = 1  return }
    if string.equals(lower, "macos") == 1 { s.native = 1  return }
    if string.equals(lower, "ios") == 1 { s.native = 1  return }
    if string.equals(lower, "android") == 1 { s.native = 1  return }
    if string.equals(lower, "tizen") == 1 { s.native = 1  return }
    if string.equals(lower, "roku") == 1 { s.native = 1  return }
}

// Decode a W3C response body: the top-level object has a `value` field. If
// `value` is an object with a string `error` field, it's a failure — set the
// decoded code + message. Otherwise `value` is the success payload, stored as
// JSON text in last_value. On a newSession success, capture the session id.
decode_response(sp: ptr, name: string, resp_body: string) -> int {
    s = sp as *Session
    parsed, perr = json.parse(resp_body)
    if perr != "" {
        s.last_error_code = error_code("unknown error")
        s.last_error = string.concat("Unable to parse response: ", resp_body)
        return s.last_error_code
    }
    value, _ve = json.object_get(parsed, "value")
    if value == null {
        // No `value` field — store the whole body and treat as success.
        s.last_value = resp_body
        json.free(parsed)
        return 0
    }
    // Is it an error envelope? value.error is a string on failure.
    if json.json_type(value) == 5 {                  // JSON_OBJECT
        errval, _ee = json.object_get(value, "error")
        if errval != null {
            if json.json_type(errval) == 3 {         // JSON_STRING (3), not ARRAY (4)
                ecode_str, _es = json.get_string(errval)
                msgval, _me = json.object_get(value, "message")
                msg = ""
                if msgval != null {
                    msg, _ms = json.get_string(msgval)
                }
                s.last_error_code = error_code(ecode_str)
                s.last_error = msg
                json.free(parsed)
                return s.last_error_code
            }
        }
    }
    // Success. Capture session id on newSession, and work out whether the
    // remote end is a browser or a native automation driver.
    if name == "newSession" {
        sidval, _si = json.object_get(value, "sessionId")
        if sidval != null {
            sid, _sis = json.get_string(sidval)
            s.session_id = sid
        }
        _detect_native(s, value)
    }
    // Stash the value payload as JSON text.
    vtext, _vt = json.stringify(value)
    s.last_value = vtext
    json.free(parsed)
    return 0
}

// Pure, offline classifier of a W3C response body: returns the decoded error
// code (0 = success / not an error envelope) for a `{"value":{"error":...}}`
// body. Shares the exact same type checks decode_response uses, so a probe can
// pin the "error string is JSON type 3, not 4" invariant that once silently
// swallowed every WebDriver error. Returns -1 if the body isn't parseable JSON.
response_error_code(resp_body: string) -> int {
    parsed, perr = json.parse(resp_body)
    if perr != "" {
        return -1
    }
    value, _ve = json.object_get(parsed, "value")
    code = 0
    if value != null {
        if json.json_type(value) == 5 {              // JSON_OBJECT
            errval, _ee = json.object_get(value, "error")
            if errval != null {
                if json.json_type(errval) == 3 {     // JSON_STRING
                    ecode_str, _es = json.get_string(errval)
                    code = error_code(ecode_str)
                }
            }
        }
    }
    json.free(parsed)
    return code
}

// ---- Command names (cmd.Name in command.js) ------------------------------
//
// These are the canonical command identifiers a binding sends. Kept as plain
// string constants so a binding can send the same spelling the JS/Python/Ruby
// bindings already use. Only the ones with a fixed W3C HTTP route live in the
// route table below. Atom-backed commands (isDisplayed, getAttribute, getText)
// have no W3C route — the engine runs them in-page via executeScript from ONE
// shared atom source; see atoms.ae + execute_atom() and docs/Atoms.md.
// (findElementsRelative / relative locators is the next atom to add.)

// ---- The W3C command -> (method, path) route table -----------------------
//
// Mirrors W3C_COMMAND_MAP in http.js. `route(name)` returns "METHOD PATH" (a
// single space-separated pair) or "" for an unknown command. Path templates
// carry :sessionId / :id / :name / :propertyName / :authenticatorId /
// :credentialId placeholders, substituted by build_path() from the command's
// JSON parameters.

route(name: string) -> string {
    return match (name) {
        // Session management
        // GET /status — the W3C readiness probe (spec 8.3). Session-free: it is how a
        // client asks whether a remote end is up and willing, before any session
        // exists. Every real driver implements it (chromedriver, geckodriver, Appium,
        // a Grid hub); the table was simply missing it, so a caller had no way to ask.
        "status" -> "GET /status"
        "newSession" -> "POST /session"
        "quit" -> "DELETE /session/:sessionId"
        // Server status
        "getStatus" -> "GET /status"
        // Timeouts
        "getTimeout" -> "GET /session/:sessionId/timeouts"
        "setTimeout" -> "POST /session/:sessionId/timeouts"
        // Navigation
        "getCurrentUrl" -> "GET /session/:sessionId/url"
        "get" -> "POST /session/:sessionId/url"
        "goBack" -> "POST /session/:sessionId/back"
        "goForward" -> "POST /session/:sessionId/forward"
        "refresh" -> "POST /session/:sessionId/refresh"
        // Page inspection
        "getPageSource" -> "GET /session/:sessionId/source"
        "getTitle" -> "GET /session/:sessionId/title"
        // Script execution
        "executeScript" -> "POST /session/:sessionId/execute/sync"
        "executeAsyncScript" -> "POST /session/:sessionId/execute/async"
        // Frame selection
        "switchToFrame" -> "POST /session/:sessionId/frame"
        "switchToFrameParent" -> "POST /session/:sessionId/frame/parent"
        // Window management
        "getCurrentWindowHandle" -> "GET /session/:sessionId/window"
        "close" -> "DELETE /session/:sessionId/window"
        "switchToWindow" -> "POST /session/:sessionId/window"
        "newWindow" -> "POST /session/:sessionId/window/new"
        "getWindowHandles" -> "GET /session/:sessionId/window/handles"
        "getWindowRect" -> "GET /session/:sessionId/window/rect"
        "setWindowRect" -> "POST /session/:sessionId/window/rect"
        "maximizeWindow" -> "POST /session/:sessionId/window/maximize"
        "minimizeWindow" -> "POST /session/:sessionId/window/minimize"
        "fullscreenWindow" -> "POST /session/:sessionId/window/fullscreen"
        // Actions
        "actions" -> "POST /session/:sessionId/actions"
        "clearActions" -> "DELETE /session/:sessionId/actions"
        "printPage" -> "POST /session/:sessionId/print"
        // Locating elements
        "getActiveElement" -> "GET /session/:sessionId/element/active"
        "findElement" -> "POST /session/:sessionId/element"
        "findElements" -> "POST /session/:sessionId/elements"
        "findChildElement" -> "POST /session/:sessionId/element/:id/element"
        "findChildElements" -> "POST /session/:sessionId/element/:id/elements"
        // Element interaction / inspection
        "getElementTagName" -> "GET /session/:sessionId/element/:id/name"
        "getDomAttribute" -> "GET /session/:sessionId/element/:id/attribute/:name"
        "getElementProperty" -> "GET /session/:sessionId/element/:id/property/:name"
        "getElementValueOfCssProperty" -> "GET /session/:sessionId/element/:id/css/:propertyName"
        "getElementRect" -> "GET /session/:sessionId/element/:id/rect"
        "clearElement" -> "POST /session/:sessionId/element/:id/clear"
        "clickElement" -> "POST /session/:sessionId/element/:id/click"
        "sendKeysToElement" -> "POST /session/:sessionId/element/:id/value"
        "getElementText" -> "GET /session/:sessionId/element/:id/text"
        "getAriaRole" -> "GET /session/:sessionId/element/:id/computedrole"
        "getAccessibleName" -> "GET /session/:sessionId/element/:id/computedlabel"
        "isElementDisplayed" -> "GET /session/:sessionId/element/:id/displayed"
        "isElementEnabled" -> "GET /session/:sessionId/element/:id/enabled"
        "isElementSelected" -> "GET /session/:sessionId/element/:id/selected"
        // Cookie management
        "getCookies" -> "GET /session/:sessionId/cookie"
        "addCookie" -> "POST /session/:sessionId/cookie"
        "deleteAllCookies" -> "DELETE /session/:sessionId/cookie"
        "getCookie" -> "GET /session/:sessionId/cookie/:name"
        "deleteCookie" -> "DELETE /session/:sessionId/cookie/:name"
        // Alert management
        "acceptAlert" -> "POST /session/:sessionId/alert/accept"
        "dismissAlert" -> "POST /session/:sessionId/alert/dismiss"
        "getAlertText" -> "GET /session/:sessionId/alert/text"
        "setAlertValue" -> "POST /session/:sessionId/alert/text"
        // Screenshots
        "screenshot" -> "GET /session/:sessionId/screenshot"
        "takeElementScreenshot" -> "GET /session/:sessionId/element/:id/screenshot"
        // Shadow root
        "getShadowRoot" -> "GET /session/:sessionId/element/:id/shadow"
        "findElementFromShadowRoot" -> "POST /session/:sessionId/shadow/:id/element"
        "findElementsFromShadowRoot" -> "POST /session/:sessionId/shadow/:id/elements"
        // Log extensions
        "getLog" -> "POST /session/:sessionId/se/log"
        "getAvailableLogTypes" -> "GET /session/:sessionId/se/log/types"
        // Server extensions
        "uploadFile" -> "POST /session/:sessionId/se/file"
        // Virtual Authenticator
        "addVirtualAuthenticator" -> "POST /session/:sessionId/webauthn/authenticator"
        "removeVirtualAuthenticator" -> "DELETE /session/:sessionId/webauthn/authenticator/:authenticatorId"
        "addCredential" -> "POST /session/:sessionId/webauthn/authenticator/:authenticatorId/credential"
        "getCredentials" -> "GET /session/:sessionId/webauthn/authenticator/:authenticatorId/credentials"
        "removeCredential" -> "DELETE /session/:sessionId/webauthn/authenticator/:authenticatorId/credentials/:credentialId"
        "removeAllCredentials" -> "DELETE /session/:sessionId/webauthn/authenticator/:authenticatorId/credentials"
        "setUserVerified" -> "POST /session/:sessionId/webauthn/authenticator/:authenticatorId/uv"
        // Downloads
        "getDownloadableFiles" -> "GET /session/:sessionId/se/files"
        "downloadFile" -> "POST /session/:sessionId/se/files"
        "deleteDownloadableFiles" -> "DELETE /session/:sessionId/se/files"
        "fireSessionEvent" -> "POST /session/:sessionId/se/event"
        // FedCM
        "cancelDialog" -> "POST /session/:sessionId/fedcm/canceldialog"
        "selectAccount" -> "POST /session/:sessionId/fedcm/selectaccount"
        "getFedCmTitle" -> "GET /session/:sessionId/fedcm/gettitle"
        "getFedCmDialogType" -> "GET /session/:sessionId/fedcm/getdialogtype"
        "setDelayEnabled" -> "POST /session/:sessionId/fedcm/setdelayenabled"
        "resetCooldown" -> "POST /session/:sessionId/fedcm/resetcooldown"
        "clickdialogbutton" -> "POST /session/:sessionId/fedcm/clickdialogbutton"
        "getAccounts" -> "GET /session/:sessionId/fedcm/accountlist"
        _ -> ""
    }
}

// ---- Path templating (buildPath in http.js) ------------------------------
//
// Replace each ":placeholder" segment of `path` with the same-named field
// from the JSON parameters object `params`. A substituted parameter is
// consumed (a binding must not also send it in the body — the JS impl deletes
// it; we simply don't re-add path params to the body).
//
// Returns the concrete path. Unknown/missing placeholders are left intact so
// the caller can surface a clear "missing parameter" server error rather than
// silently producing a wrong path.

build_path(path: string, params: ptr) -> string {
    result = path
    // Substitute the known W3C placeholders. Each is looked up in params;
    // absent ones are left as-is.
    result = subst_one(result, ":sessionId", params)
    result = subst_one(result, ":id", params)
    result = subst_one(result, ":name", params)
    result = subst_one(result, ":propertyName", params)
    result = subst_one(result, ":authenticatorId", params)
    result = subst_one(result, ":credentialId", params)
    return result
}

// Replace the first occurrence of `placeholder` in `path` with the string
// value of params[placeholder-without-colon]. No-op if the key is absent.
subst_one(path: string, placeholder: string, params: ptr) -> string {
    if string.contains(path, placeholder) == 0 {
        return path
    }
    // key is the placeholder without its leading ':'
    key = string.substring(placeholder, 1, string.length(placeholder))
    if params == null {
        return path
    }
    val, gerr = json.object_get(params, key)
    if gerr != "" {
        return path
    }
    if val == null {
        return path
    }
    strval, err = json.get_string(val)
    if err != "" {
        return path
    }
    return string.replace(path, placeholder, strval)
}

// The set of parameter keys consumed by path substitution — a binding builds
// the request body from all params EXCEPT these. Returns 1 if `key` is a path
// parameter for the given path, else 0.
is_path_param(path: string, key: string) -> int {
    placeholder = string.concat(":", key)
    return string.contains(path, placeholder)
}

// ---- W3C error-envelope decode (error.js) --------------------------------
//
// Map the W3C error string (the "error" field of a failed response's value)
// to a stable integer code the bindings translate into their own exception
// types. This keeps the string<->type table in ONE place. 0 is reserved for
// "no error / success".

error_code(w3c_error: string) -> int {
    return match (w3c_error) {
        "" -> 0
        "unknown error" -> 1
        "detached shadow root" -> 2
        "element click intercepted" -> 3
        "element not interactable" -> 4
        "element not selectable" -> 5
        "insecure certificate" -> 6
        "invalid argument" -> 7
        "invalid cookie domain" -> 8
        "invalid coordinates" -> 9
        "invalid element state" -> 10
        "invalid selector" -> 11
        "invalid session id" -> 12
        "javascript error" -> 13
        "move target out of bounds" -> 14
        "no such alert" -> 15
        "no such cookie" -> 16
        "no such element" -> 17
        "no such frame" -> 18
        "no such shadow root" -> 19
        "no such window" -> 20
        "script timeout" -> 21
        "session not created" -> 22
        "stale element reference" -> 23
        "timeout" -> 24
        "unable to set cookie" -> 25
        "unable to capture screen" -> 26
        "unexpected alert open" -> 27
        "unknown command" -> 28
        "unknown method" -> 29
        "unsupported operation" -> 30
        _ -> 1
    }
}

// ---- By locators (by.js) -------------------------------------------------
//
// Normalize a (strategy, value) locator to the W3C form the /element endpoint
// expects, returned as a JSON object string {"using": ..., "value": ...}.
// W3C has four native strategies; id/name/className are rewritten to CSS and
// tagName is passed through (drivers accept "tag name"). This is the ONE place
// the CSS-escaping rewrite lives.

by_locator(strategy: string, value: string) -> string {
    using = strategy
    v = value
    match (strategy) {
        "id" -> {
            using = "css selector"
            v = string.concat(string.concat("*[id=\"", css_escape(value)), "\"]")
        }
        "name" -> {
            using = "css selector"
            v = string.concat(string.concat("*[name=\"", css_escape(value)), "\"]")
        }
        "className" -> {
            using = "css selector"
            v = string.concat(".", css_escape(value))
        }
        "class name" -> {
            using = "css selector"
            v = string.concat(".", css_escape(value))
        }
        "css" -> {
            // "css" is a convenience ALIAS, not a W3C strategy — the spec's four
            // are css selector / link text / partial link text / xpath (tag name
            // is accepted by drivers). Passing it through unchanged put
            // using:"css" on the wire, which drivers reject with invalid
            // argument. Normalize it here, the one place By-normalization lives,
            // so every binding's short alias works. (Found via the aether
            // binding, whose By_CSS() returns "css": findElementFromShadowRoot
            // failed while By_ID() — already rewritten below — succeeded.)
            using = "css selector"
        }
        _ -> {
            // css selector / link text / partial link text / xpath / tag name
            // pass through unchanged — those ARE the wire values.
        }
    }
    obj = json.obj()
    _e1 = json.set(obj, "using", json.str(using))
    _e2 = json.set(obj, "value", json.str(v))
    out, _err = json.encode(obj)
    json.free(obj)
    return out
}

// by_locator_native(strategy, value) — By-normalization for a NATIVE automation
// driver (WinAppDriver, appium-windows-driver, appium-mac2-driver, and the
// mobile drivers). The compatibility target is Appium's extended locator set —
// what AppiumBy/MobileBy put on the wire in the existing clients — so a caller
// that knows Appium finds the strategies where it expects them.
//
// The ONE structural difference from the browser mapping: "id", "name" and
// "class name" are NOT rewritten to CSS. On a native driver they are the
// driver's own properties — the UIA AutomationId, the UIA Name, the UIA
// ClassName (android resource-id / widget class, XCUIElementType) — and a
// native driver has no CSS engine to receive a rewrite. Rewriting them is
// exactly what makes a browser client fail against a desktop driver.
//
// Friendly camelCase aliases are accepted alongside the wire values so a
// binding can expose AppiumBy-shaped names without carrying a mapping table —
// the engine owns By-normalization, bindings carry no protocol logic.
by_locator_native(strategy: string, value: string) -> string {
    using = strategy
    match (strategy) {
        // --- the strategies a browser mapping would have destroyed ----------
        "id" -> { }                        // native id, NOT *[id="..."]
        "name" -> { }                      // native Name, NOT *[name="..."]
        "class name" -> { }                // native ClassName, NOT .foo
        "className" -> { using = "class name" }
        // --- Appium's accessibility id (the single most used desktop strategy)
        "accessibilityId" -> { using = "accessibility id" }
        "accessibility id" -> { }
        // --- platform-specific strategies, wire values are already correct ---
        "androidUIAutomator" -> { using = "-android uiautomator" }
        "androidViewTag" -> { using = "-android viewtag" }
        "androidDataMatcher" -> { using = "-android datamatcher" }
        "androidViewMatcher" -> { using = "-android viewmatcher" }
        "iOSPredicateString" -> { using = "-ios predicate string" }
        "iOSClassChain" -> { using = "-ios class chain" }
        "image" -> { using = "-image" }
        "custom" -> { using = "-custom" }
        // --- the alias normalization the browser mapping also does -----------
        // A native driver will reject css selector, which is correct and
        // honest: the caller asked for CSS. We still normalize the alias so the
        // error names the real strategy rather than an invalid `using`.
        "css" -> { using = "css selector" }
        _ -> {
            // xpath, accessibility id, -ios predicate string, -android
            // uiautomator, link text, tag name, and any strategy a driver
            // invents pass through unchanged — those ARE the wire values.
        }
    }
    obj = json.obj()
    _n1 = json.set(obj, "using", json.str(using))
    _n2 = json.set(obj, "value", json.str(value))
    out, _nerr = json.encode(obj)
    json.free(obj)
    return out
}

// by_locator_for(sp, strategy, value) — the session-aware entry point, and the
// one a binding should call. Dispatches to the native mapping when the session
// is a desktop/native one and to the browser mapping otherwise, so the SAME
// caller code works against chromedriver and WinAppDriver. A null session (or a
// browser session) behaves exactly like by_locator, which is unchanged and
// stays for ABI compatibility.
by_locator_for(sp: ptr, strategy: string, value: string) -> string {
    if sp == null { return by_locator(strategy, value) }
    s = sp as *Session
    if s.native == 1 { return by_locator_native(strategy, value) }
    return by_locator(strategy, value)
}

// Minimal CSS identifier escape: prefix a leading digit and escape the
// characters CSS.escape handles that actually appear in ids/classes/names.
// (Selenium's escapeCss is the full CSS.escape; this covers the common set.)
css_escape(s: string) -> string {
    // Escape backslash and double-quote which would break the selector string.
    out = string.replace(s, "\\", "\\\\")
    out = string.replace(out, "\"", "\\\"")
    return out
}

// ---- The HTTP round-trip -------------------------------------------------
//
// A WebDriver session is: a server base URL (e.g. "http://127.0.0.1:9515")
// plus a session id (empty until newSession succeeds). `execute` builds the
// request from a command name + JSON params, sends it via std.http.client,
// and returns the response as (status, body). The embed layer decodes the
// W3C envelope from the body.

// Send `method PATH` with `body` (may be "") to `base_url`, returning the
// response body. On transport failure returns "" and sets the out-error via
// the split accessors in embed.ae — here we return a tagged string:
//   "OK <http-status> <body>"        on an HTTP response (any status)
//   "ERR <message>"                  on a transport-level failure
http_roundtrip(base_url: string, method: string, path: string, body: string, ca_file: string, insecure: int) -> string {
    url = string.concat(base_url, path)
    req = client.request(method, url)
    _h1 = client.set_header(req, "Accept", "application/json")
    _h2 = client.set_header(req, "Content-Type", "application/json; charset=utf-8")
    // TLS for an https:// remote end (native in ae 0.606+): a pinned private-CA
    // (self-hosted Grid) or insecure (self-signed dev). No-ops for http://.
    if string.length(ca_file) > 0 {
        _ca = client.set_cafile(req, ca_file)
    }
    if insecure == 1 {
        _in = client.set_insecure(req, 1)
    }
    // WebDriver servers expect a JSON body for POST even when empty ("{}").
    if method == "POST" {
        b = body
        if b == "" {
            b = "{}"
        }
        _sb = client.set_body(req, b, string.length(b), "application/json; charset=utf-8")
    }
    // A finite per-request timeout so a stalled/half-open remote end fails
    // cleanly (transport error) instead of wedging the process forever (the
    // std.http default of 0ns = block forever). WebDriver commands are
    // request/response, never streaming; 300s is generous enough for a slow page
    // load or a deliberate implicit-wait while still bounding a genuine hang.
    _to = client.set_timeout(req, 300s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" {
        return string.concat("ERR ", err)
    }
    status = client.response_status(resp)
    rbody = client.response_body(resp)
    client.response_free(resp)
    return string.concat(string.concat("OK ", string.from_int(status)), string.concat(" ", rbody))
}
