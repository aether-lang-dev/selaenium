// bidi_demux.ae — the PURE frame-routing core of the BiDi multiplexer (shape C,
// docs/WebDriver-BiDi.md). A single conceptual reader ingests each WebSocket
// frame and routes it to EITHER the id-keyed pending-reply table (command
// replies) OR a bounded event queue (unsolicited events) — the BEEP
// correlation-table model. This module is PURE: it never touches a socket, so
// its routing/queue/cancellation logic is unit-testable with fed-in frames. The
// live wiring (ws_recv → ingest, and the non-blocking poll ABI) sits on top once
// Aether exposes a non-blocking ws recv (asks/ws-client-nonblocking-recv-*).
//
// Frame classification (per the W3C BiDi JSON-RPC shape):
//   {"id":N,"result":{…}}        -> reply for command N        (id-table)
//   {"id":N,"error":"…",…}       -> error reply for command N  (id-table)
//   {"type":"event","method":…}  -> event                       (event queue)
// A reply whose id has no waiter (cancelled / unknown) is DROPPED, never
// mis-routed. The event queue is BOUNDED; on overflow the oldest event is
// dropped and a lost-events counter increments (never blocks, never unbounded).
import std.json
import std.string
import std.list
import std.map
import std.heap

// Max buffered events before the queue drops-oldest (BEEP's flow-control lesson,
// since BiDi dropped per-channel windows). Generous; a binding draining its
// event loop keeps well under it.
EVENT_QUEUE_MAX() -> int { return 1024 }

// The Demux carries TWO independent lanes over one reader/socket, so a single
// WebSocket can multiplex BiDi browser traffic AND the runner control channel
// (the "wee shell" step/inspect/continue verbs + its events) without a second
// connection. A frame's LANE is chosen by demux_ingest's classifier:
//   - untagged frames (no top-level "channel", or "channel":"bidi") -> the bidi
//     lane, EXACTLY the legacy behaviour (BiDi callers are unchanged);
//   - {"channel":"runner", ...} -> the runner lane.
// Each lane is the same correlation-table + bounded-event-queue shape. The
// legacy demux_*(dp,...) functions operate on the bidi lane (back-compat); the
// runner lane is reached via the demux_*_runner(dp,...) variants. Adding a third
// lane later is the same additive move (or generalise to a name->lane map).
struct Demux {
    // --- bidi lane (the legacy fields; unqualified funcs use these) ---
    replies: ptr       // map: id-string -> reply JSON (a completed command)
    events: ptr        // list of event JSON strings (FIFO, bounded)
    lost: int          // events dropped by the bound since last lost_count()
    pending: ptr       // map: id-string -> "1" for ids a caller is awaiting
    // --- runner lane (the control channel; demux_*_runner funcs use these) ---
    r_replies: ptr
    r_events: ptr
    r_lost: int
    r_pending: ptr
}

demux_new() -> ptr {
    d = heap.new(Demux)
    d.replies = map.new()
    d.events = list.new()
    d.lost = 0
    d.pending = map.new()
    d.r_replies = map.new()
    d.r_events = list.new()
    d.r_lost = 0
    d.r_pending = map.new()
    return d as ptr
}

demux_free(dp: ptr) {
    if dp == null { return }
    heap.free(dp)
}

// register(id) — a caller announces it will await this command id (so a reply is
// kept rather than dropped). Called at send time.
demux_register(dp: ptr, id: int) {
    if dp == null { return }
    d = dp as *Demux
    _e = map.put(d.pending, string.from_int(id), "1")
}

// ingest(frame_json) — classify one frame by LANE (a top-level "channel":
// "runner" routes to the runner lane; anything else — no channel, or
// "channel":"bidi" — to the bidi lane), then route WITHIN the lane by shape
// (id -> reply table, no-id -> bounded event queue). Returns:
//   1 routed as a reply, 2 routed as an event, 0 dropped (unknown/uncorrelated),
//   -1 unparseable. PURE — the single-reader loop calls this per frame. Adding a
//   lane never changes this signature; a binding still calls ingest once per
//   frame off the one socket.
demux_ingest(dp: ptr, frame_json: string) -> int {
    if dp == null { return -1 }
    d = dp as *Demux
    root, perr = json.parse(frame_json)
    if string.length(perr) > 0 { return -1 }

    // Lane classification: the runner lane is opt-in via an explicit channel tag.
    chv, _c = json.object_get(root, "channel")
    is_runner = 0
    if chv != null {
        ch, _cs = json.get_string(chv)
        if ch == "runner" { is_runner = 1 }
    }

    idv, _i = json.object_get(root, "id")
    if idv != null {
        id = json.get_int(idv)
        idkey = string.from_int(id)
        if is_runner == 1 {
            if map.has(d.r_pending, idkey) == 1 {
                _rr = map.put(d.r_replies, idkey, string.concat(frame_json, ""))
                return 1
            }
            return 0
        }
        // bidi lane (legacy path, unchanged).
        if map.has(d.pending, idkey) == 1 {
            _r = map.put(d.replies, idkey, string.concat(frame_json, ""))
            return 1
        }
        return 0
    }

    // No id -> an event. Enqueue on the classified lane, bounded (drop-oldest +
    // count).
    if is_runner == 1 {
        if list.size(d.r_events) >= EVENT_QUEUE_MAX() {
            list.remove(d.r_events, 0)
            d.r_lost = d.r_lost + 1
        }
        _ar = list.add(d.r_events, string.concat(frame_json, ""))
        return 2
    }
    if list.size(d.events) >= EVENT_QUEUE_MAX() {
        list.remove(d.events, 0)
        d.lost = d.lost + 1
    }
    _a = list.add(d.events, string.concat(frame_json, ""))
    return 2
}

// poll_reply(id) — the reply JSON for a command id if it has arrived (and
// consume it), else "". Returns immediately — the binding calls this after its
// own wait. A consumed reply also clears the pending mark.
demux_poll_reply(dp: ptr, id: int) -> string {
    if dp == null { return "" }
    d = dp as *Demux
    idkey = string.from_int(id)
    if map.has(d.replies, idkey) == 0 { return "" }
    r, _ = map.get(d.replies, idkey)
    out = string.concat(r, "")
    map.remove(d.replies, idkey)
    map.remove(d.pending, idkey)
    return out
}

// poll_event() — the next queued event JSON (and dequeue), or "" if none.
// Returns immediately.
demux_poll_event(dp: ptr) -> string {
    if dp == null { return "" }
    d = dp as *Demux
    if list.size(d.events) == 0 { return "" }
    e, _ = list.get(d.events, 0)
    out = string.concat(e, "")
    list.remove(d.events, 0)
    return out
}

// lost_count() — how many events the bounded queue dropped, then resets to 0.
// A binding surfaces this so a consumer knows it missed events.
demux_lost_count(dp: ptr) -> int {
    if dp == null { return 0 }
    d = dp as *Demux
    n = d.lost
    d.lost = 0
    return n
}

// cancel(id) — a waiter gave up: drop its pending mark and any buffered reply, so
// a late reply for this id is discarded by ingest rather than kept forever.
demux_cancel(dp: ptr, id: int) {
    if dp == null { return }
    d = dp as *Demux
    idkey = string.from_int(id)
    map.remove(d.pending, idkey)
    map.remove(d.replies, idkey)
}

// pending_count() / event_count() — introspection for tests.
demux_event_count(dp: ptr) -> int {
    if dp == null { return 0 }
    d = dp as *Demux
    return list.size(d.events)
}

// ---- runner lane: the same operations on the control channel ----------------
// Identical shape to the bidi-lane functions above, on the r_* tables. A runner
// front-end (REPL, iframe, editor) awaits/drains these; BiDi is untouched.

demux_register_runner(dp: ptr, id: int) {
    if dp == null { return }
    d = dp as *Demux
    _e = map.put(d.r_pending, string.from_int(id), "1")
}

demux_poll_reply_runner(dp: ptr, id: int) -> string {
    if dp == null { return "" }
    d = dp as *Demux
    idkey = string.from_int(id)
    if map.has(d.r_replies, idkey) == 0 { return "" }
    r, _ = map.get(d.r_replies, idkey)
    out = string.concat(r, "")
    map.remove(d.r_replies, idkey)
    map.remove(d.r_pending, idkey)
    return out
}

demux_poll_event_runner(dp: ptr) -> string {
    if dp == null { return "" }
    d = dp as *Demux
    if list.size(d.r_events) == 0 { return "" }
    e, _ = list.get(d.r_events, 0)
    out = string.concat(e, "")
    list.remove(d.r_events, 0)
    return out
}

demux_lost_count_runner(dp: ptr) -> int {
    if dp == null { return 0 }
    d = dp as *Demux
    n = d.r_lost
    d.r_lost = 0
    return n
}

demux_cancel_runner(dp: ptr, id: int) {
    if dp == null { return }
    d = dp as *Demux
    idkey = string.from_int(id)
    map.remove(d.r_pending, idkey)
    map.remove(d.r_replies, idkey)
}

demux_event_count_runner(dp: ptr) -> int {
    if dp == null { return 0 }
    d = dp as *Demux
    return list.size(d.r_events)
}
