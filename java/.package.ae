// Third-party-consumer PACKAGE stage for the Java binding.
//
// Builds `selenium-core.jar` as a downstream user would receive it: the
// compiled classes PLUS the freshly-built engine .so bundled INSIDE the jar as
// the resource /native/libselenium_core.so (Native.locate() extracts it to a
// temp file at load). Built with plain `javac` + `jar` (no Maven).
//
// Deps core/.build.ae for the engine .so; publishes the jar on the "jar" edge,
// which java/.example.ae consumes.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    jdir = "${root}/java"
    stage = "${jdir}/pkgout/classes"

    // 1. Compile classes into a staging dir, then drop the engine .so in as the
    //    /native/ jar resource.
    rc = os.system("cd \"${jdir}\" && rm -rf pkgout && mkdir -p \"${stage}/native\" && javac -d \"${stage}\" src/main/java/org/seleniumhq/aether/*.java && cp \"${lib}\" \"${stage}/native/libselenium_core.so\"")
    if rc != 0 {
        println("java package: compile / .so-stage FAILED")
        return 1
    }

    // 2. jar it up (classes + the bundled native/ resource).
    rc2 = os.system("cd \"${stage}\" && jar --create --file \"${jdir}/pkgout/selenium-core.jar\" .")
    if rc2 != 0 {
        println("java package: `jar` FAILED")
        return 1
    }
    rc3 = os.system("ls \"${jdir}/pkgout/selenium-core.jar\" >/dev/null 2>&1")
    if rc3 != 0 {
        println("java package: no jar produced")
        return 1
    }
    build.publish_artifact(b, "jar", "${jdir}/pkgout/selenium-core.jar")
    println("java package: built selenium-core.jar with engine .so bundled as /native/ resource")
    return 0
}
