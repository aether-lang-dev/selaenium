// Java consumer package (the jar). Builds selenium-core.jar as a downstream user
// receives it: the compiled binding classes PLUS the engine .so bundled INSIDE
// the jar as the resource /native/libselenium_core.so (Native.locate() extracts
// it to a temp file at load). java.package_jar compiles src/main/java, bundles
// the .so via native_resource, jars it, and publishes the "jar" edge for the
// consumer-install proof (java/.example.ae). Needs a JDK >= 22 (FFM); skipped by
// preflight when absent (prereq jdk:22).
import bldr
import java
import java (jar_name, native_resource, release)

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        java.package_jar() {
            jar_name("selenium-core.jar")
            release("22")
            native_resource(lib, "native/libselenium_core.so")
        }
    }
}
