// Java consumer-install proof: prove the packaged jar compiles + runs a consumer
// from a CLEAN environment for a third party. java.consumer_example copies the
// dep's jar into a bare dir, compiles ConsumerExample against ONLY the jar (no
// src/ exposure), asserts the engine .so shipped as the /native/ jar resource,
// then runs the consumer on the jar classpath with --enable-native-access and
// SELENIUM_CORE_LIB unset (only the bundled resource can satisfy the load).
// Modes: ffi/discovery/live (live self-skips). Needs a JDK >= 22 (FFM).
import bldr
import java
import java (consumer_source, consumer_main, consumer_arg, consumer_jvm_flag, asset_in_jar)

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("java/.package.ae")
        java.consumer_example() {
            consumer_source("example/ConsumerExample.java")
            consumer_main("ConsumerExample")
            asset_in_jar("native/libselenium_core.so")
            consumer_jvm_flag("--enable-native-access=ALL-UNNAMED")
            consumer_arg("ffi")
            consumer_arg("discovery")
            consumer_arg("live")
        }
    }
}
