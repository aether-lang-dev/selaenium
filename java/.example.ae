// Java consumer-install proof: prove the packaged FAT jar
// (selenium-client-standalone.jar — the "jar" artifact edge from .package.ae, its
// last package_jar) compiles + runs a consumer
// from a CLEAN environment for a third party. java.consumer_example copies the
// dep's jar into a bare dir, compiles ConsumerExample against ONLY the jar (no
// src/ exposure), asserts the engine native shipped as the arch-qualified
// /native/<os>-<arch>/ jar resource, then runs the consumer on the jar classpath
// with --enable-native-access and SELENIUM_CORE_LIB unset (only the bundled
// resource can satisfy the load — Native.locate() picks it by os+arch).
// This build runs on linux-amd64, so it asserts that arch's entry.
// Modes: ffi/discovery/live (live self-skips). Needs a JDK >= 22 (FFM).
import bldr
import java
import java (consumer_source, consumer_main, consumer_arg, consumer_jvm_flag, asset_in_jar)

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("java/.package.ae")
        java.consumer_example() {
            consumer_source("example/ConsumerExample.java")
            consumer_main("ConsumerExample")
            asset_in_jar("native/linux-amd64/libselenium_core.so")
            consumer_jvm_flag("--enable-native-access=ALL-UNNAMED")
            consumer_arg("ffi")
            consumer_arg("discovery")
            consumer_arg("live")
        }
    }
}
