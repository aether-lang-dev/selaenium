// Java binding tests (Panama FFM — java.lang.foreign, no JNI/C shim), JUnit 5.
// The loader honors SELENIUM_CORE_LIB, injected here from the engine's
// shared_lib artifact. javac_test compiles src/test/java against the binding
// classes + JUnit; junit5 runs them. jvm_args threads --enable-native-access
// (required on JDK 24+, where an unnamed FFM downcall otherwise ERRORS). FfiTest
// is the no-browser facts; LiveTest spawns its own chromedriver + in-process
// HttpServer and assumeTrue-skips when chromedriver is absent. JUnit Jupiter +
// platform-console 6.1.1 resolve from aeb's repo cache. Needs a JDK >= 22.
import bldr
import java
import java (release, source_layout, jvm_args)
import maven

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("java/.build.ae")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        dep("org.junit.jupiter:junit-jupiter:6.1.1")
        dep("org.junit.platform:junit-platform-console:6.1.1")
        java.javac_test() {
            release("22")
            source_layout("maven idiomatic")
        }
        java.junit5() {
            env("SELENIUM_CORE_LIB", lib)
            jvm_args("--enable-native-access=ALL-UNNAMED")
        }
    }
}
