// Java binding tests (Panama FFM — java.lang.foreign, no JNI/C shim). The
// loader honors SELENIUM_CORE_LIB, which we point at the shared engine artifact
// this node deps. Built with plain `javac` (no Maven); tests are JUnit-free
// main() harnesses run with `java --enable-native-access`. The live test spawns
// its own chromedriver + in-process content server and self-skips if
// chromedriver is absent. Needs a JDK >= 22 (FFM stable).
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    jdir = "${root}/java"

    // Compile the binding + tests into java/out.
    cc = os.system("cd \"${jdir}\" && rm -rf out && mkdir -p out && javac -d out src/org/seleniumhq/aether/*.java && javac -cp out -d out test/TestFfi.java test/TestLive.java")
    if cc != 0 {
        println("java tests: javac FAILED")
        return 1
    }
    na = "--enable-native-access=ALL-UNNAMED"
    rc = os.system("cd \"${jdir}\" && SELENIUM_CORE_LIB=\"${lib}\" java ${na} -cp out TestFfi")
    if rc != 0 {
        println("java tests: TestFfi FAILED")
        return 1
    }
    rc2 = os.system("cd \"${jdir}\" && SELENIUM_CORE_LIB=\"${lib}\" java ${na} -cp out TestLive")
    if rc2 != 0 {
        println("java tests: TestLive FAILED")
        return 1
    }
    println("java tests: PASSED (ffi + live+surface)")
    return 0
}
