# Pinned Aether toolchain versions for CI — the single place to bump.
#
# aeb tags are "later means later" markers, NOT semver promises; pin them so a
# CI run is reproducible. `ci/toolchain.sh` reads these; override at the shell to
# test a bump (e.g. `AETHER_REF=v0.582.0 ci/run.sh`).

# The Aether compiler (`ae`). Tag vX.Y.Z, branch, or commit SHA.
AETHER_REF=v0.581.0

# The aeb build runner. Tag v0.NNN, branch, or commit SHA.
# Pinned to the commit that fixes REQUEST 4 (a node's non-zero return now reddens
# the run — the falsely-green presubmit fix). It sits at v0.282-21-g97e189d, i.e.
# AFTER the v0.282 tag with no newer tag yet, so we pin the SHA until one is cut;
# a plain v0.282 would install an aeb WITHOUT the exit-code fix.
AEB_REF=97e189d
