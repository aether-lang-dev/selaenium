// Python consumer package (the wheel). Bundles the engine .so into the package
// tree (selenium_core/native/, where setup.py's package_data ships it) then
// builds the wheel from the hand-written setup.py via python.package_existing,
// which publishes the dist dir on the "wheel_dir" edge for the consumer-install
// proof (python/.example.ae). The .so staging is declarative (copy.file) into
// the SOURCE tree so the wheel picks it up. Skipped by preflight when python is
// absent (prereq python:3).
import bldr
import python
import copy

aeb(cap) {
    bldr.build() {
        prereq("python:3")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        // Bundle the engine .so where setup.py's package_data expects it (in the
        // source package, so it lands inside the wheel under selenium_core/native/).
        copy.file() {
            from(lib)
            to("selenium_core/native/libselenium_core.so")
        }
        python.package_existing() {
        }
    }
}
