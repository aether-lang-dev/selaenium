// Python consumer-install proof: prove the packaged wheel installs + runs from
// a CLEAN environment for a third party. python.consumer_example unpacks the
// dep's wheel into a bare site dir (no source tree, no dev deps), asserts the
// bundled engine .so shipped (selenium_core/native/*.so), then runs the consumer
// with PYTHONPATH = ONLY that site and SELENIUM_CORE_LIB unset — so only the
// bundled .so can satisfy the load. Three modes: ffi (no browser), discovery
// (driver-manager), live (real chrome, self-skips). Skipped by preflight when
// python is absent (prereq python:3).
import bldr
import python
import python (consumer_script, consumer_arg, asset_glob)

aeb(cap) {
    bldr.build() {
        prereq("python:3")
        dep("python/.package.ae")
        python.consumer_example() {
            consumer_script("example/consumer_example.py")
            asset_glob("selenium_core/native/*.so")
            consumer_arg("ffi")
            consumer_arg("discovery")
            consumer_arg("live")
        }
    }
}
