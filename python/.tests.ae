// Python binding tests (ctypes). The Fiddle-free loader honors SELENIUM_CORE_LIB,
// injected here from the engine's shared_lib artifact. pytest discovers all
// test/test_*.py: the no-browser FFI facts, plus the two live-Chrome suites
// (find/click smoke + broad surface) which pytest.skip when chromedriver is
// absent. PYTEST_DISABLE_PLUGIN_AUTOLOAD dodges the box's broken anyio plugin
// chain. Skipped cleanly by preflight when python is absent (prereq python:3).
import bldr
import python
import python (pip)
import copy

aeb(cap) {
    bldr.build() {
        prereq("python:3")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        // Stage the console page into the package so the Bridge live test
        // exercises the packaged path (_console_html prefers selenium/console.html)
        // rather than only the in-tree walk-up. Canonical source: selenium_core/.
        copy.file() {
            from("../selenium_core/console/console.html")
            to("selenium/console.html")
        }
        // pip() is a BLOCK SETTER of install(), not a node. Called at top level
        // it writes onto the graph ctx instead of install()'s block, so install()
        // never sees the dep and the venv gets only base pip — the suite then
        // fails with "No module named pytest". aeb v0.310 makes that misuse a
        // hard error; on v0.309 and earlier it is silent.
        python.install() {
            pip("pytest")
        }
        python.pytest() {
            env("SELENIUM_CORE_LIB", lib)
            env("PYTEST_DISABLE_PLUGIN_AUTOLOAD", "1")
        }
    }
}
