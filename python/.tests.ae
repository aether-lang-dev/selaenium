// Python binding tests (ctypes). The Fiddle-free loader honors SELENIUM_CORE_LIB,
// injected here from the engine's shared_lib artifact. pytest discovers all
// test/test_*.py: the no-browser FFI facts, plus the two live-Chrome suites
// (find/click smoke + broad surface) which pytest.skip when chromedriver is
// absent. PYTEST_DISABLE_PLUGIN_AUTOLOAD dodges the box's broken anyio plugin
// chain. Skipped cleanly by preflight when python is absent (prereq python:3).
import bldr
import python

aeb(cap) {
    bldr.build() {
        prereq("python:3")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        python.pip("pytest")
        python.install()
        python.pytest() {
            env("SELENIUM_CORE_LIB", lib)
            env("PYTEST_DISABLE_PLUGIN_AUTOLOAD", "1")
        }
    }
}
