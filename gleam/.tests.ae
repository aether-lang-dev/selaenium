// Gleam binding tests. Gleam consumes the SAME shared NIF the Erlang binding
// owns (selenium_nif) via @external — no second C source. This node deps the
// Erlang NIF build and runs `gleam test` with ERL_LIBS pointed at _build so the
// selenium_nif module + priv/selenium_nif.so resolve over the BEAM. Skipped by
// preflight when gleam is absent (prereq gleam); this box (catchyos) has gleam +
// the Erlang NIF, so it is live-verified here.
import bldr
import gleam

aeb(cap) {
    bldr.build() {
        prereq("gleam")
        dep("erlang/.build.ae")
        libs = dep_artifact("erlang/.build.ae", "erl_libs")
        gleam.test() {
            env("ERL_LIBS", libs)
        }
    }
}
