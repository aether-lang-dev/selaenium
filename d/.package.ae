// D consumer package. The D module is consumed in-place (dmd reads src/ + the
// staged native/.so at compile time), so packaging is just staging the engine
// .so into native/ (where a consumer links it) and publishing the module dir on
// the "package_dir" edge for the consumer-install proof (d/.example.ae).
// copy.file does the staging declaratively. Skipped by preflight when dmd is
// absent (prereq dmd).
import bldr
import copy

aeb(cap) {
    bldr.build() {
        prereq("dmd")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("native/libselenium_core.so")
        }
        // The SUT-adjacent console page is string-imported by package.d
        // (Bridge.consoleHtml via `import("console.html")`), so a consumer that
        // recompiles the module needs it on the dmd -J path. Ship it inside the
        // module (src/selenium/) so it travels with the package rather than
        // depending on the selenium_core sibling being present downstream.
        copy.file() {
            from("../selenium_core/console/console.html")
            to("src/selenium/console.html")
        }
        // The out-of-process dashboard host for the runner control server ships
        // alongside so a consumer can serve it (or point any ws://…/runner host
        // at it). Not string-imported by the binding — it's served/opened as-is.
        copy.file() {
            from("../selenium_core/console/dashboard.html")
            to("src/selenium/dashboard.html")
        }
        publish_artifact("package_dir", bldr._get(builder_context(), "source_dir"))
    }
}
