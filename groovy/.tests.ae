// Groovy binding tests. Groovy is a JVM-family binding: it consumes the ONE Java
// FFM binding's classes over Groovy/Java interop — no second FFI, no second .so
// (one Java jar backs Kotlin/Scala/Clojure/Groovy). It deps java/.build.ae for
// the compiled binding classes (on the classpath via the JVM dep artifact) and
// the engine for the .so, injected as SELENIUM_CORE_LIB. groovyc compiles the
// idiomatic wrapper; groovyc_test's run_script runs the live_test.groovy script
// directly with --enable-native-access (FFM needs it on JDK 24+). Needs a modern
// Groovy (>= 4) on a JDK >= 22 — skip_below_groovy/skip_below_jdk SKIP LOUDLY on
// an older/absent toolchain (Debian's 2.4 on JVM 17 can't read the FFM binding).
// The live test self-skips without chromedriver.
import bldr
import groovy
import groovy (source_layout, run_script, jvm_flag, skip_below_jdk, skip_below_groovy)

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("java/.build.ae")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        groovy.groovyc() {
            source_layout("maven idiomatic")
        }
        groovy.groovyc_test() {
            env("SELENIUM_CORE_LIB", lib)
            skip_below_jdk("22")
            skip_below_groovy("4")
            run_script("test/live_test.groovy")
            jvm_flag("--enable-native-access=ALL-UNNAMED")
        }
    }
}
