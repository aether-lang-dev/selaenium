// Groovy binding tests. Groovy is a JVM-family binding: it consumes the ONE Java
// FFM binding's classes over Groovy/Java interop — no second FFI, no second .so
// (one Java jar backs Kotlin/Scala/Clojure/Groovy). This node deps the engine;
// run-tests.sh compiles the Java binding classes and runs the Groovy test
// against them.
//
// It needs a MODERN Groovy (>= 4) on a JDK >= 22: the Java binding is Panama FFM
// (JDK 22+), which Debian's Groovy 2.4 (on JVM 17) can't read. run-tests.sh
// discovers one (GROOVY_HOME / sdkman / a >= 4 PATH groovy) and SKIPS LOUDLY
// otherwise. Authored on a box without a capable Groovy; verified on catchyos.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    gdir = "${root}/groovy"
    jsrc = "${root}/java/src/org/seleniumhq/aether"

    rc = os.system("bash \"${gdir}/run-tests.sh\" \"${lib}\" \"${jsrc}\" \"${gdir}\"")
    if rc != 0 {
        println("groovy tests: FAILED")
        return 1
    }
    println("groovy tests: PASSED (ffi + live+surface)")
    return 0
}
