// Lua binding tests (Lua 5.4 C extension). The extension dlopen's the engine at
// run time (not on its link line), so the engine path is threaded in via
// SELENIUM_CORE_LIB. Debian ships a 5.3 interpreter but 5.4 dev headers, so
// run-tests.sh builds a small 5.4 host (host/lua54.c) unless a real lua5.4 is on
// PATH. The live test self-skips if chromedriver is absent.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    lib = build.dep_artifact(b, "core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    ldir = "${root}/lua"

    rc = os.system("bash \"${ldir}/run-tests.sh\" \"${lib}\"")
    if rc != 0 {
        println("lua tests: FAILED")
        return 1
    }
    println("lua tests: PASSED (ffi + live+surface)")
    return 0
}
