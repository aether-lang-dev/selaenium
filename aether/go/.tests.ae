// Go binding tests. cgo links the shared engine (core/.build.ae output:
// core/native/libselenium_core.so) via selenium.go's
// `#cgo LDFLAGS: -L${SRCDIR}/../core/native ... -rpath ...`, so this deps the
// engine node and the rpath self-locates the .so at test runtime. go.mod lives
// in this dir, so go_test runs from source_dir (no pkg()). The live-Chrome test
// (live_test.go) skips cleanly if chromedriver is absent.
import build
import go

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    go.go_test(b) { }
}
