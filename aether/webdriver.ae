// aether/webdriver.ae — the native Aether WebDriver client.
//
// The one binding with NO FFI and NO C ABI: it `import selenium_core` and drives
// the engine module IN-PROCESS, so it never sees the flattened aether_sel_embed_*
// names or manual string ownership the FFI bindings must marshal through. It also
// goes further than any FFI binding can — a typed, idiomatic surface (real By,
// parsed JSON results, typed errors) and the builder-DSL beauty for session
// construction. This is the reference implementation of the whole architecture.
//
//     import webdriver
//
//     d = webdriver.chrome()                 // transparent driver mgmt, no PATH
//     wd.get(d, "http://example.com/one")
//     t = wd.title(d)                        // -> "Page One"
//     el = wd.find(d, By_ID, "go")
//     wd.click(d, el)
//     wd.quit(d)
//
// Session construction rides drivermgr (the same transparent resolve+launch the
// C ABI uses): chrome() detects/resolves/launches chromedriver and opens a W3C
// session against it, all in-process.
import selenium_core
import selenium_bidi
import driver
import browser
import drivercache
import std.json
import std.string
import std.heap
import std.file

// ---- By locator strategies (typed; no stringly-typed "css selector") ----
By_CSS() -> string { return "css" }
By_ID() -> string { return "id" }
By_NAME() -> string { return "name" }
By_CLASS() -> string { return "className" }
By_TAG() -> string { return "tag name" }
By_LINK() -> string { return "link text" }
By_PARTIAL_LINK() -> string { return "partial link text" }
By_XPATH() -> string { return "xpath" }

// A live session: the engine Session handle + the driver process handle (so quit
// both ends the browser session AND reaps the driver). "" element ids are the
// W3C element reference the engine returns.
struct WdSession {
    engine: ptr        // selenium_core Session
    drv: ptr           // drivermgr Driver (null for a Remote session)
    ws_url: string     // BiDi webSocketUrl from newSession (webSocketUrl:true), "" if none
    bidi: ptr          // selenium_bidi session, opened lazily on first bidi_* call
    next_bidi_id: int  // monotonic command-id source for BiDi (caller-supplied ids)
}

// ---- session construction (builder-DSL; transparent driver management) ----

// webdriver.chrome() { … } — resolve + launch chromedriver for the local Chrome
// (transparent: detect -> CfT -> cache/download -> launch, nothing on PATH),
// then open a W3C session. Block config forwards to the driver manager
// (version/cache/offline/timeout_ms). Returns a *Session, or null if no driver.
builder chrome(): ptr {
    dh = driver.ensure("chrome", _hint(_builder), _timeout(_builder))
    if dh == null { return null }
    url = driver.url_of(dh)
    eng = selenium_core.session_new(url)
    sess = _mk(eng, dh)
    // newSession with headless chrome caps. When there's no system Chrome but a
    // cached Chrome-for-Testing exists, point goog:chromeOptions.binary at it
    // (chromedriver otherwise looks for a system chrome that isn't there).
    bin_opt = _chrome_binary_opt()
    // Request webSocketUrl:true so a BiDi channel is available on demand; the URL
    // is captured and BiDi is opened lazily (non-BiDi users pay nothing).
    caps = "{\"capabilities\":{\"alwaysMatch\":{\"browserName\":\"chrome\",\"webSocketUrl\":true,\"goog:chromeOptions\":{${bin_opt}\"args\":[\"--headless=new\",\"--no-sandbox\",\"--disable-dev-shm-usage\"]}}}}"
    rc = selenium_core.execute(eng, "newSession", caps)
    if rc != 0 {
        quit(sess)
        return null
    }
    _capture_ws_url(sess)
    return sess
}

// webdriver.remote(url) — open a session against an already-running remote end
// (a Grid hub or a driver URL), no local driver process. Caps default to chrome.
remote(url: string) -> ptr {
    eng = selenium_core.session_new(url)
    sess = _mk(eng, null)
    caps = "{\"capabilities\":{\"alwaysMatch\":{\"browserName\":\"chrome\",\"webSocketUrl\":true}}}"
    rc = selenium_core.execute(eng, "newSession", caps)
    if rc != 0 { quit(sess); return null }
    _capture_ws_url(sess)
    return sess
}

// webdriver.quit(session) — end the browser session, close the engine handle,
// and reap the driver process. NULL-safe.
quit(sp: ptr) {
    if sp == null { return }
    s = sp as *WdSession
    if s.bidi != null {
        selenium_bidi.bidi_close(s.bidi)
        s.bidi = null
    }
    if s.engine != null {
        _r = selenium_core.execute(s.engine, "quit", "{}")
        selenium_core.session_free(s.engine)
    }
    if s.drv != null {
        driver.stop(s.drv)
    }
}

// ---- navigation ----
get(sp: ptr, url: string) { _do(sp, "get", _json1("url", url)) }
current_url(sp: ptr) -> string { return _do_str(sp, "getCurrentUrl", "{}") }
title(sp: ptr) -> string { return _do_str(sp, "getTitle", "{}") }
page_source(sp: ptr) -> string { return _do_str(sp, "getPageSource", "{}") }
back(sp: ptr) { _do(sp, "goBack", "{}") }
forward(sp: ptr) { _do(sp, "goForward", "{}") }
refresh(sp: ptr) { _do(sp, "refresh", "{}") }

// ---- elements ----

// find(session, By_*, value) -> element id ("" if not found / error). Uses the
// engine's ONE By-normalization (by_locator) — the same CSS-escape path every
// binding shares.
find(sp: ptr, by: string, value: string) -> string {
    loc = selenium_core.by_locator(by, value)
    rc = _exec(sp, "findElement", loc)
    if rc != 0 { return "" }
    val = _value(sp)
    return _element_ref(val)
}

// element operations take the element id find() returned.
element_text(sp: ptr, elem_id: string) -> string {
    return _do_str(sp, "getElementText", _elem_body(elem_id))
}
element_tag(sp: ptr, elem_id: string) -> string {
    return _do_str(sp, "getElementTagName", _elem_body(elem_id))
}
click(sp: ptr, elem_id: string) { _do(sp, "clickElement", _elem_body(elem_id)) }

// ---- script ----
execute_script(sp: ptr, script: string, args_json: string) -> string {
    body = "{\"script\":${_qjson(script)},\"args\":${args_json}}"
    rc = _exec(sp, "executeScript", body)
    if rc != 0 { return "" }
    return _value(sp)
}

// ---- cookies ----
add_cookie(sp: ptr, name: string, value: string) {
    body = "{\"cookie\":{\"name\":${_qjson(name)},\"value\":${_qjson(value)}}}"
    _do(sp, "addCookie", body)
}
get_cookie(sp: ptr, name: string) -> string {
    return _do_str(sp, "getCookie", _json1("name", name))
}
delete_cookie(sp: ptr, name: string) { _do(sp, "deleteCookie", _json1("name", name)) }
delete_all_cookies(sp: ptr) { _do(sp, "deleteAllCookies", "{}") }

// ---- windows / screenshot ----
window_handles(sp: ptr) -> string { return _do_str(sp, "getWindowHandles", "{}") }
screenshot_base64(sp: ptr) -> string { return _do_str(sp, "screenshot", "{}") }

// ---- error surface ----
last_error(sp: ptr) -> string {
    if sp == null { return "" }
    s = sp as *WdSession
    return selenium_core.last_error_of(s.engine)
}
last_error_code(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    return selenium_core.last_error_code_of(s.engine)
}

// ---- WebDriver-BiDi (event-driven, over the session's webSocketUrl) ----
//
// The bidirectional surface: subscribe to browser events (log entries, network
// activity, navigation, script realms) and receive them asynchronously, plus
// issue any BiDi command. The channel is opened lazily on first use over the
// webSocketUrl captured at newSession — so a classic (HTTP-only) script never
// pays for a WebSocket. All of this runs through the engine's shape-C demux
// (single reader → id-keyed replies + bounded event queue), so replies stay
// correlated even while events stream.
//
//   webdriver.bidi_subscribe(d, "log.entryAdded")
//   webdriver.get(d, url)
//   ev = webdriver.bidi_next_event(d, "log.entryAdded", 5000)   // async receipt
//
// bidi_available(session) — 1 if the session negotiated a webSocketUrl (chrome()
// and remote() request webSocketUrl:true), so BiDi can be used. 0 for a remote
// end that didn't grant one.
bidi_available(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    if string.length(s.ws_url) > 0 { return 1 }
    return 0
}

// bidi_subscribe(session, events_csv) — session.subscribe to a comma-separated
// list of BiDi event names (see the BidiEvent_* catalog below). Opens the BiDi
// channel on first call. Returns 1 on ack, 0 on failure/unavailable.
bidi_subscribe(sp: ptr, events_csv: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    id = _bidi_id(s)
    ack = selenium_bidi.bidi_subscribe(ch, id, events_csv, 10000)
    if string.contains(ack, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_unsubscribe(session, events_csv) — the inverse. Returns 1 on ack.
bidi_unsubscribe(sp: ptr, events_csv: string) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    if s.bidi == null { return 0 }
    id = _bidi_id(s)
    ack = selenium_bidi.bidi_unsubscribe(s.bidi, id, events_csv, 10000)
    if string.contains(ack, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_next_event(session, method, timeout_ms) — block until an event whose
// method matches arrives (having subscribed first), or timeout. Returns the
// event JSON, or "" on timeout/unavailable. The async-receipt half of BiDi.
bidi_next_event(sp: ptr, method: string, timeout_ms: int) -> string {
    if sp == null { return "" }
    s = sp as *WdSession
    if s.bidi == null { return "" }
    return selenium_bidi.bidi_wait_event(s.bidi, method, timeout_ms)
}

// bidi_command(session, method, params_json, timeout_ms) — issue any BiDi command
// and return its reply JSON ("" on failure). params_json may be "" or "{}". Lets
// a caller reach BiDi methods without a dedicated wrapper (script.evaluate,
// browsingContext.captureScreenshot, network.*, …). Opens the channel on first use.
bidi_command(sp: ptr, method: string, params_json: string, timeout_ms: int) -> string {
    ch = _ensure_bidi(sp)
    if ch == null { return "" }
    s = sp as *WdSession
    id = _bidi_id(s)
    return selenium_bidi.bidi_command(ch, id, method, params_json, timeout_ms)
}

// ---- BiDi event-name catalog (the common events, as typed helpers) ----
// Names per the W3C WebDriver-BiDi spec. Pass to bidi_subscribe (single or a
// comma-joined list) and match in bidi_next_event.
BidiEvent_LOG_ENTRY_ADDED() -> string { return "log.entryAdded" }
BidiEvent_CONTEXT_CREATED() -> string { return "browsingContext.contextCreated" }
BidiEvent_CONTEXT_DESTROYED() -> string { return "browsingContext.contextDestroyed" }
BidiEvent_NAVIGATION_STARTED() -> string { return "browsingContext.navigationStarted" }
BidiEvent_DOM_CONTENT_LOADED() -> string { return "browsingContext.domContentLoaded" }
BidiEvent_LOAD() -> string { return "browsingContext.load" }
BidiEvent_DOWNLOAD_WILL_BEGIN() -> string { return "browsingContext.downloadWillBegin" }
BidiEvent_BEFORE_REQUEST_SENT() -> string { return "network.beforeRequestSent" }
BidiEvent_RESPONSE_STARTED() -> string { return "network.responseStarted" }
BidiEvent_RESPONSE_COMPLETED() -> string { return "network.responseCompleted" }
BidiEvent_FETCH_ERROR() -> string { return "network.fetchError" }
BidiEvent_REALM_CREATED() -> string { return "script.realmCreated" }
BidiEvent_REALM_DESTROYED() -> string { return "script.realmDestroyed" }
BidiEvent_MESSAGE() -> string { return "script.message" }

// ---- internals ----

_mk(eng: ptr, drv: ptr) -> ptr {
    s = heap.new(WdSession)
    s.engine = eng
    s.drv = drv
    s.ws_url = ""
    s.bidi = null
    s.next_bidi_id = 1
    return s as ptr
}

// run a command, ignore the value (navigation/void ops).
_do(sp: ptr, name: string, body: string) {
    _r = _exec(sp, name, body)
}

// run a command, return the last_value UNWRAPPED as a string. last_value is raw
// JSON (getTitle -> "\"Page One\""), so parse + get_string to the bare value.
// A non-string JSON value (number/object) is returned as its raw JSON text.
_do_str(sp: ptr, name: string, body: string) -> string {
    rc = _exec(sp, name, body)
    if rc != 0 { return "" }
    return _unwrap(_value(sp))
}

// JSON value text -> bare string when it's a JSON string, else the raw text.
_unwrap(raw: string) -> string {
    if string.length(raw) == 0 { return "" }
    v, perr = json.parse(raw)
    if string.length(perr) > 0 { return raw }
    s, serr = json.get_string(v)
    if string.length(serr) > 0 { return raw }
    return s
}

_exec(sp: ptr, name: string, body: string) -> int {
    if sp == null { return -1 }
    s = sp as *WdSession
    return selenium_core.execute(s.engine, name, body)
}

_value(sp: ptr) -> string {
    s = sp as *WdSession
    return selenium_core.last_value_of(s.engine)
}

// ---- BiDi internals ----

// _capture_ws_url(session) — pull value.capabilities.webSocketUrl out of the
// last newSession response and stash it on the session (for lazy bidi open).
_capture_ws_url(sp: ptr) {
    if sp == null { return }
    s = sp as *WdSession
    raw = selenium_core.last_value_of(s.engine)
    root, perr = json.parse(raw)
    if string.length(perr) > 0 { return }
    caps, _c = json.object_get(root, "capabilities")
    if caps == null { return }
    wsv, _w = json.object_get(caps, "webSocketUrl")
    if wsv == null { return }
    url, _u = json.get_string(wsv)
    s.ws_url = url
}

// _ensure_bidi(session) — open the BiDi channel on first use over the captured
// webSocketUrl; return the selenium_bidi handle (null if unavailable).
_ensure_bidi(sp: ptr) -> ptr {
    if sp == null { return null }
    s = sp as *WdSession
    if s.bidi != null { return s.bidi }
    if string.length(s.ws_url) == 0 { return null }
    s.bidi = selenium_bidi.bidi_open(s.ws_url)
    return s.bidi
}

// _bidi_id(session) — a fresh monotonic BiDi command id.
_bidi_id(s: *WdSession) -> int {
    id = s.next_bidi_id
    s.next_bidi_id = id + 1
    return id
}

// {"key":"<v>"} with v JSON-escaped.
_json1(key: string, v: string) -> string {
    return "{${_qjson(key)}:${_qjson(v)}}"
}

// A JSON string literal for `s` (delegates to the engine's json for escaping).
_qjson(s: string) -> string {
    j, _e = json.stringify(json.str(s))
    return j
}

// {"id":"<elem>"} — the element-ref path param body.
_elem_body(elem_id: string) -> string {
    return _json1("id", elem_id)
}

// Pull the W3C element reference out of a findElement value payload
// ({"element-6066-11e4-a52e-4f735466cecf":"<id>"}).
_element_ref(value_json: string) -> string {
    root, perr = json.parse(value_json)
    if string.length(perr) > 0 { return "" }
    ev, _e = json.object_get(root, "element-6066-11e4-a52e-4f735466cecf")
    id, _i = json.get_string(ev)
    return id
}

// "binary":"<path>", when a Chrome binary must be named explicitly (no system
// Chrome, but a cached Chrome-for-Testing exists), else "" (system default).
_chrome_binary_opt() -> string {
    sys = browser.chrome_path()
    if string.length(sys) > 0 { return "" }
    cft = _cached_chrome()
    if string.length(cft) > 0 {
        return "\"binary\":${_qjson(cft)},"
    }
    return ""
}

// The cached Chrome-for-Testing binary: <cache>/chrome/linux64/<ver>/chrome.
// Probes the version the driver manager resolved (the cached driver's version
// dir mirrors the browser's). Empty if none.
_cached_chrome() -> string {
    root = drivercache.default_cache_root()
    // The cache lays chrome out as chrome/linux64/<version>/chrome, parallel to
    // the chromedriver dir. Reuse the driver's resolved version via the same
    // layout: try the well-known linux64 path for any present version dir.
    base = string.concat(root, "/chrome/linux64")
    // We don't list dirs here; the resolver already downloaded/《cached》 the
    // matching pair, so the driver's version == the chrome version. Derive it
    // from the resolved driver path's version segment.
    dpath = driver.resolve_driver("chrome", "")
    ver = _version_seg(dpath)
    if string.length(ver) == 0 { return "" }
    cand = string.concat(base, string.concat("/", string.concat(ver, "/chrome")))
    if file.exists(cand) == 1 { return cand }
    return ""
}

// Pull the <version> segment out of a cached driver path
// .../chromedriver/linux64/<version>/chromedriver.
_version_seg(driver_path: string) -> string {
    // second-to-last path component.
    n = string.length(driver_path)
    last = _rslash(driver_path, n)
    if last < 0 { return "" }
    prev = _rslash(driver_path, last)
    if prev < 0 { return "" }
    return string.substring(driver_path, prev + 1, last)
}

_rslash(s: string, before: int) -> int {
    i = before - 1
    while i >= 0 {
        ch = string.substring(s, i, i + 1)
        if string.equals(ch, "/") == 1 { return i }
        i = i - 1
    }
    return -1
}

_hint(cfg: ptr) -> string {
    // reserved: version/cache/offline forwarding (parallels webdriver.ae DSL).
    return ""
}

_timeout(cfg: ptr) -> int {
    return 15000
}
