// aether/webdriver.ae — the native Aether WebDriver client.
//
// The one binding with NO FFI and NO C ABI: it `import selenium_core` and drives
// the engine module IN-PROCESS, so it never sees the flattened aether_sel_embed_*
// names or manual string ownership the FFI bindings must marshal through. It also
// goes further than any FFI binding can — a typed, idiomatic surface (real By,
// parsed JSON results, typed errors) and the builder-DSL beauty for session
// construction. This is the reference implementation of the whole architecture.
//
//     import webdriver
//
//     d = webdriver.chrome()                 // transparent driver mgmt, no PATH
//     wd.get(d, "http://example.com/one")
//     t = wd.title(d)                        // -> "Page One"
//     el = wd.find(d, By_ID, "go")
//     wd.click(d, el)
//     wd.quit(d)
//
// Session construction rides drivermgr (the same transparent resolve+launch the
// C ABI uses): chrome() detects/resolves/launches chromedriver and opens a W3C
// session against it, all in-process.
import selenium_core
import selenium_bidi
import driver
import browser
import drivercache
import std.json
import std.string
import std.heap
import std.file
import std.map

// C-runtime exit, for find_or_fail's fail-loud path (a locator typo should abort
// the run, not surface as a confusing downstream symptom).
extern exit(code: int)

// ---- By locator strategies (typed; no stringly-typed "css selector") ----
By_CSS() -> string { return "css" }
By_ID() -> string { return "id" }
By_NAME() -> string { return "name" }
By_CLASS() -> string { return "className" }
By_TAG() -> string { return "tag name" }
By_LINK() -> string { return "link text" }
By_PARTIAL_LINK() -> string { return "partial link text" }
By_XPATH() -> string { return "xpath" }

// A live session: the engine Session handle + the driver process handle (so quit
// both ends the browser session AND reaps the driver). "" element ids are the
// W3C element reference the engine returns.
struct WdSession {
    engine: ptr        // selenium_core Session
    drv: ptr           // drivermgr Driver (null for a Remote session)
    ws_url: string     // BiDi webSocketUrl from newSession (webSocketUrl:true), "" if none
    bidi: ptr          // selenium_bidi session, opened lazily on first bidi_* call
    next_bidi_id: int  // monotonic command-id source for BiDi (caller-supplied ids)
}

// ---- session construction (builder-DSL; transparent driver management) ----

// webdriver.chrome() { … } — resolve + launch chromedriver for the local Chrome
// (transparent: detect -> CfT -> cache/download -> launch, nothing on PATH),
// then open a W3C session. The trailing block configures the session:
//   with_headless(0)   — run HEADED (a real window; default is headless=new)
//   with_arg("--lang=en") — append an extra goog:chromeOptions arg
// plus the driver-manager hints (with_version/with_cache/with_offline). The
// session OWNS the driver it started — quit() reaps it. Returns a *Session, or
// null if no driver.
builder chrome(): ptr {
    dh = driver.ensure("chrome", _hint(_builder), _timeout(_builder))
    if dh == null { return null }
    url = driver.url_of(dh)
    eng = selenium_core.session_new(url)
    sess = _mk(eng, dh)
    // newSession with chrome caps. When there's no system Chrome but a cached
    // Chrome-for-Testing exists, point goog:chromeOptions.binary at it
    // (chromedriver otherwise looks for a system chrome that isn't there).
    bin_opt = _chrome_binary_opt()
    // Request webSocketUrl:true so a BiDi channel is available on demand; the URL
    // is captured and BiDi is opened lazily (non-BiDi users pay nothing).
    args = _chrome_args(_builder)
    caps = "{\"capabilities\":{\"alwaysMatch\":{\"browserName\":\"chrome\",\"webSocketUrl\":true,\"goog:chromeOptions\":{${bin_opt}\"args\":${args}}}}}"
    rc = selenium_core.execute(eng, "newSession", caps)
    if rc != 0 {
        quit(sess)
        return null
    }
    _capture_ws_url(sess)
    return sess
}

// ---- chrome() block setters (called inside the chrome() { … } block) ----

// Run headed (a real, watchable window) when `on` is 0; headless (the default)
// when non-zero. Headless stays the default so CI never pops a window.
with_headless(_ctx: ptr, on: int) {
    if _ctx != null { map_put_raw(_ctx, "headless", string.from_int(on)) }
}
// Append an extra goog:chromeOptions arg (e.g. "--window-size=1280,800").
// May be called repeatedly; args accumulate.
with_arg(_ctx: ptr, arg: string) {
    if _ctx != null {
        prev = ""
        if map_has(_ctx, "extra_args") == 1 { prev = map_get_raw(_ctx, "extra_args") }
        if string.length(prev) > 0 { prev = string.concat(prev, ",") }
        map_put_raw(_ctx, "extra_args", string.concat(prev, _qjson(arg)))
    }
}

// Driver-manager block setters — pin a browser version, override the cache dir,
// force offline (cache/PATH only), or set the launch timeout. These forward to
// drivermgr via _hint/_timeout.
with_version(_ctx: ptr, v: string) { if _ctx != null { map_put_raw(_ctx, "version", v) } }
with_cache(_ctx: ptr, path: string) { if _ctx != null { map_put_raw(_ctx, "cache", path) } }
with_offline(_ctx: ptr) { if _ctx != null { map_put_raw(_ctx, "offline", "1") } }
with_timeout(_ctx: ptr, ms: int) { if _ctx != null { map_put_raw(_ctx, "timeout_ms", string.from_int(ms)) } }

// Build the goog:chromeOptions "args" JSON array from the block config. Default:
// ["--headless=new","--no-sandbox","--disable-dev-shm-usage"]. with_headless(0)
// drops --headless=new (headed); with_arg appends. The two container args stay
// (they're not about headedness).
_chrome_args(_ctx: ptr) -> string {
    headed = 0
    extra = ""
    if _ctx != null {
        if map_has(_ctx, "headless") == 1 {
            hv, _e = string.to_int(map_get_raw(_ctx, "headless"))
            if hv == 0 { headed = 1 }
        }
        if map_has(_ctx, "extra_args") == 1 { extra = map_get_raw(_ctx, "extra_args") }
    }
    parts = "\"--no-sandbox\",\"--disable-dev-shm-usage\""
    if headed == 0 { parts = string.concat("\"--headless=new\",", parts) }
    if string.length(extra) > 0 { parts = string.concat(parts, string.concat(",", extra)) }
    return string.concat("[", string.concat(parts, "]"))
}

// webdriver.remote(url) — open a session against an already-running remote end
// (a Grid hub or a driver URL), no local driver process. Caps default to chrome.
// The session owns NOTHING — quit() ends the session but reaps no process (a
// Grid hub / a driver you started elsewhere is not this session's to kill). If
// you started the driver yourself via driver.ensure and want quit() to reap it,
// use remote_owning(url, dh) instead.
remote(url: string) -> ptr {
    return _remote(url, null)
}

// webdriver.remote_owning(url, driver_handle) — like remote(), but the session
// TAKES OWNERSHIP of the given drivermgr Driver handle (from driver.ensure), so
// quit() reaps the chromedriver process too. This is the intended path for
// "run a LOCAL browser with custom caps": ensure() the driver yourself, build
// whatever caps you want, and hand the handle over so teardown is one quit()
// with no orphaned chromedriver to track.
//
//   dh = driver.ensure("chrome", "", 20000)
//   d  = webdriver.remote_owning(driver.url_of(dh), dh)   // headed, no leak
//   ... ; webdriver.quit(d)                               // reaps the driver
remote_owning(url: string, driver_handle: ptr) -> ptr {
    return _remote(url, driver_handle)
}

_remote(url: string, drv: ptr) -> ptr {
    eng = selenium_core.session_new(url)
    sess = _mk(eng, drv)
    caps = "{\"capabilities\":{\"alwaysMatch\":{\"browserName\":\"chrome\",\"webSocketUrl\":true}}}"
    rc = selenium_core.execute(eng, "newSession", caps)
    if rc != 0 { quit(sess); return null }
    _capture_ws_url(sess)
    return sess
}

// webdriver.quit(session) — end the browser session, close the engine handle,
// and reap the driver process. NULL-safe.
quit(sp: ptr) {
    if sp == null { return }
    s = sp as *WdSession
    if s.bidi != null {
        selenium_bidi.bidi_close(s.bidi)
        s.bidi = null
    }
    if s.engine != null {
        _r = selenium_core.execute(s.engine, "quit", "{}")
        selenium_core.session_free(s.engine)
    }
    if s.drv != null {
        driver.stop(s.drv)
    }
}

// ---- navigation ----
get(sp: ptr, url: string) { _do(sp, "get", _json1("url", url)) }
current_url(sp: ptr) -> string { return _do_str(sp, "getCurrentUrl", "{}") }
title(sp: ptr) -> string { return _do_str(sp, "getTitle", "{}") }
page_source(sp: ptr) -> string { return _do_str(sp, "getPageSource", "{}") }
back(sp: ptr) { _do(sp, "goBack", "{}") }
forward(sp: ptr) { _do(sp, "goForward", "{}") }
refresh(sp: ptr) { _do(sp, "refresh", "{}") }

// ---- elements ----

// find(session, By_*, value) -> element id ("" if not found / error). Uses the
// engine's ONE By-normalization (by_locator) — the same CSS-escape path every
// binding shares.
find(sp: ptr, by: string, value: string) -> string {
    loc = selenium_core.by_locator(by, value)
    rc = _exec(sp, "findElement", loc)
    if rc != 0 { return "" }
    val = _value(sp)
    return _element_ref(val)
}

// element operations take the element id find() returned.
element_text(sp: ptr, elem_id: string) -> string {
    return _do_str(sp, "getElementText", _elem_body(elem_id))
}
element_tag(sp: ptr, elem_id: string) -> string {
    return _do_str(sp, "getElementTagName", _elem_body(elem_id))
}
// Click the element. NOTE: this returns as soon as the click handler has fired
// — it does NOT wait for the page to settle. For an app that re-renders from a
// server push (Datastar/htmx/LiveView, anything SSE/WebSocket-driven), the DOM
// the next statement reads is the one from BEFORE the response arrived. Don't
// paper over it with sleep(); poll the resulting state with wait_until / a
// wait_for_* condition instead (they re-read the live DOM each attempt).
click(sp: ptr, elem_id: string) { _do(sp, "clickElement", _elem_body(elem_id)) }

// Type `text` into the element (W3C: {text, value:[chars]}). The `value` char
// array is what actually drives the keystrokes; `text` is the convenience form.
send_keys(sp: ptr, elem_id: string, text: string) {
    body = "{\"id\":${_qjson(elem_id)},\"text\":${_qjson(text)},\"value\":${_char_array(text)}}"
    _do(sp, "sendKeysToElement", body)
}

// Clear an editable element's value.
clear(sp: ptr, elem_id: string) { _do(sp, "clearElement", _elem_body(elem_id)) }

// Element state (W3C endpoints). is_enabled/is_selected return 1/0.
is_enabled(sp: ptr, elem_id: string) -> int { return _do_bool(sp, "isElementEnabled", _elem_body(elem_id)) }
is_selected(sp: ptr, elem_id: string) -> int { return _do_bool(sp, "isElementSelected", _elem_body(elem_id)) }

// The element's CSS property value (e.g. "display", "color").
css_value(sp: ptr, elem_id: string, name: string) -> string {
    return _do_str(sp, "getElementValueOfCssProperty", "{\"id\":${_qjson(elem_id)},\"name\":${_qjson(name)}}")
}

// A DOM property (getElementProperty) — the live JS property, distinct from the
// attribute (use get_attribute for the classic property-or-attribute value).
property(sp: ptr, elem_id: string, name: string) -> string {
    return _do_str(sp, "getElementProperty", "{\"id\":${_qjson(elem_id)},\"name\":${_qjson(name)}}")
}

// The element's bounding rect as JSON {"x","y","width","height"}.
element_rect(sp: ptr, elem_id: string) -> string {
    return _do_str(sp, "getElementRect", _elem_body(elem_id))
}

// A PNG screenshot of just this element, base64.
element_screenshot(sp: ptr, elem_id: string) -> string {
    return _do_str(sp, "takeElementScreenshot", _elem_body(elem_id))
}

// find_relative(session, base_css, filters_json) -> first matching element id
// ("" if none). Relative locators: candidates matching base_css filtered by
// spatial relations to anchors, nearest first. filters_json is a JSON array of
// {kind, sel[, dist]}, kind in above/below/left/right/near — e.g.
//   [{"kind":"below","sel":"#hdr"}]
find_relative(sp: ptr, base_css: string, filters_json: string) -> string {
    if sp == null { return "" }
    s = sp as *WdSession
    rc = selenium_core.execute_relative(s.engine, base_css, filters_json)
    if rc != 0 { return "" }
    return _first_element_ref(_value(sp))
}

// find_relative_count(session, base_css, filters_json) -> number of matches.
find_relative_count(sp: ptr, base_css: string, filters_json: string) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    rc = selenium_core.execute_relative(s.engine, base_css, filters_json)
    if rc != 0 { return 0 }
    return _element_array_len(_value(sp))
}

// ---- atom-backed element queries (no W3C endpoint; run via the engine's atoms) ----

// is_displayed(session, elem) -> 1 visible / 0 hidden. Runs the isDisplayed atom
// (bot.dom.isShown equivalent) in-page via the engine — the ONE shared impl.
is_displayed(sp: ptr, elem_id: string) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    rc = selenium_core.execute_atom(s.engine, "isDisplayed", elem_id, "")
    if rc != 0 { return 0 }
    if string.equals(_value(sp), "true") == 1 { return 1 }
    return 0
}

// get_attribute(session, elem, name) -> the classic property-or-attribute value
// ("" if null/absent). The atom reproduces getAttribute(name) semantics (boolean
// attrs, live properties like value/checked) rather than the raw DOM attribute.
get_attribute(sp: ptr, elem_id: string, name: string) -> string {
    if sp == null { return "" }
    s = sp as *WdSession
    rc = selenium_core.execute_atom(s.engine, "getAttribute", elem_id, selenium_core.atom_str_arg(name))
    if rc != 0 { return "" }
    return _unwrap(_value(sp))
}

// ---- script ----
execute_script(sp: ptr, script: string, args_json: string) -> string {
    body = "{\"script\":${_qjson(script)},\"args\":${args_json}}"
    rc = _exec(sp, "executeScript", body)
    if rc != 0 { return "" }
    return _value(sp)
}

// ---- cookies ----
add_cookie(sp: ptr, name: string, value: string) {
    body = "{\"cookie\":{\"name\":${_qjson(name)},\"value\":${_qjson(value)}}}"
    _do(sp, "addCookie", body)
}
get_cookie(sp: ptr, name: string) -> string {
    return _do_str(sp, "getCookie", _json1("name", name))
}
delete_cookie(sp: ptr, name: string) { _do(sp, "deleteCookie", _json1("name", name)) }
delete_all_cookies(sp: ptr) { _do(sp, "deleteAllCookies", "{}") }

// ---- windows / screenshot ----
window_handles(sp: ptr) -> string { return _do_str(sp, "getWindowHandles", "{}") }
current_window_handle(sp: ptr) -> string { return _do_str(sp, "getCurrentWindowHandle", "{}") }
screenshot_base64(sp: ptr) -> string { return _do_str(sp, "screenshot", "{}") }

// Switch focus to another window/tab by handle.
switch_to_window(sp: ptr, handle: string) { _do(sp, "switchToWindow", _json1("handle", handle)) }

// Open a new window ("tab" or "window") and return the {handle,type} JSON.
new_window(sp: ptr, kind: string) -> string { return _do_str(sp, "newWindow", _json1("type", kind)) }

// Close the current window/tab.
close_window(sp: ptr) { _do(sp, "close", "{}") }

// Window rect + sizing (W3C).
window_rect(sp: ptr) -> string { return _do_str(sp, "getWindowRect", "{}") }
set_window_rect(sp: ptr, width: int, height: int) {
    _do(sp, "setWindowRect", "{\"width\":${string.from_int(width)},\"height\":${string.from_int(height)}}")
}
maximize(sp: ptr) { _do(sp, "maximizeWindow", "{}") }
minimize(sp: ptr) { _do(sp, "minimizeWindow", "{}") }
fullscreen(sp: ptr) { _do(sp, "fullscreenWindow", "{}") }

// Print the current page to PDF (base64), W3C printPage. `options_json` is the
// print options object ("{}" for defaults).
print_pdf(sp: ptr, options_json: string) -> string { return _do_str(sp, "printPage", options_json) }

// ---- frames ----
switch_to_frame(sp: ptr, frame_id_json: string) { _do(sp, "switchToFrame", "{\"id\":${frame_id_json}}") }
switch_to_parent_frame(sp: ptr) { _do(sp, "switchToFrameParent", "{}") }
switch_to_default_content(sp: ptr) { _do(sp, "switchToFrame", "{\"id\":null}") }

// ---- alerts ----
alert_text(sp: ptr) -> string { return _do_str(sp, "getAlertText", "{}") }
accept_alert(sp: ptr) { _do(sp, "acceptAlert", "{}") }
dismiss_alert(sp: ptr) { _do(sp, "dismissAlert", "{}") }
send_alert_text(sp: ptr, text: string) { _do(sp, "setAlertValue", _json1("text", text)) }
// 1 if an alert is currently present (getAlertText succeeds), else 0.
alert_present(sp: ptr) -> int {
    rc = _exec(sp, "getAlertText", "{}")
    if rc == 0 { return 1 }
    return 0
}

// ---- explicit waits (WebDriverWait + the common ExpectedConditions) ----
//
// Each wait_* polls the condition every WAIT_POLL_MS until it holds or
// timeout_ms elapses. Element-returning waits give the element id ("" on
// timeout); boolean waits give 1 (held) / 0 (timed out). Poll cadence mirrors
// classic's 200ms default; the loop uses the engine's builtin sleep(ms) — a
// real timed wait, not a busy spin.

WAIT_POLL_MS() -> int { return 200 }

// Wait until an element matching (by,value) is present in the DOM; return its
// id, or "" on timeout. (classic until.elementLocated)
wait_for_element(sp: ptr, by: string, value: string, timeout_ms: int) -> string {
    waited = 0
    while waited <= timeout_ms {
        el = find(sp, by, value)
        if string.length(el) > 0 { return el }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return ""
}

// Wait until the element is present AND displayed; return its id or "".
// (classic until.elementIsVisible, folded with elementLocated)
wait_for_visible(sp: ptr, by: string, value: string, timeout_ms: int) -> string {
    waited = 0
    while waited <= timeout_ms {
        el = find(sp, by, value)
        if string.length(el) > 0 {
            if is_displayed(sp, el) == 1 { return el }
        }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return ""
}

// Wait until the element is present, displayed AND enabled (clickable); id or "".
wait_for_clickable(sp: ptr, by: string, value: string, timeout_ms: int) -> string {
    waited = 0
    while waited <= timeout_ms {
        el = find(sp, by, value)
        if string.length(el) > 0 {
            if is_displayed(sp, el) == 1 {
                if is_enabled(sp, el) == 1 { return el }
            }
        }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return ""
}

// Wait until NO element matches (by,value) — i.e. it's absent/removed. 1 if the
// element became absent within the timeout, else 0. (classic stalenessOf, by
// locator rather than a stale ref)
wait_until_gone(sp: ptr, by: string, value: string, timeout_ms: int) -> int {
    waited = 0
    while waited <= timeout_ms {
        el = find(sp, by, value)
        if string.length(el) == 0 { return 1 }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return 0
}

// Wait until the page title equals / contains the given string. 1/0.
wait_for_title_is(sp: ptr, want: string, timeout_ms: int) -> int {
    return _wait_str(sp, "title", want, 1, timeout_ms)
}
wait_for_title_contains(sp: ptr, substr: string, timeout_ms: int) -> int {
    return _wait_str(sp, "title", substr, 0, timeout_ms)
}
// Wait until the current URL equals / contains the given string. 1/0.
wait_for_url_is(sp: ptr, want: string, timeout_ms: int) -> int {
    return _wait_str(sp, "url", want, 1, timeout_ms)
}
wait_for_url_contains(sp: ptr, substr: string, timeout_ms: int) -> int {
    return _wait_str(sp, "url", substr, 0, timeout_ms)
}

// Wait until an element's text equals / contains the given string. 1/0.
wait_for_text_is(sp: ptr, elem_id: string, want: string, timeout_ms: int) -> int {
    waited = 0
    while waited <= timeout_ms {
        if string.equals(element_text(sp, elem_id), want) == 1 { return 1 }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return 0
}
wait_for_text_contains(sp: ptr, elem_id: string, substr: string, timeout_ms: int) -> int {
    waited = 0
    while waited <= timeout_ms {
        if string.contains(element_text(sp, elem_id), substr) == 1 { return 1 }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return 0
}

// Wait until a JavaScript alert is present. 1/0. (classic alertIsPresent)
wait_for_alert(sp: ptr, timeout_ms: int) -> int {
    waited = 0
    while waited <= timeout_ms {
        if alert_present(sp) == 1 { return 1 }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return 0
}

// wait_until(timeout_ms) { predicate } — poll a caller-supplied predicate every
// WAIT_POLL_MS until it returns 1 or the budget elapses. 1 if it held, else 0.
// This is the general escape hatch behind wait_for_*; the predicate re-reads the
// live DOM each attempt, which is exactly what an app that re-renders from a
// server push (Datastar/htmx/LiveView) needs — click returns before the page
// has settled, so poll the state, don't sleep(). Call site (the `|_| -> expr`
// form is the one that evaluates the expression as the int result):
//
//   ok = webdriver.wait_until(d, 4000) callback |_| ->
//       string.equals(webdriver.element_text(d, el), "Approved")
//
// (`sp` is accepted for symmetry / future condition helpers; the predicate
// closes over the session itself.)
wait_until(sp: ptr, timeout_ms: int, pred: fn) -> int {
    waited = 0
    while waited <= timeout_ms {
        if call(pred) == 1 { return 1 }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return 0
}

// exists(by, value) -> 1 if an element matching (by,value) is present RIGHT NOW,
// else 0. Spells the intent "I expect this to be present/absent" distinctly from
// find(), whose "" return is easy to mistake for a found-empty result. Pairs
// with the waits: use exists() for an immediate check, wait_for_element() to
// block until present.
exists(sp: ptr, by: string, value: string) -> int {
    el = find(sp, by, value)
    if string.length(el) > 0 { return 1 }
    return 0
}

// find_or_fail(by, value) — like find() but returns the element id, or aborts the
// process with a clear message when nothing matches. For tests/scripts where a
// missing element is a bug in the test (a locator typo) rather than a valid
// "not there yet" — the case where find()'s quiet "" turns a real failure into a
// confusing downstream symptom. Prefer the waits when the element may appear
// late; use this when it MUST be there already.
find_or_fail(sp: ptr, by: string, value: string) -> string {
    el = find(sp, by, value)
    if string.length(el) == 0 {
        println(string.concat("webdriver.find_or_fail: no element for ", string.concat(by, string.concat("=", value))))
        exit(1)
    }
    return el
}

// title/url equality-or-contains poll shared by the four title/url waits.
// field is "title" or "url"; exact=1 -> equals, exact=0 -> contains.
_wait_str(sp: ptr, field: string, want: string, exact: int, timeout_ms: int) -> int {
    waited = 0
    while waited <= timeout_ms {
        cur = ""
        if string.equals(field, "title") == 1 { cur = title(sp) }
        if string.equals(field, "url") == 1 { cur = current_url(sp) }
        if exact == 1 {
            if string.equals(cur, want) == 1 { return 1 }
        } else {
            if string.contains(cur, want) == 1 { return 1 }
        }
        sleep(WAIT_POLL_MS())
        waited = waited + WAIT_POLL_MS()
    }
    return 0
}

// ---- Actions (W3C input) — high-level convenience over the `actions` route ----
//
// A full fluent builder needs mutable action-chain objects; the idiomatic form
// here is composable helpers that emit + send the W3C actions payload directly.
// perform_actions() is the raw escape hatch (send any {"actions":[...]} JSON);
// the rest are the everyday gestures. All target the mouse/key virtual devices.

// Send a raw W3C actions array (the value of the top-level "actions" key).
// e.g. perform_actions(d, "[{\"type\":\"pointer\",\"id\":\"mouse\",...}]")
perform_actions(sp: ptr, actions_json: string) { _do(sp, "actions", "{\"actions\":${actions_json}}") }
release_actions(sp: ptr) { _do(sp, "clearActions", "{}") }

// Move the pointer to the centre of an element and click (a pointer action
// sequence). Same effect as click() but through the input-actions device — the
// path for hover-then-click and drag composition.
action_click(sp: ptr, elem_id: string) {
    seq = _join3(_ptr_move_origin(elem_id), _ptr_down(), _ptr_up())
    perform_actions(sp, _ptr_seq(seq))
}
// Double-click at the element centre.
action_double_click(sp: ptr, elem_id: string) {
    mv = _ptr_move_origin(elem_id)
    seq = _joinc(_joinc(_joinc(_joinc(mv, _ptr_down()), _ptr_up()), _ptr_down()), _ptr_up())
    perform_actions(sp, _ptr_seq(seq))
}
// Right-click (contextmenu) at the element centre.
action_context_click(sp: ptr, elem_id: string) {
    seq = _joinc(_joinc(_ptr_move_origin(elem_id), "{\"type\":\"pointerDown\",\"button\":2}"), "{\"type\":\"pointerUp\",\"button\":2}")
    perform_actions(sp, _ptr_seq(seq))
}
// Hover: move the pointer to the element centre (no button).
action_move_to(sp: ptr, elem_id: string) {
    perform_actions(sp, _ptr_seq(_ptr_move_origin(elem_id)))
}
// Drag `source` onto `target` (press at source, move to target, release).
action_drag_and_drop(sp: ptr, source_id: string, target_id: string) {
    seq = _joinc(_joinc(_joinc(_ptr_move_origin(source_id), _ptr_down()), _ptr_move_origin(target_id)), _ptr_up())
    perform_actions(sp, _ptr_seq(seq))
}

// ---- Select (native <select> dropdown helper) ----
//
// A <select> is driven by clicking its <option> children. These take the SELECT
// element id and drive it via executeScript over the option list — the same
// approach classic's Select uses under the hood. Return 1 on success / 0 if no
// matching option. For single-select; multi-select works too (each call toggles
// one option). select_by_visible_text matches the option's displayed text.

select_by_value(sp: ptr, select_id: string, value: string) -> int {
    return _select_option(sp, select_id, "value", value)
}
select_by_visible_text(sp: ptr, select_id: string, text: string) -> int {
    return _select_option(sp, select_id, "text", text)
}
select_by_index(sp: ptr, select_id: string, index: int) -> int {
    return _select_option(sp, select_id, "index", string.from_int(index))
}
// The currently-selected option's visible text ("" if none). execute_script
// returns the raw JSON value (a quoted string), so unwrap to the bare text.
selected_option_text(sp: ptr, select_id: string) -> string {
    js = "var s=arguments[0]; return s.options[s.selectedIndex] ? s.options[s.selectedIndex].text : '';"
    return _unwrap(execute_script(sp, js, _elem_arg(select_id)))
}

// ---- error surface ----
last_error(sp: ptr) -> string {
    if sp == null { return "" }
    s = sp as *WdSession
    return selenium_core.last_error_of(s.engine)
}
last_error_code(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    return selenium_core.last_error_code_of(s.engine)
}

// ---- WebDriver-BiDi (event-driven, over the session's webSocketUrl) ----
//
// The bidirectional surface: subscribe to browser events (log entries, network
// activity, navigation, script realms) and receive them asynchronously, plus
// issue any BiDi command. The channel is opened lazily on first use over the
// webSocketUrl captured at newSession — so a classic (HTTP-only) script never
// pays for a WebSocket. All of this runs through the engine's shape-C demux
// (single reader → id-keyed replies + bounded event queue), so replies stay
// correlated even while events stream.
//
//   webdriver.bidi_subscribe(d, "log.entryAdded")
//   webdriver.get(d, url)
//   ev = webdriver.bidi_next_event(d, "log.entryAdded", 5000)   // async receipt
//
// bidi_available(session) — 1 if the session negotiated a webSocketUrl (chrome()
// and remote() request webSocketUrl:true), so BiDi can be used. 0 for a remote
// end that didn't grant one.
bidi_available(sp: ptr) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    if string.length(s.ws_url) > 0 { return 1 }
    return 0
}

// bidi_subscribe(session, events_csv) — session.subscribe to a comma-separated
// list of BiDi event names (see the BidiEvent_* catalog below). Opens the BiDi
// channel on first call. Returns 1 on ack, 0 on failure/unavailable.
bidi_subscribe(sp: ptr, events_csv: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    id = _bidi_id(s)
    ack = selenium_bidi.bidi_subscribe(ch, id, events_csv, 10000)
    if string.contains(ack, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_unsubscribe(session, events_csv) — the inverse. Returns 1 on ack.
bidi_unsubscribe(sp: ptr, events_csv: string) -> int {
    if sp == null { return 0 }
    s = sp as *WdSession
    if s.bidi == null { return 0 }
    id = _bidi_id(s)
    ack = selenium_bidi.bidi_unsubscribe(s.bidi, id, events_csv, 10000)
    if string.contains(ack, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_next_event(session, method, timeout_ms) — block until an event whose
// method matches arrives (having subscribed first), or timeout. Returns the
// event JSON, or "" on timeout/unavailable. The async-receipt half of BiDi.
bidi_next_event(sp: ptr, method: string, timeout_ms: int) -> string {
    if sp == null { return "" }
    s = sp as *WdSession
    if s.bidi == null { return "" }
    return selenium_bidi.bidi_wait_event(s.bidi, method, timeout_ms)
}

// bidi_command(session, method, params_json, timeout_ms) — issue any BiDi command
// and return its reply JSON ("" on failure). params_json may be "" or "{}". Lets
// a caller reach BiDi methods without a dedicated wrapper (script.evaluate,
// browsingContext.captureScreenshot, network.*, …). Opens the channel on first use.
bidi_command(sp: ptr, method: string, params_json: string, timeout_ms: int) -> string {
    ch = _ensure_bidi(sp)
    if ch == null { return "" }
    s = sp as *WdSession
    id = _bidi_id(s)
    return selenium_bidi.bidi_command(ch, id, method, params_json, timeout_ms)
}

// bidi_top_context(session) — the top-level browsing context id (via
// browsingContext.getTree), or "" if unavailable. The anchor for script.evaluate
// and BiDi navigation.
bidi_top_context(sp: ptr) -> string {
    ch = _ensure_bidi(sp)
    if ch == null { return "" }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_get_tree(ch, _bidi_id(s), 10000)
    return _first_context_id(rj)
}

// bidi_evaluate(session, expression) — script.evaluate the expression in the top
// context's realm (awaiting promises) and return the raw reply JSON (result.result
// carries the BiDi-typed value). BiDi's richer alternative to execute_script.
bidi_evaluate(sp: ptr, expression: string) -> string {
    ch = _ensure_bidi(sp)
    if ch == null { return "" }
    s = sp as *WdSession
    ctx = bidi_top_context(sp)
    if string.length(ctx) == 0 { return "" }
    return selenium_bidi.bidi_script_evaluate(ch, _bidi_id(s), expression, ctx, 30000)
}

// bidi_evaluate_int(session, expression) — script.evaluate returning a JS number,
// unwrapped to an int (0 on any failure / non-number). Convenience over the raw
// reply for the common "evaluate an arithmetic expression" case.
bidi_evaluate_int(sp: ptr, expression: string) -> int {
    rj = bidi_evaluate(sp, expression)
    return _bidi_result_int(rj)
}

// ---- network interception ----

// bidi_network_intercept(session, phases_csv, url_pattern) — network.addIntercept.
// Returns the intercept id ("" on failure). Subscribe to network.beforeRequestSent
// first if you want the paused-request events. Empty url_pattern intercepts all.
bidi_network_intercept(sp: ptr, phases_csv: string, url_pattern: string) -> string {
    ch = _ensure_bidi(sp)
    if ch == null { return "" }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_network_add_intercept(ch, _bidi_id(s), phases_csv, url_pattern, 10000)
    return _bidi_intercept_id(rj)
}

// bidi_network_continue(session, request_id) — let a paused request proceed.
bidi_network_continue(sp: ptr, request_id: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_network_continue_request(ch, _bidi_id(s), request_id, 10000)
    if string.contains(rj, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_network_fail(session, request_id) — block a paused request.
bidi_network_fail(sp: ptr, request_id: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_network_fail_request(ch, _bidi_id(s), request_id, 10000)
    if string.contains(rj, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_network_mock(session, request_id, status, content_type, body) — fulfill a
// paused request with a MOCK response (network.provideResponse). Returns 1 on
// success. The request-mocking capability: serve canned content / a fake status /
// a stub API payload instead of the real network response.
bidi_network_mock(sp: ptr, request_id: string, status: int, content_type: string, body: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_network_provide_response(ch, _bidi_id(s), request_id, status, content_type, body, 10000)
    if string.contains(rj, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_network_auth(session, request_id, username, password) — answer an HTTP
// auth challenge (a paused authRequired request) with credentials. Returns 1 on
// success.
bidi_network_auth(sp: ptr, request_id: string, username: string, password: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_network_continue_with_auth(ch, _bidi_id(s), request_id, username, password, 10000)
    if string.contains(rj, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_network_set_cache(session, behavior) — "bypass" to disable the HTTP cache
// for this session, "default" to restore it. Returns 1 on success.
bidi_network_set_cache(sp: ptr, behavior: string) -> int {
    ch = _ensure_bidi(sp)
    if ch == null { return 0 }
    s = sp as *WdSession
    rj = selenium_bidi.bidi_network_set_cache_behavior(ch, _bidi_id(s), behavior, 10000)
    if string.contains(rj, "\"type\":\"success\"") == 1 { return 1 }
    return 0
}

// bidi_event_request_id(event_json) — the network.request id out of a
// network.beforeRequestSent (or other network) event: params.request.request.
bidi_event_request_id(sp: ptr, event_json: string) -> string {
    root, perr = json.parse(event_json)
    if string.length(perr) > 0 { return "" }
    params, _p = json.object_get(root, "params")
    if params == null { return "" }
    req, _r = json.object_get(params, "request")
    if req == null { return "" }
    ridv, _i = json.object_get(req, "request")
    rid, _s = json.get_string(ridv)
    return rid
}

// _bidi_intercept_id(add_intercept_reply) — result.intercept, or "".
_bidi_intercept_id(reply_json: string) -> string {
    root, perr = json.parse(reply_json)
    if string.length(perr) > 0 { return "" }
    res, _r = json.object_get(root, "result")
    if res == null { return "" }
    iv, _i = json.object_get(res, "intercept")
    iid, _s = json.get_string(iv)
    return iid
}

// _first_context_id(getTree_reply) — result.contexts[0].context, or "".
_first_context_id(reply_json: string) -> string {
    root, perr = json.parse(reply_json)
    if string.length(perr) > 0 { return "" }
    res, _r = json.object_get(root, "result")
    if res == null { return "" }
    ctxs, _c = json.object_get(res, "contexts")
    if ctxs == null { return "" }
    if json.array_size(ctxs) == 0 { return "" }
    first, _f = json.array_get(ctxs, 0)
    cidv, _ci = json.object_get(first, "context")
    cid, _cs = json.get_string(cidv)
    return cid
}

// _bidi_result_int(evaluate_reply) — result.result.value as an int (BiDi wraps a
// number as {type:"number",value:N}). 0 if absent / not a number.
_bidi_result_int(reply_json: string) -> int {
    root, perr = json.parse(reply_json)
    if string.length(perr) > 0 { return 0 }
    res, _r = json.object_get(root, "result")
    if res == null { return 0 }
    rr, _rr = json.object_get(res, "result")
    if rr == null { return 0 }
    vv, _v = json.object_get(rr, "value")
    if vv == null { return 0 }
    return json.get_int(vv)
}

// ---- BiDi event-name catalog (the common events, as typed helpers) ----
// Names per the W3C WebDriver-BiDi spec. Pass to bidi_subscribe (single or a
// comma-joined list) and match in bidi_next_event.
BidiEvent_LOG_ENTRY_ADDED() -> string { return "log.entryAdded" }
BidiEvent_CONTEXT_CREATED() -> string { return "browsingContext.contextCreated" }
BidiEvent_CONTEXT_DESTROYED() -> string { return "browsingContext.contextDestroyed" }
BidiEvent_NAVIGATION_STARTED() -> string { return "browsingContext.navigationStarted" }
BidiEvent_DOM_CONTENT_LOADED() -> string { return "browsingContext.domContentLoaded" }
BidiEvent_LOAD() -> string { return "browsingContext.load" }
BidiEvent_DOWNLOAD_WILL_BEGIN() -> string { return "browsingContext.downloadWillBegin" }
BidiEvent_BEFORE_REQUEST_SENT() -> string { return "network.beforeRequestSent" }
BidiEvent_AUTH_REQUIRED() -> string { return "network.authRequired" }
BidiEvent_RESPONSE_STARTED() -> string { return "network.responseStarted" }
BidiEvent_RESPONSE_COMPLETED() -> string { return "network.responseCompleted" }
BidiEvent_FETCH_ERROR() -> string { return "network.fetchError" }
BidiEvent_REALM_CREATED() -> string { return "script.realmCreated" }
BidiEvent_REALM_DESTROYED() -> string { return "script.realmDestroyed" }
BidiEvent_MESSAGE() -> string { return "script.message" }

// ---- internals ----

_mk(eng: ptr, drv: ptr) -> ptr {
    s = heap.new(WdSession)
    s.engine = eng
    s.drv = drv
    s.ws_url = ""
    s.bidi = null
    s.next_bidi_id = 1
    return s as ptr
}

// run a command, ignore the value (navigation/void ops).
_do(sp: ptr, name: string, body: string) {
    _r = _exec(sp, name, body)
}

// run a command, return the last_value UNWRAPPED as a string. last_value is raw
// JSON (getTitle -> "\"Page One\""), so parse + get_string to the bare value.
// A non-string JSON value (number/object) is returned as its raw JSON text.
_do_str(sp: ptr, name: string, body: string) -> string {
    rc = _exec(sp, name, body)
    if rc != 0 { return "" }
    return _unwrap(_value(sp))
}

// run a command whose value is a JSON boolean; return 1 for true, else 0.
_do_bool(sp: ptr, name: string, body: string) -> int {
    v = _do_str(sp, name, body)
    if string.equals(v, "true") == 1 { return 1 }
    return 0
}

// A JSON array of the single characters in `s` — the W3C `value` field for
// sendKeys (["h","i"]). Multi-byte handling matches the engine's string ops.
_char_array(s: string) -> string {
    n = string.length(s)
    out = "["
    i = 0
    while i < n {
        ch = string.substring(s, i, i + 1)
        if i > 0 { out = string.concat(out, ",") }
        out = string.concat(out, _qjson(ch))
        i = i + 1
    }
    return string.concat(out, "]")
}

// ---- Actions/Select internals ----

// a,b joined with a comma (Aether has no string `+`).
_joinc(a: string, b: string) -> string { return string.concat(a, string.concat(",", b)) }
_join3(a: string, b: string, c: string) -> string { return _joinc(_joinc(a, b), c) }

// Wrap a comma-separated list of pointer action objects into a one-device
// pointer (mouse) action sequence — the W3C `actions` array.
_ptr_seq(inner_actions: string) -> string {
    head = "{\"type\":\"pointer\",\"id\":\"mouse\",\"parameters\":{\"pointerType\":\"mouse\"},\"actions\":["
    return string.concat(head, string.concat(inner_actions, "]}"))
}
// pointerMove to an element's centre (origin = the element reference).
_ptr_move_origin(elem_id: string) -> string {
    origin = string.concat("{\"element-6066-11e4-a52e-4f735466cecf\":", string.concat(_qjson(elem_id), "}"))
    return string.concat("{\"type\":\"pointerMove\",\"duration\":0,\"x\":0,\"y\":0,\"origin\":", string.concat(origin, "}"))
}
_ptr_down() -> string { return "{\"type\":\"pointerDown\",\"button\":0}" }
_ptr_up() -> string { return "{\"type\":\"pointerUp\",\"button\":0}" }

// A one-element executeScript args array [{elementKey: id}] — passes an element
// reference into the script's arguments[0].
_elem_arg(elem_id: string) -> string {
    return string.concat("[{\"element-6066-11e4-a52e-4f735466cecf\":", string.concat(_qjson(elem_id), "}]"))
}

// Drive a <select> by clicking the option matching on `how` ("value"/"text"/
// "index"). Runs one executeScript that finds + selects the option and fires an
// input+change event (as classic does). Returns 1 if an option matched, else 0.
_select_option(sp: ptr, select_id: string, how: string, key: string) -> int {
    // arguments: [selectEl, how, key]
    args = string.concat("[{\"element-6066-11e4-a52e-4f735466cecf\":", _qjson(select_id))
    args = string.concat(args, "},")
    args = string.concat(args, _qjson(how))
    args = string.concat(args, ",")
    args = string.concat(args, _qjson(key))
    args = string.concat(args, "]")
    js = "var s=arguments[0],how=arguments[1],key=arguments[2],hit=false;"
    js = string.concat(js, "for(var i=0;i<s.options.length;i++){var o=s.options[i];")
    js = string.concat(js, "if((how==='value'&&o.value===key)||(how==='text'&&o.text===key)||(how==='index'&&i===parseInt(key,10))){")
    js = string.concat(js, "o.selected=true;hit=true;")
    js = string.concat(js, "s.dispatchEvent(new Event('input',{bubbles:true}));s.dispatchEvent(new Event('change',{bubbles:true}));break;}}")
    js = string.concat(js, "return hit;")
    r = execute_script(sp, js, args)
    if string.equals(r, "true") == 1 { return 1 }
    return 0
}

// JSON value text -> bare string when it's a JSON string, else the raw text.
_unwrap(raw: string) -> string {
    if string.length(raw) == 0 { return "" }
    v, perr = json.parse(raw)
    if string.length(perr) > 0 { return raw }
    s, serr = json.get_string(v)
    if string.length(serr) > 0 { return raw }
    return s
}

_exec(sp: ptr, name: string, body: string) -> int {
    if sp == null { return -1 }
    s = sp as *WdSession
    return selenium_core.execute(s.engine, name, body)
}

_value(sp: ptr) -> string {
    s = sp as *WdSession
    return selenium_core.last_value_of(s.engine)
}

// ---- BiDi internals ----

// _capture_ws_url(session) — pull value.capabilities.webSocketUrl out of the
// last newSession response and stash it on the session (for lazy bidi open).
_capture_ws_url(sp: ptr) {
    if sp == null { return }
    s = sp as *WdSession
    raw = selenium_core.last_value_of(s.engine)
    root, perr = json.parse(raw)
    if string.length(perr) > 0 { return }
    caps, _c = json.object_get(root, "capabilities")
    if caps == null { return }
    wsv, _w = json.object_get(caps, "webSocketUrl")
    if wsv == null { return }
    url, _u = json.get_string(wsv)
    s.ws_url = url
}

// _ensure_bidi(session) — open the BiDi channel on first use over the captured
// webSocketUrl; return the selenium_bidi handle (null if unavailable).
_ensure_bidi(sp: ptr) -> ptr {
    if sp == null { return null }
    s = sp as *WdSession
    if s.bidi != null { return s.bidi }
    if string.length(s.ws_url) == 0 { return null }
    s.bidi = selenium_bidi.bidi_open(s.ws_url)
    return s.bidi
}

// _bidi_id(session) — a fresh monotonic BiDi command id.
_bidi_id(s: *WdSession) -> int {
    id = s.next_bidi_id
    s.next_bidi_id = id + 1
    return id
}

// {"key":"<v>"} with v JSON-escaped.
_json1(key: string, v: string) -> string {
    return "{${_qjson(key)}:${_qjson(v)}}"
}

// A JSON string literal for `s` (delegates to the engine's json for escaping).
_qjson(s: string) -> string {
    j, _e = json.stringify(json.str(s))
    return j
}

// {"id":"<elem>"} — the element-ref path param body.
_elem_body(elem_id: string) -> string {
    return _json1("id", elem_id)
}

// Pull the W3C element reference out of a findElement value payload
// ({"element-6066-11e4-a52e-4f735466cecf":"<id>"}).
_element_ref(value_json: string) -> string {
    root, perr = json.parse(value_json)
    if string.length(perr) > 0 { return "" }
    ev, _e = json.object_get(root, "element-6066-11e4-a52e-4f735466cecf")
    id, _i = json.get_string(ev)
    return id
}

// The first element ref out of a JSON array of element refs (findElements /
// relative-locators result), or "" if the array is empty/unparseable.
_first_element_ref(value_json: string) -> string {
    arr, perr = json.parse(value_json)
    if string.length(perr) > 0 { return "" }
    if json.array_size(arr) == 0 { return "" }
    first, _f = json.array_get(arr, 0)
    fev, _e = json.object_get(first, "element-6066-11e4-a52e-4f735466cecf")
    id, _i = json.get_string(fev)
    return id
}

// The length of a JSON array value (0 if not an array / unparseable).
_element_array_len(value_json: string) -> int {
    arr, perr = json.parse(value_json)
    if string.length(perr) > 0 { return 0 }
    return json.array_size(arr)
}

// "binary":"<path>", when a Chrome binary must be named explicitly (no system
// Chrome, but a cached Chrome-for-Testing exists), else "" (system default).
_chrome_binary_opt() -> string {
    sys = browser.chrome_path()
    if string.length(sys) > 0 { return "" }
    cft = _cached_chrome()
    if string.length(cft) > 0 {
        return "\"binary\":${_qjson(cft)},"
    }
    return ""
}

// The cached Chrome-for-Testing binary: <cache>/chrome/linux64/<ver>/chrome.
// Probes the version the driver manager resolved (the cached driver's version
// dir mirrors the browser's). Empty if none.
_cached_chrome() -> string {
    root = drivercache.default_cache_root()
    // The cache lays chrome out as chrome/linux64/<version>/chrome, parallel to
    // the chromedriver dir. Reuse the driver's resolved version via the same
    // layout: try the well-known linux64 path for any present version dir.
    base = string.concat(root, "/chrome/linux64")
    // We don't list dirs here; the resolver already downloaded/《cached》 the
    // matching pair, so the driver's version == the chrome version. Derive it
    // from the resolved driver path's version segment.
    dpath = driver.resolve_driver("chrome", "")
    ver = _version_seg(dpath)
    if string.length(ver) == 0 { return "" }
    cand = string.concat(base, string.concat("/", string.concat(ver, "/chrome")))
    if file.exists(cand) == 1 { return cand }
    return ""
}

// Pull the <version> segment out of a cached driver path
// .../chromedriver/linux64/<version>/chromedriver.
_version_seg(driver_path: string) -> string {
    // second-to-last path component.
    n = string.length(driver_path)
    last = _rslash(driver_path, n)
    if last < 0 { return "" }
    prev = _rslash(driver_path, last)
    if prev < 0 { return "" }
    return string.substring(driver_path, prev + 1, last)
}

_rslash(s: string, before: int) -> int {
    i = before - 1
    while i >= 0 {
        ch = string.substring(s, i, i + 1)
        if string.equals(ch, "/") == 1 { return i }
        i = i - 1
    }
    return -1
}

// The driver-manager hint JSON built from the block config (version/cache/
// offline) — the {browserVersion,cachePath,offline} shape drivermgr's
// config.parse honors. "" when the block set none.
_hint(cfg: ptr) -> string {
    if cfg == null { return "" }
    fields = ""
    if map_has(cfg, "version") == 1 { fields = _hint_add(fields, "browserVersion", map_get_raw(cfg, "version")) }
    if map_has(cfg, "cache") == 1 { fields = _hint_add(fields, "cachePath", map_get_raw(cfg, "cache")) }
    if map_has(cfg, "offline") == 1 { fields = _hint_add(fields, "offline", "true") }
    if string.length(fields) == 0 { return "" }
    return string.concat("{", string.concat(fields, "}"))
}
_hint_add(acc: string, key: string, val: string) -> string {
    pair = string.concat(_qjson(key), string.concat(":", _qjson(val)))
    if string.length(acc) == 0 { return pair }
    return string.concat(acc, string.concat(",", pair))
}

// The driver launch/readiness timeout in ms — block override, else 15s.
_timeout(cfg: ptr) -> int {
    if cfg != null {
        if map_has(cfg, "timeout_ms") == 1 {
            t, _e = string.to_int(map_get_raw(cfg, "timeout_ms"))
            if t > 0 { return t }
        }
    }
    return 15000
}
