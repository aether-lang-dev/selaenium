// Pure-Aether engine probe — compiles core_tests/probe.ae against the LOCAL
// selenium_core module (core/selenium_core.ae) and runs it. Proves the shared
// protocol logic (route table, path templating, By normalization, error map)
// with no browser and no FFI. The live-browser end-to-end test lives in the
// per-binding suites (e.g. python/.tests.ae).
import build
import std.os

aeb(cap) {
    b = build.start()
    root = build._get(b, "root")
    bin = "${root}/target/selenium_core_probe"
    rc = os.system("cd \"${root}\" && ae build --with=net core_tests/probe.ae --lib core -o \"${bin}\"")
    if rc != 0 {
        println("core_tests: probe failed to build")
        return 1
    }
    rc2 = os.system("\"${bin}\"")
    if rc2 != 0 {
        println("core_tests: engine probe FAILED")
        return 1
    }
    println("core_tests: engine probe passed")
    return 0
}
