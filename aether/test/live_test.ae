// aether/test/live_test.ae — the live conformance case, driven by the NATIVE
// Aether client (no FFI). The showcase: because the client drives the driver
// manager IN-PROCESS (webdriver.chrome() -> transparent detect/resolve/cache-or-
// download/launch), this runs on a box with a cached OR installed driver, where
// the FFI bindings' live legs skip (they need chromedriver on PATH).
//
// Pages are served as self-contained data: URLs (no external content server —
// that in-process-server wiring is the deferred content-server decision, see
// docs/Driver-Orchestration-ABI.md). Self-skips if no chromedriver is
// resolvable.
import webdriver
import driver
import std.string

extern exit(code: int)

// returns 0 on pass, 1 on fail (main sums — no top-level mutable state).
ck(label: string, cond: int) -> int {
    if cond == 1 {
        println("  ok: ${label}")
        return 0
    }
    println("FAIL: ${label}")
    return 1
}

// A self-contained page as a data: URL (title + an #hdr element + a button).
page_one() -> string {
    return "data:text/html,<title>Page One</title><h1 id='hdr'>One</h1><button id='btn' onclick=\"document.getElementById('hdr').textContent='clicked'\">b</button><p id='gone' style='display:none'>hidden</p><a id='lnk' href='https://example.com/x'>lnk</a>"
}

main() {
    dpath = driver.resolve_driver("chrome", "")
    if string.length(dpath) == 0 {
        println("SKIPPED: no chromedriver resolvable (no cache, no PATH, offline)")
        exit(0)
    }

    d = webdriver.chrome()
    if d == null {
        println("SKIPPED: chrome() could not launch (driver resolved but no browser)")
        exit(0)
    }

    println("== native Aether client: live surface (transparent driver mgmt) ==")
    fails = 0

    webdriver.get(d, page_one())
    fails = fails + ck("title Page One", string.equals(webdriver.title(d), "Page One"))

    hdr = webdriver.find(d, webdriver.By_ID(), "hdr")
    fails = fails + ck("found #hdr", _gt0(string.length(hdr)))
    fails = fails + ck("hdr text One", string.equals(webdriver.element_text(d, hdr), "One"))

    tag = webdriver.element_tag(d, webdriver.find(d, webdriver.By_ID(), "btn"))
    fails = fails + ck("btn tag button", string.equals(string.to_lower(tag), "button"))

    // script
    r = webdriver.execute_script(d, "return 6*7;", "[]")
    fails = fails + ck("script scalar 42", string.contains(r, "42"))

    // click the button -> its onclick mutates #hdr
    webdriver.click(d, webdriver.find(d, webdriver.By_ID(), "btn"))
    fails = fails + ck("after click hdr=clicked", string.equals(webdriver.element_text(d, webdriver.find(d, webdriver.By_ID(), "hdr")), "clicked"))

    // cookies (data: URLs have no cookie origin, so just exercise the calls)
    webdriver.delete_all_cookies(d)

    // screenshot
    shot = webdriver.screenshot_base64(d)
    fails = fails + ck("screenshot non-empty", _gt0(string.length(shot)))

    // negative path: a missing element yields "" (typed no-such-element)
    fails = fails + ck("missing element -> ''", string.equals(webdriver.find(d, webdriver.By_ID(), "nope"), ""))

    // ---- atom-backed queries (isDisplayed / getAttribute), run in-page ----
    hdr2 = webdriver.find(d, webdriver.By_ID(), "hdr")
    fails = fails + ck("atom is_displayed: visible #hdr", webdriver.is_displayed(d, hdr2))
    gone = webdriver.find(d, webdriver.By_ID(), "gone")
    fails = fails + ck("atom is_displayed: hidden #gone -> false", _not(webdriver.is_displayed(d, gone)))
    lnk = webdriver.find(d, webdriver.By_ID(), "lnk")
    // getAttribute('href') returns the resolved absolute URL (property semantics).
    fails = fails + ck("atom get_attribute href",
             string.contains(webdriver.get_attribute(d, lnk, "href"), "example.com/x"))

    // relative locators: the button sits below the #hdr heading.
    rel = webdriver.find_relative(d, "button", "[{\"kind\":\"below\",\"sel\":\"#hdr\"}]")
    fails = fails + ck("relative below #hdr finds the button", _gt0(string.length(rel)))
    fails = fails + ck("relative count >= 1",
             _gt0(webdriver.find_relative_count(d, "button", "[{\"kind\":\"below\",\"sel\":\"#hdr\"}]")))

    // ---- WebDriver-BiDi: subscribe + receive an async event ----
    // chrome() negotiated webSocketUrl:true, so BiDi is available in-process.
    // Subscribe to console log entries, emit one via the classic script channel,
    // and assert the BiDi event arrives asynchronously (the bidirectional half).
    if webdriver.bidi_available(d) == 1 {
        fails = fails + ck("bidi.subscribe log.entryAdded",
                 webdriver.bidi_subscribe(d, webdriver.BidiEvent_LOG_ENTRY_ADDED()))
        webdriver.execute_script(d, "console.log('bidi-hello');", "[]")
        ev = webdriver.bidi_next_event(d, webdriver.BidiEvent_LOG_ENTRY_ADDED(), 8000)
        fails = fails + ck("bidi log.entryAdded event received (async)",
                 string.contains(ev, "log.entryAdded"))
        fails = fails + ck("bidi event carries the logged text",
                 string.contains(ev, "bidi-hello"))

        // BiDi script.evaluate — the richer alternative to executeScript: run an
        // expression in the top context's realm and get a typed result.
        ctx = webdriver.bidi_top_context(d)
        fails = fails + ck("bidi top context id", _gt0(string.length(ctx)))
        fails = fails + ck("bidi script.evaluate 6*7 -> 42",
                 webdriver.bidi_evaluate_int(d, "6*7") == 42)
        // awaitPromise: a resolved promise's value comes back unwrapped.
        fails = fails + ck("bidi script.evaluate awaits a promise",
                 webdriver.bidi_evaluate_int(d, "Promise.resolve(41+1)") == 42)

        // Network interception — observe + release a paused request. The BiDi
        // capability classic WebDriver has no equivalent for. Subscribe, add an
        // intercept at beforeRequestSent, trigger a fetch, catch the paused
        // request, and continue it.
        _sub2 = webdriver.bidi_subscribe(d, webdriver.BidiEvent_BEFORE_REQUEST_SENT())
        // Intercept ALL requests at beforeRequestSent ("" -> empty urlPatterns).
        // (A "string" URL pattern must be a full parseable URL, not a substring.)
        icid = webdriver.bidi_network_intercept(d, "beforeRequestSent", "")
        fails = fails + ck("network.addIntercept -> intercept id", _gt0(string.length(icid)))
        // fire a fetch (it'll be paused by the intercept, so we don't await it).
        webdriver.execute_script(d, "fetch('https://example.com/blocked').catch(function(){});", "[]")
        reqev = webdriver.bidi_next_event(d, webdriver.BidiEvent_BEFORE_REQUEST_SENT(), 8000)
        fails = fails + ck("network.beforeRequestSent event received",
                 string.contains(reqev, "beforeRequestSent"))
        rid = webdriver.bidi_event_request_id(d, reqev)
        fails = fails + ck("intercepted request has a request id", _gt0(string.length(rid)))
        fails = fails + ck("network.continueRequest releases it",
                 webdriver.bidi_network_continue(d, rid))
    } else {
        println("  (bidi unavailable — remote end granted no webSocketUrl; skipping BiDi checks)")
    }

    webdriver.quit(d)

    if fails == 0 {
        println("PASS: native Aether client live surface green")
        exit(0)
    }
    println("FAILED: ${string.from_int(fails)} check(s)")
    exit(1)
}

_gt0(n: int) -> int { if n > 0 { return 1 } return 0 }
_not(n: int) -> int { if n == 0 { return 1 } return 0 }
