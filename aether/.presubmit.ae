// Aggregate target set: everything that must be green before pushing the
// Aether Selenium core. A named set is just build.dep() edges (see aeb LLM.md).
import build

aeb(cap) {
    b = build.start()
    build.dep(b, "core/.build.ae")
    build.dep(b, "core_tests/.tests.ae")
    build.dep(b, "python/.tests.ae")
    build.dep(b, "go/.tests.ae")
    build.dep(b, "ruby/.tests.ae")
    build.dep(b, "javascript/.tests.ae")
    build.dep(b, "java/.tests.ae")
    build.dep(b, "dotnet/.tests.ae")
    build.dep(b, "rust/.tests.ae")
    build.dep(b, "dart/.tests.ae")
    // BEAM family: Erlang owns the shared NIF; Elixir + Gleam ride the SAME
    // compiled NIF. Erlang is live-verified here; gleam/elixir skip green when
    // their compiler is absent (verified on a box that has them).
    build.dep(b, "erlang/.tests.ae")
    build.dep(b, "gleam/.tests.ae")
    build.dep(b, "elixir/.tests.ae")
    build.dep(b, "nim/.tests.ae")
    build.dep(b, "zig/.tests.ae")
    build.dep(b, "lua/.tests.ae")
    // JVM family: Kotlin + Clojure consume the ONE Java FFM jar over JVM interop
    // (no second FFI). They need a JVM-24-capable toolchain: Kotlin >= 1.9 (a
    // modern kotlinc, not Debian's 1.3) and clojure; each skips green otherwise.
    build.dep(b, "kotlin/.tests.ae")
    build.dep(b, "clojure/.tests.ae")
    build.dep(b, "groovy/.tests.ae")
    // Haskell (foreign import ccall, link-time). Authored here; skips green
    // without GHC (verified on a box with GHC).
    build.dep(b, "haskell/.tests.ae")
    // Consumer-install proofs: the packaged wheel / Go module / gem / npm
    // tarball / jar / nupkg / crate / pub package standing alone with the .so.
    build.dep(b, "python/.example.ae")
    build.dep(b, "go/.example.ae")
    build.dep(b, "ruby/.example.ae")
    build.dep(b, "javascript/.example.ae")
    build.dep(b, "java/.example.ae")
    build.dep(b, "dotnet/.example.ae")
    build.dep(b, "rust/.example.ae")
    build.dep(b, "dart/.example.ae")
    build.dep(b, "nim/.example.ae")
    build.dep(b, "zig/.example.ae")
    build.dep(b, "lua/.example.ae")
    return 0
}
