// xunit.nupkg.ae — xUnit test framework + runner + test SDK, plus Shouldly.
//
// upstream: https://github.com/xunit/xunit , https://github.com/shouldly/shouldly
// versions: xunit 2.9.3, xunit.runner.visualstudio 3.1.1,
//           Microsoft.NET.Test.Sdk 17.14.0, Shouldly 4.3.0
// license:  Apache-2.0 (xunit), BSD-3-Clause (Shouldly)
//
// Bundles the packages a `dotnet test` xUnit project needs. A test node deps
// this single file rather than listing all four coords individually; the coords
// are injected into the consumer's generated .csproj as PackageReferences.
import bldr
import dotnet

main() {
    bldr.build() {
        dotnet.nuget_registry("xunit~2.9.3")
        dotnet.nuget_registry("xunit.runner.visualstudio~3.1.1")
        dotnet.nuget_registry("Microsoft.NET.Test.Sdk~17.14.0")
        dotnet.nuget_registry("Shouldly~4.3.0")
        // Runtime conditional skip ([SkippableFact] + Skip.If) — xUnit 2.x has
        // no Assert.Skip; a live test skips (not passes) when a driver is absent.
        dotnet.nuget_registry("Xunit.SkippableFact~1.5.23")
    }
}
