// Elixir binding tests. Elixir consumes the SAME shared NIF the Erlang binding
// owns (:selenium_nif) via defdelegate — no second C source. This node deps the
// Erlang NIF build; mix does NOT fold ERL_LIBS in, so the test helper puts the
// NIF ebin on the code path via SELENIUM_NIF_EBIN (Code.append_path), and
// ERL_LIBS points at _build so the NIF app resolves. elixir.test runs `mix
// test`. Skipped by preflight when elixir is absent (prereq elixir); this box
// (catchyos) has elixir + the Erlang NIF, so it is live-verified here.
import bldr
import elixir

aeb(cap) {
    bldr.build() {
        prereq("elixir")
        dep("erlang/.build.ae")
        libs = dep_artifact("erlang/.build.ae", "erl_libs")
        ebin = dep_artifact("erlang/.build.ae", "nif_ebin")
        elixir.test() {
            env("ERL_LIBS", libs)
            env("SELENIUM_NIF_EBIN", ebin)
        }
    }
}
