// Zig binding tests (@extern + link-time, Zig 0.16). The engine .so is LINKED at
// build time via build.zig, which searches ../selenium_core/native/ (+ rpath) —
// exactly where the engine node's copy.file() stages the .so — so no per-binding
// staging is needed, just a dep on the engine. zig.test runs `zig build test`
// (the FFI unit tests). Skipped by preflight when zig is absent (prereq zig).
//
// The live-surface leg previously used an external run-live.sh (python content
// server + chromedriver, passed via SEL_* env) because Zig 0.16's std.net was
// mid-rework. With the engine's driver-orchestration ABI now shipped
// (sel_embed_ensure_driver, docs/Driver-Orchestration-ABI.md), that leg will
// self-orchestrate in-process like the other bindings — a focused follow-up.
// The FFI units are the live-verified surface here.
import bldr
import zig

aeb(cap) {
    bldr.build() {
        prereq("zig")
        dep("selenium_core/.build.ae")
        zig.test() {
        }
    }
}
