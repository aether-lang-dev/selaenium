// Zig consumer-install proof: prove the packaged package drives the engine from
// a CLEAN environment for a third party. zig.consumer_example stages the package
// (src/ + example/ + build.zig[.zon] + native/.so — no core/) as zig-pkg, builds
// it (`zig build`, pre_cmd), asserts the .so shipped, then runs the example
// binary with SEL_MODE=<mode> (mode_env) and SELENIUM_CORE_LIB unset. Modes:
// ffi/live. Skipped by preflight when zig is absent (prereq zig).
import bldr
import zig
import zig (stage, stage_dir, run_in, consumer_run_cmd, run_arg, pre_cmd, mode_env, assert_file)

aeb(cap) {
    bldr.build() {
        prereq("zig")
        dep("zig/.package.ae")
        zig.consumer_example() {
            stage_dir("src", "zig-pkg/src", "")
            stage_dir("example", "zig-pkg/example", "")
            stage("build.zig", "zig-pkg/build.zig")
            stage("build.zig.zon", "zig-pkg/build.zig.zon")
            stage("native/libselenium_core.so", "zig-pkg/native/libselenium_core.so")
            // build.zig also searches ../selenium_core/native (the monorepo
            // layout) — stage the .so there too so the clean-stage build links.
            stage("native/libselenium_core.so", "selenium_core/native/libselenium_core.so")
            assert_file("zig-pkg/native/libselenium_core.so")
            run_in("zig-pkg")
            pre_cmd("zig build")
            consumer_run_cmd("./zig-out/bin/selenium-example")
            mode_env("SEL_MODE")
            run_arg("ffi")
            run_arg("live")
        }
    }
}
