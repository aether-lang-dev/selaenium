// PHP binding tests (ext-ffi, PHPUnit). The FFI binding loads
// libselenium_core.so via FFI::cdef; the loader honors SELENIUM_CORE_LIB,
// injected here from the engine's shared_lib artifact. ext-ffi ships in the php
// package but is off by default, so ini("ffi.enable","1") passes `-d
// ffi.enable=1` (plus `-d extension=ffi`, since ext-ffi is a shared module on
// modern php builds) to the phpunit-phar runner. FfiTest is the no-browser facts;
// LiveTest spawns its own content server + chromedriver and markTestSkipped()s
// when chromedriver is absent. The phar is fetched once if missing. Skipped by
// preflight when php is absent (prereq php).
import bldr
import php

aeb(cap) {
    bldr.build() {
        prereq("php")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        php.test() {
            env("SELENIUM_CORE_LIB", lib)
            phpunit_phar_url("https://phar.phpunit.de/phpunit-12.phar")
            ini("extension", "ffi")
            ini("ffi.enable", "1")
            config("phpunit.xml")
        }
    }
}
