# selaenium ignores.
#
# This repo is a ground-up reimplementation, not a fork of mainstream Selenium's
# tree, so the ~150 inherited rules for cpp/iedriver, java/client, py/, maven/,
# third_party/, bazel-* and friends were archaeology: they matched nothing and
# only made it hard to see what is genuinely ignored. Removed. What is left is
# either live, or protects a contributor on another OS/toolchain.

# ===== OS / editor =====
.DS_Store
*~
.*.swp
*.iws
# .idea/ IS tracked here (project config is shared); ignore only the churn.
.idea/workspace.xml
.idea/shelf/
.vscode/

# ===== Secrets — never commit =====
.env
.env.local
.credentials.dat
*.crt
*.key

# ===== Contributor-local customization (see AGENTS.md) =====
**/.local/*
!/.local/README.md

# ===== AI agent local state =====
/.claude
/.cursor
/.continue
/.cline
/.windsurf
/.zencoder
AGENTS.local.md
CLAUDE.local.md
GEMINI.local.md
/.cursorignore
/.cursorrules
/.windsurfrules
/.continuerc.json
*_cline_transcript.json
.copilot-chat-history.json

# ===== Leftovers from the pre-rewrite checkout =====
# rb/ (176 files) and common/ carry ZERO tracked files — generated devtools
# bindings and a stale build dir left behind by the original tree. Ignored only
# so they do not spam `git status`; both are safe to delete outright, at which
# point these two lines go too.
/rb/
/common/

# ===== Aether port (aeb build outputs + bindings) =====
# aeb build outputs
/target/
/.aeb/

# Engine artifact (built by selenium_core/.build.ae; also staged into bindings)
/selenium_core/native/*.so
/selenium_core/native/*.dylib
/selenium_core/native/*.dll

# Bindings' bundled engine copies (staged by .package.ae)
/python/selenium/native/
/go/native/
/ruby/lib/selenium/native/

# console.html is staged into the go module by go/.tests.ae + go/.package.ae from
# the canonical selenium_core/console/; the in-tree copy is a build artifact
# (//go:embed needs it next to the source at compile time).
/go/console.html

# Ruby packaging
/ruby/pkg/
/ruby/.bundle/
/ruby/Gemfile.lock

# JavaScript
/javascript/native/
/javascript/node_modules/
/javascript/pkgout/
/javascript/package-lock.json

# Java
/java/native/
/java/out/
/java/pkgout/

# .NET
/dotnet/**/bin/
/dotnet/**/obj/
/dotnet/SeleniumCore/native/
# F# is a CLR-family binding: dotnet builds into fsharp/bin + fsharp/obj and the
# test node stages the engine .so into fsharp/native (copy.file).
/fsharp/bin/
/fsharp/obj/
/fsharp/native/
/dotnet/SeleniumCore/nupkg/

# Rust
/rust/native/
/rust/target/
/rust/Cargo.lock
/rust/example/target/
/rust/example/Cargo.lock

# Dart
/dart/native/
/dart/.dart_tool/
/dart/pubspec.lock
/dart/example/.dart_tool/
/dart/example/pubspec.lock

# D
/d/native/
/d/*.o
/d/tests/*.o
# console.html + dashboard.html are staged into the module by d/.package.ae from
# the canonical selenium_core/console/; the in-tree copies are build artifacts.
/d/src/selenium/console.html
/d/src/selenium/dashboard.html

# Nim
/nim/native/
/nim/nimcache/
/nim/tests/tffi
/nim/tests/tlive
/nim/example/consumer

# Zig
/zig/native/
/zig/.zig-cache/
/zig/zig-out/

# Lua
/lua/native/
/lua/selenium_core_native.so
/lua/lua54

# JVM family (Kotlin/Clojure/Groovy consume the Java jar; compiled output only)
/kotlin/out/
/kotlin/jout/
/clojure/jout/
/groovy/jout/
/groovy/gout/

# Haskell
/haskell/native/
/haskell/dist-newstyle/

# BEAM family (Erlang owns the shared NIF; Elixir/Gleam ride it)
/erlang/_build/
/erlang/erl_crash.dump
/gleam/build/
/gleam/manifest.toml
/elixir/_build/
/elixir/deps/

# Python packaging + caches
/python/dist/
/python/build/
/python/*.egg-info/
# console.html staged into the package by python/.tests.ae + .package.ae from the
# canonical selenium_core/console/; the in-tree copy is a build artifact (Bridge
# reads it at runtime).
/python/selenium/console.html
__pycache__/
*.pyc
.pytest_cache/

# PHP
/php/native/
/php/phpunit.phar
/php/.phpunit.cache/

# Swift
/swift/native/
/swift/.build/

# Crystal
/crystal/native/
/crystal/lib/
# Ignore compiled binaries in crystal/bin/ but keep the committed build wrapper.
# (Can't re-include a file under an ignored DIR, so ignore the contents, not the
# dir, then negate the one tracked script.)
/crystal/bin/*
!/crystal/bin/crystal-build

# Julia
/julia/native/
/julia/Manifest.toml

# Release build outputs
/release/dist/

# C client
/c/target/
/c/*.o

# C++ client
/cpp/target/
/cpp/*.o

# aeb per-binding build dirs
/java/target/
/erlang/target/
