// Nim binding tests (importc + link-time). The engine .so is LINKED at build
// time via src/selenium_core.nim's {.passL.}, which searches ../../selenium_core
// /native (+ rpath) — exactly where the engine node's copy.file() stages the
// .so — so no per-binding staging is needed, just a dep on the engine. nim.test
// compiles-and-runs each test file with `nim c -r`; tffi is the no-browser FFI
// facts, tlive the live-Chrome smoke+surface (needs --threads:on) which
// self-skips when chromedriver is absent. Skipped by preflight when nim is
// absent (prereq nim).
import bldr
import nim
import nim (test_file, nim_flag)

aeb(cap) {
    bldr.build() {
        prereq("nim")
        dep("selenium_core/.build.ae")
        nim.test() {
            nim_flag("--hints:off")
            nim_flag("--threads:on")
            nim_flag("--path:src")
            test_file("tests/tffi.nim")
            test_file("tests/tlive.nim")
        }
    }
}
