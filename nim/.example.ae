// Nim consumer-install proof: prove the packaged module drives the engine from a
// CLEAN environment for a third party. nim.consumer_example stages the package
// (src/ + native/.so + nimble — no tests/ or core/) as nim-pkg, plus the
// consumer, asserts the .so shipped, then `nim c -r --path:../nim-pkg/src
// consumer.nim <mode>` from the consumer dir with SELENIUM_CORE_LIB unset — so
// the consumer links only the package's own bundled .so. Modes: ffi/live.
// Skipped by preflight when nim is absent (prereq nim).
import bldr
import nim
import nim (stage, run_in, run_cmd, run_arg, assert_file)

aeb(cap) {
    bldr.build() {
        prereq("nim")
        dep("nim/.package.ae")
        nim.consumer_example() {
            stage("src/selenium_core.nim", "nim-pkg/src/selenium_core.nim")
            stage("selenium_core.nimble", "nim-pkg/selenium_core.nimble")
            stage("native/libselenium_core.so", "nim-pkg/native/libselenium_core.so")
            stage("example/consumer.nim", "nim-consumer/consumer.nim")
            assert_file("nim-pkg/native/libselenium_core.so")
            run_in("nim-consumer")
            run_cmd("nim c -r --hints:off --path:../nim-pkg/src consumer.nim")
            run_arg("ffi")
            run_arg("live")
        }
    }
}
