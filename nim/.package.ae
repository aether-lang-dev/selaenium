// Nim consumer package. The nim module/package is consumed in-place (its build
// tool reads the manifest + src + the staged native/), so packaging is just
// staging the engine .so into native/ (where the binding links/loads it) and
// publishing the module dir on the "package_dir" edge for the consumer-install proof
// (nim/.example.ae). copy.file does the staging declaratively. Skipped by
// preflight when nim is absent (prereq nim).
import bldr
import copy

aeb(cap) {
    bldr.build() {
        prereq("nim")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("native/libselenium_core.so")
        }
        publish_artifact("package_dir", bldr._get(builder_context(), "source_dir"))
    }
}
