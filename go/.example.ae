// Go consumer-install proof: prove the packaged module drives the engine from a
// CLEAN environment for a third party. go.consumer_example stages the published
// module (the whole go/ tree minus example/, with the bundled native/.so — no
// in-tree core/ sibling) as go-pkg, plus a consumer whose go.mod replaces the
// module to ../go-pkg, asserts the .so shipped, then `go run . <mode>` with
// SELENIUM_CORE_LIB unset. Modes: ffi/live (live self-skips). Skipped by
// preflight when go is absent (prereq go:1.22).
import bldr
import go
import go (stage, stage_dir, run_in, run_cmd, run_arg, assert_file)

aeb(cap) {
    bldr.build() {
        prereq("go:1.22")
        dep("go/.package.ae")
        go.consumer_example() {
            stage_dir(".", "go-pkg", "example")
            stage("example/go.mod", "go-consumer/go.mod")
            stage("example/main.go", "go-consumer/main.go")
            assert_file("go-pkg/native/libselenium_core.so")
            run_in("go-consumer")
            run_cmd("GOFLAGS=-mod=mod go run .")
            run_arg("ffi")
            run_arg("live")
        }
    }
}
