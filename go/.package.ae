// Go consumer package. The go module/package is consumed in-place (its build
// tool reads the manifest + src + the staged native/), so packaging is just
// staging the engine .so into native/ (where the binding links/loads it) and
// publishing the module dir on the "module_dir" edge for the consumer-install proof
// (go/.example.ae). copy.file does the staging declaratively. Skipped by
// preflight when go is absent (prereq go:1.22).
import bldr
import copy

aeb(cap) {
    bldr.build() {
        prereq("go:1.22")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("native/libselenium_core.so")
        }
        publish_artifact("module_dir", bldr._get(builder_context(), "source_dir"))
    }
}
