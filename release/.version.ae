// The engine release pin, checked or set across every independently shipped
// binding and the docs that quote it. Replaces release/version.py.
//
//   aeb release/.version.ae                              check every pin against SELENIUM_CORE_VERSION
//   SEL_RELEASE_TAG=v0.15.0 aeb release/.version.ae      check every pin against v0.15.0
//   SEL_RELEASE_SET=v0.15.0 aeb release/.version.ae      prepare a release: rewrite every pin
//
// aeb nodes take no arguments, so the mode comes from the environment. The node
// prints to target/.aeb/logs/version_release.log; a failure's reason is also in
// aeb's console summary.
//
// Setting is all-or-nothing: every pin is found and counted before any file is
// written. Never add this node to a target set in set mode: it rewrites tracked
// source files.
import bldr
import std.fs
import std.map
import std.os
import std.regex
import std.string

// One row per pin: the file, then the text around the version as a regex, with
// @V@ where the version stands (@B@ for one written without its leading "v").
// The same text twice in one file is listed twice. Docs are pinned the same
// way, so a stale doc fails the check and history ("added in v0.14.0") is never
// rewritten. `${` would be Aether string interpolation, so the shell-default
// pins spell it `[$][{]`.
const PINS[] = [
    "SELENIUM_CORE_VERSION", "^@V@\\s*$",
    "aether.toml", "^version = \"@B@\"$",
    "crystal/shard.yml", "^version: @B@$",
    "python/selenium/engine_fetcher.py", "ENGINE_VERSION = \"@V@\"",
    "ruby/lib/selenium/engine_fetcher.rb", "ENGINE_VERSION = '@V@'",
    "dart/lib/src/engine_fetcher.dart", "engineVersion = '@V@'",
    "dart/test/engine_fetcher_test.dart", "expect\\(EngineFetcher.engineVersion, '@V@'\\)",
    "java/src/main/java/org/openqa/selenium/Native.java", "ENGINE_VERSION = \"@V@\"",
    "javascript/lib/native.js", "ENGINE_VERSION = '@V@'",
    "dotnet/SeleniumCore/NativeLoader.cs", "EngineVersion = \"@V@\"",
    "go/enginepath.go", "SeleniumCoreVersion = \"@V@\"",
    "swift/Package.swift", "seleniumCoreVersion = \"@V@\"",
    "swift/Tests/SeleniumTests/VersionTests.swift", "expectedSeleniumCoreVersion = \"@V@\"",
    "swift/Tests/SeleniumTests/VersionTests.swift", "written for \\(\"@V@\"\\)",
    "zig/build.zig", "SELENIUM_CORE_VERSION = \"@V@\"",
    "lua/src/selenium_core.c", "#define ENGINE_VERSION \"@V@\"",
    "lua/src/engine_fetcher.lua", "F.ENGINE_VERSION = \"@V@\"",
    "php/src/EngineFetcher.php", "ENGINE_VERSION = '@V@'",
    "julia/src/Selenium.jl", "ENGINE_VERSION = \"@V@\"",
    "crystal/src/selenium.cr", "SELENIUM_CORE_VERSION = \"@V@\"",
    "crystal/bin/crystal-build", "ENGINE_VERSION=\"[$][{]ENGINE_VERSION:-@V@[}]",
    "haskell/bin/cabal-build", "ENGINE_VERSION=\"[$][{]ENGINE_VERSION:-@V@[}]",
    "haskell/selenium.cabal", "ENGINE_VERSION pin: @V@",
    "c/.build.ae", "return \"@V@\"",
    "c/.build.ae", "return \"@V@\"",
    "cpp/.tests.ae", "return \"@V@\"",
    "cpp/.tests.ae", "return \"@V@\"",
    "README.md", "require engine \\*\\*@V@\\*\\*",
    "README.md", "\\[@V@ release\\]",
    "README.md", "releases/tag/@V@\\)",
    "go/README.md", "SeleniumCoreVersion = \"@V@\"",
    "go/AGENTS.md", "SeleniumCoreVersion = \"@V@\"",
    "zig/README.md", "SELENIUM_CORE_VERSION = \"@V@\""
]

const SEMVER = "\\d+\\.\\d+\\.\\d+"

// A row's template as a regex whose whole match is the version: `\K` drops
// what precedes it and a lookahead checks what follows, so a find_all span is
// the version alone, like Python's match.span(1).
pattern(template: string) -> string {
    bare = string.contains(template, "@B@") == 1
    mark = if bare { "@B@" } else { "@V@" }
    at = string.index_of(template, mark)
    before = string.substring(template, 0, at)
    after = string.substring(template, at + 3, string.length(template))
    v = if bare { "" } else { "v" }
    return "${before}\\K${v}${SEMVER}(?=${after})"
}

// How many rows are identical to `row`, and whether `row` is the first of them.
copies(row: int) -> (int, bool) {
    n = 0
    first = true
    for i in 0..PINS.len / 2 {
        if PINS[2 * i] == PINS[2 * row] && PINS[2 * i + 1] == PINS[2 * row + 1] {
            n += 1
            if i < row { first = false }
        }
    }
    return n, first
}

// One row's pins in `content`, set to `tag`: the new text, the mismatches found
// on the way ("" when it already agreed) and how many, or an error.
retag(content: string, row: int, tag: string) -> (string, string, int, string) {
    file = PINS[2 * row]
    template = PINS[2 * row + 1]
    want = tag
    if string.contains(template, "@B@") == 1 { want = string.substring(tag, 1, string.length(tag)) }
    re, re_err = regex.compile_flags(pattern(template), regex.FLAG_MULTILINE)
    if re_err != "" { return "", "", 0, "${file}: bad pattern: ${re_err}" }
    defer regex.free(re)
    fa, _fe = regex.find_all(re, content)
    found = if fa == null { 0 } else { regex.find_all_count(fa) }
    expected, _first = copies(row)
    if found != expected {
        if fa != null { regex.find_all_free(fa) }
        return "", "", 0, "${file}: expected ${expected} version pin(s) like '${template}', found ${found}"
    }
    // Splice from the last match back, so earlier offsets stay valid.
    out = content
    detail = ""
    wrong = 0
    for k in 0..found {
        j = found - 1 - k
        ms = regex.find_all_start(fa, j)
        me = regex.find_all_end(fa, j)
        have = string.substring(content, ms, me)
        if have != want {
            detail = "${detail}\n  ${file}: ${have} != ${want}"
            wrong += 1
        }
        out = "${string.substring(out, 0, ms)}${want}${string.substring(out, me, string.length(out))}"
    }
    if fa != null { regex.find_all_free(fa) }
    return out, detail, wrong, ""
}

// The release run: every pin read and retagged in memory, then either written
// (set mode) or compared. "" when it passes, else why not.
release(root: string, tag: string, setting: bool) -> string {
    if regex.matches_lit("^v${SEMVER}$", tag)! == 0 {
        return "expected a release tag vX.Y.Z, got '${tag}'"
    }
    bodies = map.map_new()
    defer map.map_free(bodies)
    detail = ""
    wrong = 0
    for row in 0..PINS.len / 2 {
        _n, first = copies(row)
        if !first { continue }   // its first copy already handled every match
        file = PINS[2 * row]
        content, err = map.get_string(bodies, file)
        if map.map_has(bodies, file) == 0 {
            content, err = fs.read("${root}/${file}")
            if err != "" { return "${file}: cannot read" }
        }
        out, d, w, rerr = retag(content, row, tag)
        if rerr != "" { return rerr }
        map.map_put(bodies, file, out)
        detail = "${detail}${d}"
        wrong += w
    }
    if !setting {
        if wrong > 0 { return "${wrong} engine version pin(s) disagree with ${tag}:${detail}" }
        println("All engine version pins match ${tag}.")
        return ""
    }
    keys, _k = map.keys(bodies)
    defer map.map_keys_free(keys)
    for i in 0..map.keys_size(keys) {
        file = map.keys_get(keys, i)
        body, _g = map.get_string(bodies, file)
        werr = fs.write("${root}/${file}", body)
        if werr != "" { return "${file}: ${werr}" }
    }
    println("Prepared engine pins for ${tag}; commit before tagging, then verify the published downloads.")
    return ""
}

// An environment variable, "" when unset: os.getenv gives null then, which
// `!= ""` reads as set.
env(name: string) -> string {
    v = os.getenv(name)
    if string.length(v) == 0 { return "" }
    return v
}

aeb(cap) {
    bldr.build() {
        root = "${bldr.source_dir(builder_context())}/.."
        set_tag = env("SEL_RELEASE_SET")
        check_tag = env("SEL_RELEASE_TAG")
        old, old_err = fs.read("${root}/SELENIUM_CORE_VERSION")
        tag = string.trim(old)
        if check_tag != "" { tag = check_tag }
        if set_tag != "" { tag = set_tag }
        bad = ""
        if old_err != "" { bad = "cannot read SELENIUM_CORE_VERSION" }
        else if set_tag != "" && check_tag != "" { bad = "set SEL_RELEASE_SET or SEL_RELEASE_TAG, not both" }
        else { bad = release(root, tag, set_tag != "") }
        if bad != "" { bldr.fail(builder_context(), bad) }
    }
}
