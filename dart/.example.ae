// Dart consumer-install proof: prove the packaged package drives the engine from
// a CLEAN environment for a third party. dart.consumer_example stages the package
// (lib/ + pubspec + native/.so — no test/ or core/) as dart-pkg, plus the
// consumer (whose pubspec path dep is rewritten to ../dart-pkg via pre_cmd),
// asserts the .so shipped, then `dart run consumer_example.dart <mode>` (dart
// pub get runs implicitly) with SELENIUM_CORE_LIB unset. Modes: ffi/discovery/
// live. Skipped by preflight when dart is absent (prereq dart).
import bldr
import dart
import dart (stage, stage_dir, run_in, run_cmd, run_arg, pre_cmd, assert_file)

aeb(cap) {
    bldr.build() {
        prereq("dart")
        dep("dart/.package.ae")
        dart.consumer_example() {
            stage_dir("lib", "dart-pkg/lib", "")
            stage("pubspec.yaml", "dart-pkg/pubspec.yaml")
            stage("native/libselenium_core.so", "dart-pkg/native/libselenium_core.so")
            stage("example/pubspec.yaml", "dart-consumer/pubspec.yaml")
            stage("example/consumer_example.dart", "dart-consumer/consumer_example.dart")
            assert_file("dart-pkg/native/libselenium_core.so")
            run_in("dart-consumer")
            pre_cmd("sed -i 's|path: \\.\\.$|path: ../dart-pkg|' pubspec.yaml && dart pub get --offline 2>/dev/null || dart pub get")
            run_cmd("dart run consumer_example.dart")
            run_arg("ffi")
            run_arg("discovery")
            run_arg("live")
        }
    }
}
