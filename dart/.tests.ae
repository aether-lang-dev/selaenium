// Dart binding tests (dart:ffi). The loader honors SELENIUM_CORE_LIB, injected
// here from the engine's shared_lib artifact. dart.test() resolves deps
// (pub_get_first, offline against the local pub cache) then runs `dart test`
// over the FFI facts (ffi_test) + the live-Chrome smoke+surface (live_test).
// The live test spawns its own out-of-process content server (dart:ffi is
// synchronous, so an in-isolate server would deadlock) + chromedriver, and
// self-skips when chromedriver is absent. Skipped by preflight when dart is
// absent (prereq dart).
import bldr
import dart

aeb(cap) {
    bldr.build() {
        prereq("dart")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        dart.test() {
            env("SELENIUM_CORE_LIB", lib)
            pub_get_first("1")
            offline("1")
            test_path("test/ffi_test.dart test/live_test.dart")
        }
    }
}
