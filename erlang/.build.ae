// Erlang owns the canonical Aether Selenium NIF for the WHOLE BEAM family. This
// node builds it ONCE as the OTP app `selenium_nif` — the C NIF .so + the
// `selenium_nif` loader module + the idiomatic `selenium` wrapper — into
// _build/selenium_nif/{ebin,priv}. The Elixir and Gleam bindings consume this
// same artifact via ERL_LIBS (no second NIF, no copied C source), exactly as the
// JVM family layers over the one Java jar.
//
// The NIF declares the engine's aether_sel_embed_* exports `extern` and LINKS
// them at build time (link_engine), with the engine dir baked as an rpath so it
// resolves at run time — engine_lib carries the .so path (its dir = -L/-rpath).
// erl_nif.h comes from the running OTP root (erlang.nif discovers it). erlang.nif
// publishes erl_libs (_build) + nif_ebin (ebin) for the BEAM consumers. Skipped
// by preflight/nif when erlang is absent (prereq erlang).
import bldr
import erlang
import erlang (nif_source, erl_source, app_src, app_name, engine_lib, link_engine)

aeb(cap) {
    bldr.build() {
        prereq("erlang")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        erlang.nif() {
            app_name("selenium_nif")
            nif_source("c_src/selenium_nif.c")
            erl_source("src/selenium_nif.erl")
            erl_source("src/selenium.erl")
            app_src("src/selenium_nif.app")
            engine_lib(lib)
            link_engine("selenium_core")
        }
    }
}
