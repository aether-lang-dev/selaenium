// Crystal binding tests. Crystal binds the engine's flat C ABI
// (aether_sel_embed_*) DIRECTLY via a `lib`/`fun` block (@[Link]) — no glue, no
// second copy of the marshalling rules. The idiomatic Crystal surface (By
// constants, caller-owned-string handling, typed error, WebDriver) is in
// src/selenium_core.cr. The engine .so is staged into native/ (copy.file) and
// CRYSTAL_LIBRARY_PATH points Crystal's linker there so `-lselenium_core`
// resolves. crystal.test runs the no-browser FFI facts (crystal spec).
//
// Skipped by the gate when Crystal is absent (loud-skip) — authored here,
// verified on a box with Crystal; this box (catchyos) has no crystal, so it
// SKIPs cleanly.
import bldr
import crystal
import copy

aeb(cap) {
    bldr.build() {
        dep("selenium_core/.build.ae")
        native_lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(native_lib)
            to("native/libselenium_core.so")
        }
        crystal.test() {
            env("CRYSTAL_LIBRARY_PATH", "native")
            env("LD_LIBRARY_PATH", "native")
        }
    }
}
