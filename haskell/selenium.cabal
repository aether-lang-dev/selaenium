cabal-version:      2.4
name:               selenium
version:            0.1.0
synopsis:           Selenium WebDriver for Haskell — a thin FFI binding over the shared pure-Aether WebDriver core.
license:            Apache-2.0
author:             Paul Hammant
build-type:         Simple

-- This binding LINKS the engine rather than dlopen'ing it, so
-- libselenium_core.so must exist at BUILD time. The .so's directory and the
-- rpath are supplied on the cabal command line (--extra-lib-dirs=<abs dir> and
-- --ghc-options=-optl-Wl,-rpath,<abs dir>): cabal 2.4/9.10 rejects a bare
-- relative extra-lib-dirs at the register step and does not expand ${pkgroot} at
-- configure time, so absolute paths are the portable choice. Only the library
-- NAME lives here.
--
-- A dev with no Aether toolchain builds via haskell/bin/cabal-build after one
-- `scripts/fetch-engine.sh`: that wrapper resolves the engine dir (in order
-- SELENIUM_CORE_LIB -> bundled native/ -> the shared fetch cache
-- $XDG_CACHE_HOME/selaenium/v0.8.0/ -> monorepo ../selenium_core/native) and
-- passes the --extra-lib-dirs / rpath flags above. ENGINE_VERSION pin: v0.8.0
-- (the engine gh-release tag, matching scripts/fetch-engine.sh and the other
-- bindings). The .tests.ae harness supplies the same flags from the aeb-built
-- engine artifact for the toolchain path.

library
  hs-source-dirs:   src
  exposed-modules:  Selenium
                  , Selenium.Native
  build-depends:    base       >=4.14 && <5
                  , bytestring >=0.10 && <0.13
  default-language: Haskell2010
  ghc-options:      -Wall
  extra-libraries:  selenium_core

test-suite live
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Live.hs
  build-depends:    base
                  , process    >=1.6 && <1.7
                  , selenium
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts
  extra-libraries:  selenium_core

-- No-browser ABI-surface guard: pins the pure engine helpers + By/Keys facts and
-- (via Surface._refs) forces the whole public method table to type-check, so a
-- rename or accidental removal of any public method breaks the build. Mirrors the
-- crystal/swift surface specs; needs only the engine .so link, no chromedriver.
test-suite surface
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Surface.hs
  build-depends:    base
                  , selenium
  default-language: Haskell2010
  ghc-options:      -Wall
  extra-libraries:  selenium_core
