cabal-version:      2.4
name:               selenium
version:            0.1.0
synopsis:           Selenium WebDriver for Haskell — a thin FFI binding over the shared pure-Aether WebDriver core.
license:            Apache-2.0
author:             Paul Hammant
build-type:         Simple

-- This binding LINKS the engine rather than dlopen'ing it, so
-- libselenium_core.so must exist at BUILD time. The .so's directory and the
-- rpath are supplied on the cabal command line by haskell/run-tests.sh
-- (--extra-lib-dirs=<abs dir> and --ghc-options=-optl-Wl,-rpath,<abs dir>):
-- cabal 2.4/9.10 rejects a bare relative extra-lib-dirs at the register step
-- and does not expand ${pkgroot} at configure time, so absolute paths passed by
-- the harness are the portable choice. Only the library NAME lives here.

library
  hs-source-dirs:   src
  exposed-modules:  Selenium
                  , Selenium.Native
  build-depends:    base       >=4.14 && <5
                  , bytestring >=0.10 && <0.13
  default-language: Haskell2010
  ghc-options:      -Wall
  extra-libraries:  selenium_core

test-suite live
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Live.hs
  build-depends:    base
                  , selenium
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts
  extra-libraries:  selenium_core
