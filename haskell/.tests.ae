// Haskell binding tests (foreign import ccall + link-time). The engine .so is
// LINKED at build time via the .cabal (extra-libraries + ld-options rpath).
// This node deps the engine; run-tests.sh stages the .so into haskell/native/,
// builds with cabal, and runs the test (chromedriver + a content server are
// started by the harness, URLs passed via env). SKIPS LOUDLY if GHC/cabal is
// absent — authored here, verified on a box with GHC (catchyos).
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    hdir = "${root}/haskell"

    rc = os.system("bash \"${hdir}/run-tests.sh\" \"${lib}\"")
    if rc != 0 {
        println("haskell tests: FAILED")
        return 1
    }
    println("haskell tests: PASSED (ffi + live+surface, or SKIPPED if no GHC)")
    return 0
}
