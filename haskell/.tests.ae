// Haskell binding tests (foreign import ccall + link-time). The engine .so is
// LINKED at build time via the .cabal (extra-libraries: selenium_core). cabal
// 9.10 rejects a bare relative extra-lib-dirs and won't expand ${pkgroot}, so
// link_dir passes the engine's ABSOLUTE dir as --extra-lib-dirs + an rpath
// ghc-option; the dir is derived from the engine's shared_lib artifact (not
// hardcoded). SELENIUM_CORE_LIB is injected for the run. The test:live binary
// SELF-ORCHESTRATES its live legs through the engine's driver ABI (ensureDriver
// for chromedriver and geckodriver) plus an out-of-process content_server.py —
// it no longer waits on SEL_* env that nothing set, which had left the live
// shadow-DOM and Firefox legs permanently skipped. Skipped by preflight when
// GHC/cabal is absent (prereq ghc); run live on cachyos (GHC 9.6.6).
import bldr
import haskell
import haskell (link_dir, target)
import std.path

aeb(cap) {
    bldr.build() {
        prereq("ghc")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        engine_dir = path.dirname(lib)
        haskell.test() {
            env("SELENIUM_CORE_LIB", lib)
            link_dir(engine_dir)
            target("test:live")
        }
    }
}
