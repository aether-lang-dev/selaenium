// Rust consumer-install proof: prove the packaged crate drives the engine from a
// CLEAN environment for a third party. rust.consumer_example stages a bundled
// crate (Cargo.toml/build.rs/src + the bundled native/.so — NO in-tree ../core
// sibling) plus a separate consumer crate whose Cargo.toml has a path dep to the
// staged pkg, asserts the .so shipped, then `cargo run --offline -- <mode>` with
// SELENIUM_CORE_LIB unset — so the consumer links only the crate's own bundled
// .so. Modes: ffi/live (live self-skips). Skipped by preflight when rust is
// absent (prereq rust:1.75).
import bldr
import rust
import rust (stage, run_in, run_arg, assert_file)

aeb(cap) {
    bldr.build() {
        prereq("rust:1.75")
        dep("rust/.package.ae")
        rust.consumer_example() {
            // the bundled crate (from the packaged rust/ tree).
            stage("Cargo.toml", "rust-pkg/Cargo.toml")
            stage("build.rs", "rust-pkg/build.rs")
            // EVERY module lib.rs declares must be staged, or the packaged
            // crate cannot compile for a consumer even though the in-tree build
            // is green — actions/keys/select/wait were added to the binding and
            // left out here, which is exactly the drift this proof exists for.
            stage("src/lib.rs", "rust-pkg/src/lib.rs")
            stage("src/json.rs", "rust-pkg/src/json.rs")
            stage("src/actions.rs", "rust-pkg/src/actions.rs")
            stage("src/keys.rs", "rust-pkg/src/keys.rs")
            stage("src/select.rs", "rust-pkg/src/select.rs")
            stage("src/wait.rs", "rust-pkg/src/wait.rs")
            stage("native/libselenium_core.so", "rust-pkg/native/libselenium_core.so")
            // the consumer crate (path-deps ../pkg).
            stage("example/Cargo.toml", "rust-consumer/Cargo.toml")
            stage("example/build.rs", "rust-consumer/build.rs")
            stage("example/src/main.rs", "rust-consumer/src/main.rs")
            assert_file("rust-pkg/native/libselenium_core.so")
            run_in("rust-consumer")
            run_arg("ffi")
            run_arg("live")
        }
    }
}
