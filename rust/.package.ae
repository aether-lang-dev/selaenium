// Third-party-consumer PACKAGE stage for the Rust binding.
//
// Rust consumes selenium-core as a crate (source, linked at the consumer's
// build time). build.rs links the engine .so; it looks in the crate's own
// native/ dir, so the .so must ship inside the crate. This stages the freshly-
// built engine .so into rust/native/. Deps core/.build.ae; publishes the crate
// dir on "crate_dir".
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    rsdir = "${root}/rust"

    rc = os.system("mkdir -p \"${rsdir}/native\" && cp \"${lib}\" \"${rsdir}/native/libselenium_core.so\"")
    if rc != 0 {
        println("rust package: failed to stage engine .so into rust/native/")
        return 1
    }
    build.publish_artifact(b, "crate_dir", "${rsdir}")
    println("rust package: staged engine .so into rust/native/ (crate ready)")
    return 0
}
