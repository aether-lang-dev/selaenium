// Rust consumer package (the crate). The crate is consumed in-place (cargo reads
// Cargo.toml + build.rs + src/ + the staged native/), so packaging is just
// staging the engine .so into rust/native/ (where build.rs links it) and
// publishing the crate dir on the "crate_dir" edge for the consumer-install
// proof (rust/.example.ae). copy.file does the staging declaratively. Skipped by
// preflight when rust is absent (prereq rust:1.75).
import bldr
import copy

aeb(cap) {
    bldr.build() {
        prereq("rust:1.75")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        copy.file() {
            from(lib)
            to("native/libselenium_core.so")
        }
        publish_artifact("crate_dir", bldr._get(builder_context(), "source_dir"))
    }
}
