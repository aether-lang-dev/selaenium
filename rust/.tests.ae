// Rust binding tests. The engine .so is linked at BUILD time via build.rs
// (cargo:rustc-link-* + rpath); build.rs finds it via SELENIUM_CORE_LIB (env,
// injected here from the engine's shared_lib artifact) or the in-tree native/
// dir the engine node stages. Zero external crates -> builds fully offline. The
// live test spawns its own chromedriver + std-only content server and self-skips
// if chromedriver is absent.
import bldr
import rust

aeb(cap) {
    bldr.build() {
        prereq("rust:1.75")
        dep("selenium_core/.build.ae")
        lib = dep_artifact("selenium_core/.build.ae", "shared_lib")
        env("SELENIUM_CORE_LIB", lib)
        rust.cargo_test_existing() {
            extra("--offline")
        }
    }
}
