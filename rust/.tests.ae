// Rust binding tests. The engine .so is linked at BUILD time via build.rs
// (cargo:rustc-link-* + rpath); build.rs finds it via SELENIUM_CORE_LIB (which
// we point at the shared engine artifact this node deps) or the bundled native/
// dir. Zero external crates → builds fully offline. The live test spawns its own
// chromedriver + std-only content server and self-skips if chromedriver is
// absent.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    rsdir = "${root}/rust"
    cargo = "PATH=\"$HOME/.cargo/bin:$PATH\""

    rc = os.system("cd \"${rsdir}\" && ${cargo} SELENIUM_CORE_LIB=\"${lib}\" cargo test --offline 2>&1")
    if rc != 0 {
        // Retry without --offline in case the registry index needs a touch
        // (the crate itself has no deps, so this should still be network-free).
        rc = os.system("cd \"${rsdir}\" && ${cargo} SELENIUM_CORE_LIB=\"${lib}\" cargo test 2>&1")
        if rc != 0 {
            println("rust tests: cargo test FAILED")
            return 1
        }
    }
    println("rust tests: PASSED (ffi + live+surface)")
    return 0
}
