// aeb tests for Selenium Manager — the Rust library unit tests, matching the
// old Bazel `:unit` target (rust_test with crate = ":selenium_manager", which
// runs the library's #[test]s). `--lib` restricts cargo to the lib unit tests,
// not the integration tests under rust/tests/ (those drive real browsers/network
// and were a separate, browser-gated Bazel target).
//
// INTERIM: this shells `cargo test --lib` directly. The idiomatic form is
//   rust.cargo_test_existing(b) { extra("--lib") }
// but the aeb rust SDK's cargo_test_cmd READS an `extra` option that has no
// setter yet — a one-line addition requested in
// ../aeb/selenium-porting-needs-for-aeb.md (item 1). Once the aeb sibling lands
// `extra(args)`, switch this leaf back to the builder form above.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, ".build.ae")
    root = build._get(b, "root")
    rc = os.system("cd \"${root}\" && cargo test --offline --lib 2>&1 || cargo test --lib")
    if rc != 0 {
        println("rust tests: cargo test --lib FAILED")
        return 1
    }
    println("rust tests: PASSED (cargo test --lib — 45 unit tests)")
    return 0
}
