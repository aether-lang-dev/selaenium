// Clojure binding tests. Clojure is a JVM-family binding: it consumes the ONE
// Java FFM binding's classes over Clojure/Java interop — no second FFI, no
// second .so (one Java jar backs Kotlin/Scala/Clojure/Groovy). This node deps
// the engine, compiles the Java binding classes, and runs the Clojure test with
// the Java classes + clojure/src + clojure/test on the classpath. The FFM
// binding needs --enable-native-access, threaded in via JAVA_TOOL_OPTIONS (the
// Debian clojure launcher is plain clojure.main, no -J). The live test self-
// skips if chromedriver is absent.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    cdir = "${root}/clojure"
    jsrc = "${root}/java/src/org/seleniumhq/aether"

    have = os.system("command -v clojure >/dev/null 2>&1")
    if have != 0 {
        println("clojure tests: SKIPPED — clojure not on PATH")
        return 0
    }
    // Compile the Java FFM binding classes.
    jout = "${cdir}/jout"
    cc = os.system("rm -rf \"${jout}\" && mkdir -p \"${jout}\" && javac -d \"${jout}\" \"${jsrc}\"/*.java")
    if cc != 0 { println("clojure tests: javac (Java binding) FAILED"); return 1 }

    cp = "${jout}:${cdir}/src:${cdir}/test"
    rc = os.system("cd \"${cdir}\" && SELENIUM_CORE_LIB=\"${lib}\" JAVA_TOOL_OPTIONS=\"--enable-native-access=ALL-UNNAMED\" clojure -cp \"${cp}\" -m live-test")
    if rc != 0 { println("clojure tests: FAILED"); return 1 }
    println("clojure tests: PASSED (ffi + live+surface)")
    return 0
}
