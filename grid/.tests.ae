// Pure unit test for the hub's routing logic (hubcore.ae) — the session-id
// codec, capability reading and response shaping. No browser, no driver and no
// listening port, so it runs anywhere. The LIVE hub (provisioning a driver and
// proxying a whole session) is proven by grid/run-grid-test.sh --hub driving the
// per-binding Grid legs.
import bldr
import aether

aeb(cap) {
    bldr.build() {
        aether.program_test() {
            source("tests/hub_probe.ae")
            lib(".")
        }
        // The Grid node registry (registry.ae) — a pool-owned std.snapshot
        // copy-on-write structure (NOT an actor; see registry.ae's header for the
        // runtime reason). Pure: no network, no driver, no listening port.
        aether.program_test() {
            source("tests/registry_probe.ae")
            lib(".")
        }
        // Concurrent-writers stress: the registry is std.snapshot's first real
        // concurrent-CAS-writer user, and nothing upstream tests that path, so we
        // prove it here — many worker threads register at once, count must be
        // exact (no lost updates). Needs the os cap for std.worker's thread pool.
        aether.program_test() {
            source("tests/registry_stress.ae")
            lib(".")
            caps("os")
        }
        // Diagnostic (not an assertion): prints the registry table after each write
        // of the register->report_inuse->sweep handler sequence, so a box that drops
        // `inuse` through the live server (see asks/NOTE-grid-live-tests-...) can see
        // WHICH write loses it, with no HTTP/JSON/driver in the picture. Always
        // returns 0; read its printed lines in the tests_grid.log.
        aether.program_test() {
            source("tests/inuse_diag.ae")
            lib(".")
        }
    }
}
