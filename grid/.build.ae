// The selaenium standalone Grid hub — a real W3C endpoint that provisions
// drivers and proxies sessions to them (router + node + local drivers in ONE
// process). lib("../selenium_core") resolves `driver`; lib(".../drivermgr") the
// resolve/browser/version/cft/cache modules it imports by bare name.
// caps: net (serve + proxy to the driver), os (spawn/kill drivers), fs (the
// driver cache).
import bldr
import aether

aeb(cap) {
    bldr.build() {
        // The hub: router + standalone drivers + the node REGISTRY actor + the
        // /se/grid/register endpoint that feeds it. lib(".") resolves registry
        // (+ hubcore); actors is a std module.
        aether.program() {
            source("hub.ae")
            lib(".")
            lib("../selenium_core")
            lib("../selenium_core/drivermgr")
            caps("net,os,fs")
            output("selaenium-hub")
        }
        // The node: a W3C session server that registers with a hub over HTTP.
        aether.program() {
            source("node.ae")
            lib(".")
            lib("../selenium_core")
            lib("../selenium_core/drivermgr")
            caps("net,os,fs")
            output("selaenium-node")
        }
    }
}
