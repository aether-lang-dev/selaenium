// registry_probe.ae — unit test for the Grid node registry (registry.ae).
//
// The registry is a POOL-OWNED copy-on-write snapshot (not an actor — see
// registry.ae's header for the runtime reason: a fire-and-forget send from a
// std.http pool-worker thread to an actor is silently dropped on released 0.681).
// So this drives the SAME functions the hub's @c_callback handlers call — a
// registry cell + register/remove/slot/count/available over it — which is
// exactly the production path, with NO network and NO driver. Run via
// grid/tests/.tests.ae.
//
// Each `it` creates a FRESH registry cell (registry.registry_init) so cases don't
// bleed into each other.
import std.spec
import std.string
import registry

main() {
    fw = spec.init()

    spec.describe(fw, "grid registry: register / count / remove") {
        spec.it("registers two nodes and counts them") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://127.0.0.1:5001", "chrome firefox", 2)
            registry.register(reg, "n2", "http://127.0.0.1:5002", "chrome", 1)
            spec.assert_eq(registry.count(reg), 2, "two nodes registered")
        }
        spec.it("register is idempotent on id (replace, not duplicate)") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://a", "chrome", 1)
            registry.register(reg, "n1", "http://b", "chrome", 3)
            spec.assert_eq(registry.count(reg), 1, "still one node after re-register")
        }
        spec.it("remove drops a node from the count") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://a", "chrome", 1)
            registry.register(reg, "n2", "http://b", "chrome", 1)
            registry.remove(reg, "n1")
            spec.assert_eq(registry.count(reg), 1, "one node left after remove")
        }
    }

    spec.describe(fw, "grid registry: availability honours browser + slot capacity") {
        spec.it("a node hosting the browser with a free slot is available") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://chrome-node", "chrome", 1)
            spec.assert_eq(registry.available(reg, "chrome"), 1, "chrome available")
        }
        spec.it("an unknown browser is not available") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://chrome-node", "chrome", 1)
            spec.assert_eq(registry.available(reg, "safari"), 0, "safari has no node")
        }
        spec.it("no free slot -> not available") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 1)
            registry.slot(reg, "n1", 1)              // fill the single slot
            spec.assert_eq(registry.available(reg, "chrome"), 0, "no free slot")
        }
        spec.it("releasing a slot makes it available again") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 1)
            registry.slot(reg, "n1", 1)
            registry.slot(reg, "n1", 0 - 1)          // release
            spec.assert_eq(registry.available(reg, "chrome"), 1, "available after release")
        }
    }

    spec.describe(fw, "grid registry: pick_node returns id+address of a match (the distributor's pick)") {
        spec.it("returns the id and address of an available node for the browser") callback {
            reg = registry.registry_init()
            registry.register(reg, "node-5001", "http://127.0.0.1:5001", "chrome", 1)
            registry.register(reg, "node-5002", "http://127.0.0.1:5002", "firefox", 1)
            id, addr = registry.pick_node(reg, "firefox")
            spec.assert_str_eq(id, "node-5002", "picked the firefox node's id")
            spec.assert_str_eq(addr, "http://127.0.0.1:5002", "picked its address")
        }
        spec.it("returns empty id+address when nothing matches / no free slot") callback {
            reg = registry.registry_init()
            registry.register(reg, "node-5001", "http://127.0.0.1:5001", "chrome", 1)
            registry.slot(reg, "node-5001", 1)       // fill it
            id, addr = registry.pick_node(reg, "chrome")
            spec.assert_str_eq(id, "", "no free slot -> empty id")
            spec.assert_str_eq(addr, "", "no free slot -> empty address")
        }
    }

    spec.describe(fw, "grid registry: hosts distinguishes saturated from absent (the queue decision)") {
        spec.it("hosts=1 for a browser some node lists, even with no free slot") callback {
            reg = registry.registry_init()
            registry.register(reg, "node-5001", "http://127.0.0.1:5001", "chrome", 1)
            registry.slot(reg, "node-5001", 1)       // saturated, but still hosts chrome
            spec.assert_eq(registry.hosts(reg, "chrome"), 1, "chrome is hosted (would QUEUE)")
            spec.assert_eq(registry.available(reg, "chrome"), 0, "...but not currently available")
        }
        spec.it("hosts=0 for a browser no node lists (would fall back to local)") callback {
            reg = registry.registry_init()
            registry.register(reg, "node-5001", "http://127.0.0.1:5001", "chrome", 1)
            spec.assert_eq(registry.hosts(reg, "safari"), 0, "safari not hosted (local fallback)")
        }
    }

    spec.describe(fw, "grid registry: report_inuse (node-authoritative slot count)") {
        spec.it("sets inuse absolutely, gating availability") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 2)
            registry.report_inuse(reg, "n1", 2)          // node reports itself full
            spec.assert_eq(registry.available(reg, "chrome"), 0, "full per node report")
        }
        spec.it("a lower node report FREES slots (the abandoned-session path)") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 2)
            registry.report_inuse(reg, "n1", 2)          // full
            spec.assert_eq(registry.available(reg, "chrome"), 0, "full")
            registry.report_inuse(reg, "n1", 1)          // node's next heartbeat: a session ended
            spec.assert_eq(registry.available(reg, "chrome"), 1, "freed by the node's report")
            id, addr = registry.pick_node(reg, "chrome")
            spec.assert_str_eq(id, "n1", "pickable again")
        }
        spec.it("is an absolute SET, not a delta (unlike slot)") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 5)
            registry.slot(reg, "n1", 1)                  // hub-side +1 (legacy op)
            registry.report_inuse(reg, "n1", 3)          // node says: actually 3
            js = registry.status_json(reg)
            spec.assert_true(string.index_of(js, "\"inuse\":3") >= 0, "set to 3, not 1+3")
        }
        spec.it("clamps a negative report to 0") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 1)
            registry.report_inuse(reg, "n1", 0 - 4)
            js = registry.status_json(reg)
            spec.assert_true(string.index_of(js, "\"inuse\":0") >= 0, "clamped to 0")
        }
        spec.it("is a no-op for an unknown id") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://only", "chrome", 1)
            registry.report_inuse(reg, "ghost", 9)       // no such node
            spec.assert_eq(registry.count(reg), 1, "no phantom row created")
            spec.assert_eq(registry.available(reg, "chrome"), 1, "n1 untouched")
        }
        spec.it("preserves max and address (only inuse changes)") callback {
            reg = registry.registry_init()
            registry.register(reg, "n1", "http://keep", "chrome", 7)
            registry.report_inuse(reg, "n1", 2)
            js = registry.status_json(reg)
            spec.assert_true(string.index_of(js, "\"address\":\"http://keep\"") >= 0, "address kept")
            spec.assert_true(string.index_of(js, "\"max\":7") >= 0, "max kept")
            spec.assert_true(string.index_of(js, "\"inuse\":2") >= 0, "inuse set")
        }
    }

    spec.describe(fw, "grid registry: status_json (the /se/grid/status payload)") {
        spec.it("empty registry is an empty JSON array") callback {
            reg = registry.registry_init()
            spec.assert_str_eq(registry.status_json(reg), "[]", "no nodes -> []")
        }
        spec.it("reports id, address, max and inuse per node") callback {
            reg = registry.registry_init()
            registry.register(reg, "node-5001", "http://127.0.0.1:5001", "chrome firefox", 3)
            registry.slot(reg, "node-5001", 1)       // one in use
            js = registry.status_json(reg)
            spec.assert_true(string.index_of(js, "\"id\":\"node-5001\"") >= 0, "id present")
            spec.assert_true(string.index_of(js, "\"address\":\"http://127.0.0.1:5001\"") >= 0, "address present")
            spec.assert_true(string.index_of(js, "\"max\":3") >= 0, "max present")
            spec.assert_true(string.index_of(js, "\"inuse\":1") >= 0, "inuse tracked")
        }
    }

    _rc = spec.run_summary(fw)
    return _rc
}
