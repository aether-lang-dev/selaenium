// hub.ae — selaenium's own Selenium Grid hub, STANDALONE mode.
//
// Until now selaenium was a Grid CLIENT only (point openSession at somebody
// else's hub). This is the server half: a W3C endpoint that accepts newSession,
// provisions a driver for the requested browser, and proxies every subsequent
// session-scoped request to the driver that owns that session — the job the
// `selenium/standalone-chromium` container does, without the container.
//
// It is standalone mode only: router + node + local drivers in ONE process.
// Distributed Grid (a separate Router / Distributor / SessionQueue / SessionMap
// over an event bus, with remote Nodes registering) is deliberately NOT here;
// see docs/Grid.md for where the line is drawn and why.
//
// ---- shared state under the worker pool ------------------------------------
//
// std.http dispatches HTTP/1.1 handlers on a worker pool (cores * 2), so any
// shared mutable state two handlers touch has to be made safe. There are two
// kinds here and they take different approaches:
//
//   1. The SESSION MAP is avoided entirely — the hub is STATELESS about sessions.
//      The routing facts a later request needs (which driver process owns this
//      session, on which port) are encoded INTO the session id the hub hands back
//      (see encode_session_id); decoding is pure string work on the request's own
//      path, so two requests never touch shared state. The cost is that an
//      abandoned session leaves its driver running (nothing tracks it to time
//      out); real Grid reaps those — see docs/Grid.md "Known limitations".
//
//   2. The NODE REGISTRY (distributed Grid) is genuinely shared, and is made safe
//      as a POOL-OWNED copy-on-write snapshot (registry.ae): a single immutable
//      node table in a std.snapshot cell, mutated by lock-free CAS from the pool
//      handlers, read by lock-free load. NOT an actor — a fire-and-forget send
//      from a pool-worker thread to an actor is silently dropped on released
//      0.681 (see registry.ae's header). This is the same "pool-owned shared
//      state, guarded by a concurrency primitive" shape the runtime's own reverse
//      -proxy load balancer uses (atomics + a mutex, in C); the registry does it
//      from .ae with the one primitive .ae has, snapshot.cas.
import std.http
import std.http.client
import std.string
import std.json
import std.os
import std.time
import driver
import hubcore
import registry

// ---- proxying ---------------------------------------------------------------

// One request to a driver on 127.0.0.1:<port>, returned as "OK <status> <body>"
// or "ERR <message>" — the same tagged shape the engine's http_roundtrip uses,
// so the two speak one convention.
proxy(port: int, method: string, path: string, body: string) -> string {
    url = string.concat("http://127.0.0.1:", string.concat(string.from_int(port), path))
    req = client.request(method, url)
    _h1 = client.set_header(req, "Accept", "application/json")
    if string.equals(method, "POST") == 1 {
        b = body
        if string.length(b) == 0 { b = "{}" }
        _sb = client.set_body(req, b, string.length(b), "application/json; charset=utf-8")
    }
    _to = client.set_timeout(req, 300s)
    resp, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return string.concat("ERR ", err) }
    status = client.response_status(resp)
    rbody = client.response_body(resp)
    client.response_free(resp)
    return string.concat(string.concat("OK ", string.from_int(status)), string.concat(" ", rbody))
}

send_json(res: ptr, status: int, body: string) {
    http.response_set_status(res, status)
    http.response_set_header(res, "Content-Type", "application/json; charset=utf-8")
    http.response_set_body(res, body)
}

// ---- handlers ---------------------------------------------------------------

// GET /status — the readiness probe every Grid client (and our own
// grid/run-grid-test.sh) polls before handing work over.
status_handler(req: ptr, res: ptr, ud: ptr) {
    out = json.obj()
    inner = json.obj()
    _r = json.set(inner, "ready", json.str("true"))
    _m = json.set(inner, "message", json.str("selaenium standalone hub"))
    _v = json.set(out, "value", inner)
    encoded, _e = json.encode(out)
    json.free(out)
    // "ready" is a JSON boolean on the wire, not the string json.str gives us.
    send_json(res, 200, string.replace_all(encoded, "\"true\"", "true"))
}

// POST /session — the DISTRIBUTOR. If a registered node can host the requested
// browser (registry.pick_address, `ud` = the node-registry cell), proxy the
// newSession to THAT node and hand back its answer with the session id rewritten
// to route later requests back to the same node (pid=0 sentinel + the node's
// port). If no node is registered for the browser, fall back to provisioning a
// driver locally (standalone behaviour) — so the hub is a superset: distributed
// when nodes exist, standalone otherwise.
new_session_handler(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    browser = hubcore.browser_of_caps(body)

    // ---- distributor + new-session queue -----------------------------------
    // If a node hosts this browser, route to it. When all matching nodes are
    // BUSY (hosts=1 but no free slot), QUEUE: poll pick_node until a slot frees
    // or the queue times out (SEL_GRID_QUEUE_TIMEOUT ms, default 30s) — real Grid
    // holds saturating requests rather than failing them. If NO node hosts the
    // browser at all, fall through to a local driver (standalone superset).
    if ud != null {
        if registry.hosts(ud, browser) == 1 {
            deadline = _now_ms() + _queue_timeout_ms()
            waited_any = 0
            while 1 == 1 {
                node_id, node_addr = registry.pick_node(ud, browser)
                if string.length(node_addr) > 0 {
                    if _distribute_to_node(res, ud, node_id, node_addr, body) == 1 { return }
                    // the picked node failed to create the session; if others may
                    // still serve, keep trying until the deadline, else give up to
                    // the local fallback below.
                }
                if _now_ms() >= deadline {
                    // saturated for the whole queue window: a proper W3C timeout,
                    // NOT a silent local fallback (the client asked the grid).
                    if waited_any == 1 {
                        send_json(res, 500, hubcore.w3c_error("session not created",
                            string.concat("no free slot on any node for browser: ", browser)))
                        return
                    }
                    break   // never actually queued (transient); allow local fallback
                }
                waited_any = 1
                sleep(_queue_poll_ms())
            }
        }
    }

    dp = driver.ensure(browser, "", 20000)
    if dp == null {
        send_json(res, 500, hubcore.w3c_error("session not created",
            string.concat("no driver could be provisioned for browser: ", browser)))
        return
    }
    port = driver.port_of(dp)
    pid = driver.pid_of(dp)

    tagged = proxy(port, "POST", "/session", body)
    status, rbody = hubcore.split_tagged(tagged)
    if status == 0 {
        driver.stop(dp)
        send_json(res, 500, hubcore.w3c_error("session not created",
            string.concat("driver transport failure: ", rbody)))
        return
    }
    if status >= 400 {
        // The driver refused (bad caps, say). It owns no session, so reap it and
        // pass its own error envelope through untouched.
        driver.stop(dp)
        send_json(res, status, rbody)
        return
    }

    real_id = hubcore.session_id_of_response(rbody)
    if string.length(real_id) == 0 {
        driver.stop(dp)
        send_json(res, 500, hubcore.w3c_error("session not created",
            "driver returned no session id"))
        return
    }

    // Free the handle WITHOUT killing the process: the driver must outlive this
    // request, and DELETE /session/<id> reaps it by the pid we just encoded.
    driver.release(dp)

    hub_id = hubcore.encode_session_id(pid, port, real_id)
    send_json(res, status, string.replace_all(rbody, real_id, hub_id))
}

// _distribute_to_node — proxy a newSession to `node_addr` (a registered node's
// URL) and, on success, hand the client a hub session id that routes later
// requests back to that node. Returns 1 if the request was fully handled
// (success OR the node's own error passed through), 0 if the node was
// unreachable (caller falls back to local provisioning).
//
// Session-id nesting: the node itself wraps its driver's id as
// node_sid = <driverpid>-<driverport>-<realid> (its own encode). The hub wraps
// THAT again as hub_id = 0-<node_port>-<node_sid> — pid 0 marks "a node, not a
// local driver", and <node_port> is where forward_handler proxies. So the hub
// stays stateless about sessions: the whole route (node port + node's own
// routing) rides in the id.
_distribute_to_node(res: ptr, cell: ptr, node_id: string, node_addr: string, body: string) -> int {
    node_port = hubcore.port_of_address(node_addr)
    if node_port < 0 { return 0 }

    tagged = proxy(node_port, "POST", "/session", body)
    status, rbody = hubcore.split_tagged(tagged)
    if status == 0 { return 0 }            // node unreachable: let the caller fall back
    if status == 503 {
        // The node is FULL — its own live-slot gate refused (node-authoritative;
        // our registry hint lagged). Not the client's error: treat it like
        // unreachable so the caller tries another node / queues and retries.
        return 0
    }
    if status >= 400 {
        send_json(res, status, rbody)      // node refused (bad caps): pass its error through
        return 1
    }
    node_sid = hubcore.session_id_of_response(rbody)
    if string.length(node_sid) == 0 {
        send_json(res, 500, hubcore.w3c_error("session not created",
            "node returned no session id"))
        return 1
    }

    // No hub-side slot bookkeeping: the NODE owns its slot count and reports it in
    // the heartbeat (registry.report_inuse). Its own accept/reject (the 503 above)
    // is the authoritative gate; our registry inuse is only a routing hint that the
    // next heartbeat refreshes. This is what closes the abandoned-session slot leak
    // — a session with no DELETE still frees on the hub when the node's count drops.

    hub_id = hubcore.encode_session_id(0, node_port, node_sid)
    send_json(res, status, string.replace_all(rbody, node_sid, hub_id))
    return 1
}

// Everything else under /session/... — decode the owner out of the id, replay the
// request against that driver, and hand the answer straight back.
forward_handler(req: ptr, res: ptr, ud: ptr) {
    path = http.request_path(req)
    method = http.request_method(req)
    hub_id = hubcore.session_id_of_path(path)
    pid, port, real_id = hubcore.decode_session_id(hub_id)
    if port < 0 {
        send_json(res, 404, hubcore.w3c_error("invalid session id",
            string.concat("not a hub session id: ", hub_id)))
        return
    }

    // Rewrite the hub id back to the driver's own id, in the path and in any body
    // that echoes it.
    driver_path = string.replace_all(path, hub_id, real_id)
    body = http.request_body(req)
    if string.length(body) > 0 { body = string.replace_all(body, hub_id, real_id) }

    tagged = proxy(port, method, driver_path, body)
    status, rbody = hubcore.split_tagged(tagged)
    if status == 0 {
        send_json(res, 500, hubcore.w3c_error("unknown error",
            string.concat("driver transport failure: ", rbody)))
        return
    }

    // A successful DELETE of the session itself ends it. Two cases by the pid
    // field: a LOCAL driver (pid>0) is reaped by pid, or it would outlive the
    // hub's knowledge of it. A NODE session (pid==0, the distributor sentinel)
    // isn't ours to reap AND isn't ours to account: the node quits its own driver
    // and decrements its OWN live-slot count, which it reports in the next
    // heartbeat (registry.report_inuse). So the hub does nothing for a node DELETE
    // — no slot bookkeeping here. This is the same path an ABANDONED node session
    // (no DELETE ever arrives) takes: the node's report frees the slot either way.
    if string.equals(method, "DELETE") == 1 {
        if string.equals(path, string.concat("/session/", hub_id)) == 1 {
            if status < 400 {
                if pid != 0 {
                    driver.reap(pid)
                }
            }
        }
    }

    send_json(res, status, string.replace_all(rbody, real_id, hub_id))
}

// GET /se/grid/nodecount — how many nodes are registered. The registry is a
// pool-owned snapshot cell (passed in as `ud` from main); this reads it directly
// with a lock-free load (registry.count). No actor, no ref-cell poll — a handler
// runs on std.http's worker pool, and a pool thread cannot get an actor to
// process a message (the send is silently dropped: see registry.ae's header), so
// the registry lives ON the pool and every handler touches it directly.
node_count_handler(req: ptr, res: ptr, ud: ptr) {
    body = string.concat("{\"nodes\":", string.concat(string.from_int(registry.count(ud)), "}"))
    send_json(res, 200, body)
}

// GET /se/grid/status — the Grid introspection endpoint clients and the UI poll.
// Reports the LIVE registered nodes (freshness-filtered) with their slot usage,
// wrapped in the W3C {"value":{...}} envelope real Selenium Grid uses. `ready` is
// always true: the hub can serve every request — a registered node when one is
// free (or after the queue), else a locally-provisioned driver — so it never
// reports "not ready" the way a distributed-only Grid with zero nodes would.
grid_status_handler(req: ptr, res: ptr, ud: ptr) {
    nodes = "[]"
    n = 0
    if ud != null { nodes = registry.status_json(ud); n = registry.count(ud) }
    msg = string.concat("selaenium Grid hub — ", string.concat(string.from_int(n), " node(s) registered"))
    body = string.concat("{\"value\":{\"ready\":true,\"message\":", string.concat(_qs_hub(msg),
        string.concat(",\"nodes\":", string.concat(nodes, "}}"))))
    send_json(res, 200, body)
}

// POST /se/grid/register — a node advertising itself. Parse its descriptor
// ({"id","address","browsers":[..],"maxSessions"}) and register it in the
// pool-owned registry cell (`ud`). registry.register is a CAS-COW write, safe
// from concurrent pool handlers. Idempotent: a re-POST (heartbeat / re-register)
// replaces the node by id.
register_node_handler(req: ptr, res: ptr, ud: ptr) {
    body = http.request_body(req)
    root, perr = json.parse(body)
    if string.length(perr) > 0 {
        send_json(res, 400, hubcore.w3c_error("invalid argument", "malformed node descriptor"))
        return
    }
    id = _str_field(root, "id")
    address = _str_field(root, "address")
    browsers = _browsers_space(root)
    max = _int_field(root, "maxSessions")
    inuse = _int_field(root, "inuse")                  // node-authoritative live count
    if string.length(id) == 0 { id = address }         // fall back to address as id
    if max <= 0 { max = 1 }
    if inuse < 0 { inuse = 0 }

    registry.register(ud, id, address, browsers, max)
    // The node owns its live sessions; reconcile our registry inuse to what it
    // just reported. register() writes a fresh row with inuse=0, so this SET (not
    // a delta) restores the node's real count — and an abandoned session frees its
    // slot here as soon as the node's heartbeat reports the drop. No hub-side
    // session tracking; the node's report is the truth.
    registry.report_inuse(ud, id, inuse)
    // Compact stale (dead-node) rows on this low-frequency write point, so the
    // table doesn't grow without bound. Reads already ignore stale rows, so this
    // is only physical cleanup — every register (incl. every heartbeat re-POST)
    // sweeps, which is a natural cadence tied to node liveness.
    registry.sweep(ud)

    out = json.obj()
    _o = json.set(out, "ok", json.str("true"))
    encoded, _e = json.encode(out)
    json.free(out)
    send_json(res, 200, string.replace_all(encoded, "\"true\"", "true"))
}

// _browsers_space(root) — the descriptor's "browsers":[..] as a space-joined
// string (the registry's stored form).
_browsers_space(root: ptr) -> string {
    arr, _a = json.object_get(root, "browsers")
    if arr == null { return "" }
    out = ""
    i = 0
    el, _e0 = json.array_get(arr, i)
    while el != null {
        s, serr = json.get_string(el)
        if string.length(serr) == 0 {
            if string.length(out) > 0 { out = string.concat(out, " ") }
            out = string.concat(out, s)
        }
        i = i + 1
        el, _en = json.array_get(arr, i)
    }
    return out
}

_str_field(root: ptr, key: string) -> string {
    v, _v = json.object_get(root, key)
    if v == null { return "" }
    s, serr = json.get_string(v)
    if string.length(serr) > 0 { return "" }
    return s
}
_int_field(root: ptr, key: string) -> int {
    v, _v = json.object_get(root, key)
    if v == null { return 0 }
    return json.get_int(v)
}

// _qs_hub(s) — JSON-quote a hub-controlled string (status message). Minimal:
// the only values we quote here are fixed text + digits, but escape " and \ so a
// future message can't break the envelope.
_qs_hub(v: string) -> string {
    out = "\""
    i = 0
    while i < string.length(v) {
        c = string.substring(v, i, i + 1)
        if c == "\"" { out = string.concat(out, "\\\"") }
        else { if c == "\\" { out = string.concat(out, "\\\\") }
        else { out = string.concat(out, c) } }
        i = i + 1
    }
    return string.concat(out, "\"")
}

// ---- new-session queue knobs ------------------------------------------------
_now_ms() -> long { return time.now_ms() }

// How long the distributor holds a saturated newSession before giving up
// (SEL_GRID_QUEUE_TIMEOUT ms, default 30000). 0 disables queueing.
_queue_timeout_ms() -> long {
    v = os.getenv("SEL_GRID_QUEUE_TIMEOUT")
    if string.length(v) == 0 { return 30000 as long }
    p, e = string.to_int(v)
    if e != "" { return 30000 as long }
    if p < 0 { return 30000 as long }
    return p as long
}

// Poll interval while queued (ms). Small enough to grab a freed slot promptly,
// large enough not to spin the CPU.
_queue_poll_ms() -> int { return 100 }

main() {
    // The node registry — a pool-owned copy-on-write snapshot cell. The register
    // + nodecount handlers receive it as their `ud` and read/write it directly
    // (CAS for writes, lock-free load for reads), all on the http worker pool.
    // See registry.ae's header for why this is NOT an actor on released 0.681.
    reg_cell = registry.registry_init()

    // SEL_HUB_PORT overrides the conventional Grid port.
    port = 4444
    env_port_s = os.getenv("SEL_HUB_PORT")
    if string.length(env_port_s) > 0 {
        p, e = string.to_int(env_port_s)
        if e == "" {
            if p > 0 { port = p }
        }
    }

    server = http.server_create(port)
    if server == 0 {
        println("hub: could not bind ${port}")
        return
    }

    http.server_get(server, "/status", status_handler, 0)
    http.server_post(server, "/se/grid/register", register_node_handler, reg_cell)
    http.server_get(server, "/se/grid/nodecount", node_count_handler, reg_cell)
    http.server_get(server, "/se/grid/status", grid_status_handler, reg_cell)
    // Session routes carry the registry cell (`ud`): the distributor picks a node
    // on newSession, and forward_handler releases a node slot on DELETE. When no
    // node is registered they fall back to local drivers, so the cell is harmless.
    http.server_post(server, "/session", new_session_handler, reg_cell)
    // Session-scoped traffic. `*` matches the rest of the path, so one handler
    // per method covers every W3C command without re-listing the route table.
    http.server_get(server, "/session/*", forward_handler, reg_cell)
    http.server_post(server, "/session/*", forward_handler, reg_cell)
    http.server_delete(server, "/session/*", forward_handler, reg_cell)
    http.server_put(server, "/session/*", forward_handler, reg_cell)

    println("hub: selaenium Grid hub listening on ${port} (distributor + standalone fallback)")
    http.server_start(server)
}
