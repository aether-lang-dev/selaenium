// registry.ae — the Grid node registry: a POOL-OWNED, copy-on-write snapshot.
//
// This is the shared-state substrate distributed Grid needs and standalone mode
// deliberately did without: a hub tracking which Nodes have registered, what
// slots each offers, and which is alive.
//
// ---- why pool-owned COW, not an actor (the honest 0.681 substrate) ----------
//
// std.http dispatches HTTP/1.1 handlers on a worker POOL (cores*2 bare pthreads).
// The natural Aether answer would be an actor: writes serialize in its mailbox,
// no handler holds a lock. We built that first — and hit a hard runtime wall: a
// fire-and-forget `actor ! Msg` sent FROM A POOL-WORKER THREAD is silently
// DROPPED. The send enqueues to the scheduler's single-producer `from_queues`
// slot as an illegitimate second producer, and the message is lost (root-caused
// by the aether team; see aether asks/foreign-c-thread-actor-send-silently-
// dropped.md). So a handler CANNOT hand a Register off to a registry actor today
// — the actor never processes it (the "-1 nodecount" symptom).
//
// The correct RELEASED substrate is therefore: NO actor in the write path. One
// writer model = the pool, serialized by std.snapshot's lock-free CAS. The whole
// registry is a single immutable node-table string held in a snapshot cell.
// register/remove/slot LOAD the current table, build a NEW table with the change
// (the pure _drop_row/_row/_bump_inuse helpers already do exactly this — no
// in-place mutation, which readers forbid), and CAS old->new, retrying if a
// concurrent pool thread won the race. count/available/pick just LOAD and read.
// Every op is callable directly from a @c_callback handler on the pool — no
// cross-thread hand-off, so the send-path bug never bites. And because there is
// exactly one logical writer discipline (CAS the cell), there is no
// two-writers-of-truth aliasing — the thing single-owner-actor protected.
//
// WHEN THE ACTOR RETURNS: once the aether send-path fix lands (foreign C thread
// -> actor sends stop being dropped) AND the hub can run handlers on-scheduler
// (real actor-dispatch), the registry becomes a single-writer ACTOR again and
// pool handlers hand off to it instead of CASing shared state. This module's
// public API (register/remove/count/available/pick over a cell handle) is the
// seam that swap hides behind.
//
// A Node is identified by a string id and carries its base address (where the
// hub proxies sessions), a space-joined list of browser names it can host, its
// max slot count, an in-use count, and a last-heartbeat epoch-ms. The table is a
// "\n"-joined set of "id\taddress\tbrowsers\tmax\tinuse\tlast_ms" rows.
import std.string
import std.time
import std.os
import std.snapshot

// libc: the snapshot cell holds a heap char* (an independent copy of the table
// cstr); strdup makes it, free retires a displaced one. string_to_cstr /
// string_from_cstr bridge Aether strings <-> the heap cstr the cell stores.
extern strdup(s: string) -> ptr
extern free(p: ptr)

// ---- the cell: the whole registry, as one atomically-swapped snapshot --------
// A Registry handle is just the snapshot cell ptr. The hub creates ONE in main
// and passes it as the `ud` of every grid handler; the handlers call the
// functions below with it. No module-global (Aether has none) — the cell travels
// through the handler ud slot, which is exactly what ud is for.

// registry_init() — create an empty registry cell. Call once in main.
registry_init() -> ptr {
    return snapshot.new(_dup(""))
}

// _dup(table) — an independent heap cstr copy of the Aether table string, for
// the cell to own. _read(box) — the table string back out of a loaded cell value.
_dup(table: string) -> ptr { return strdup(string_to_cstr(table)) }
_read(box: ptr) -> string { if box == null { return "" } return string_from_cstr(box) }

// _commit(cell, cur, next_table) — CAS `next_table` (an Aether string) in over
// `cur` (the value loaded to build it). Returns 1 on success, 0 on lost race.
// This is the single point that enforces the two reclamation rules the COW
// discipline needs (aeb's guardrails):
//   - CAS LOSER frees the `next` cstr it built EAGERLY: nobody took it, it never
//     entered the cell, so no reader can hold it — free it now (not the retire
//     path), else every lost race leaks.
//   - CAS WINNER's displaced `cur` may still be held by an in-flight reader, so
//     it must NOT be freed now; it is retired (see _retire).
_commit(cell: ptr, cur: ptr, next_table: string) -> int {
    next = _dup(next_table)
    if snapshot.cas(cell, cur, next) == 1 {
        _retire(cur)
        return 1
    }
    free(next)   // rejected: we own it, free eagerly
    return 0
}

// ---- write ops (CAS loops; safe from any pool handler) ----------------------
// Each: load the current table, build a NEW table (pure helpers — no in-place
// mutation), CAS it in; on a lost race the table changed under us, so retry from
// a FRESH load. Idempotent/serialized: only one thread's CAS wins per generation.

// register(cell, ...) — add or replace a node (idempotent on id).
register(cell: ptr, id: string, address: string, browsers: string, max: int) {
    while 1 == 1 {
        cur = snapshot.load(cell)
        next = string.concat(_drop_row(_read(cur), id), _row(id, address, browsers, max, 0, _now_ms()))
        if _commit(cell, cur, next) == 1 { return }
    }
}

// remove(cell, id) — drop a node.
remove(cell: ptr, id: string) {
    while 1 == 1 {
        cur = snapshot.load(cell)
        if _commit(cell, cur, _drop_row(_read(cur), id)) == 1 { return }
    }
}

// heartbeat(cell, id) — refresh a node's last-seen time (no-op for unknown id).
heartbeat(cell: ptr, id: string) {
    while 1 == 1 {
        cur = snapshot.load(cell)
        if _commit(cell, cur, _touch(_read(cur), id)) == 1 { return }
    }
}

// slot(cell, id, delta) — adjust a node's in-use slot count (+1 assign / -1 release).
slot(cell: ptr, id: string, delta: int) {
    while 1 == 1 {
        cur = snapshot.load(cell)
        if _commit(cell, cur, _bump_inuse(_read(cur), id, delta)) == 1 { return }
    }
}

// ---- heartbeat / staleness --------------------------------------------------
// A node re-POSTs its registration periodically (the hub calls register, which
// refreshes last_ms). A node that STOPS heartbeating is stale after a TTL and
// must not be picked/counted, or the distributor routes to a dead address. Reads
// below operate on a freshness-FILTERED view of the loaded table (a dead node
// vanishes the next time anyone looks, with no write), and sweep() physically
// CAS-prunes the cell so the table doesn't grow without bound.
//
// TTL: SEL_GRID_NODE_TTL ms (default 15000 = ~3 missed 5s heartbeats). <=0
// disables staleness (every node is fresh — for tests that set last_ms by hand).
_ttl_ms() -> long {
    v = os.getenv("SEL_GRID_NODE_TTL")
    if string.length(v) == 0 { return 15000 as long }
    p, e = string.to_int(v)
    if e != "" { return 15000 as long }
    return p as long
}

// _fresh(rows) — the table with rows whose last_ms is older than the TTL dropped.
// TTL<=0 returns rows unchanged.
_fresh(rows: string) -> string {
    ttl = _ttl_ms()
    if ttl <= (0 as long) { return rows }
    cutoff = _now_ms() - ttl
    out = ""
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.length(row) > 0 {
            last = _to_long(_f(_fields(row), 5))
            if last >= cutoff { out = string.concat(out, string.concat(row, "\n")) }
        }
        if nl < 0 { at = string.length(rows) } else { at = line_end + 1 }
    }
    return out
}

// sweep(cell) — CAS-prune stale rows from the cell (physical compaction). A write
// op, safe from any pool handler; a no-op when nothing is stale (CAS of an equal
// table still swaps, so callers should sweep on a cadence, not every request).
sweep(cell: ptr) {
    while 1 == 1 {
        cur = snapshot.load(cell)
        fresh = _fresh(_read(cur))
        if _commit(cell, cur, fresh) == 1 { return }
    }
}

// ---- read ops (lock-free loads; safe from any pool handler) -----------------
// Each reads a FRESHNESS-FILTERED view so a stale (dead) node is never counted
// or picked, even before sweep() has physically removed it.

// count(cell) — how many LIVE nodes are registered.
count(cell: ptr) -> int { return _row_count(_fresh(_read(snapshot.load(cell)))) }

// available(cell, browser) — 1 if some live node hosts `browser` with a free slot.
available(cell: ptr, browser: string) -> int {
    if string.length(_pick(_fresh(_read(snapshot.load(cell))), browser)) > 0 { return 1 }
    return 0
}

// pick_address(cell, browser) — the address of an available live node, "" if none.
pick_address(cell: ptr, browser: string) -> string {
    return _pick(_fresh(_read(snapshot.load(cell))), browser)
}

// pick_node(cell, browser) — (id, address) of an available live node for
// `browser`, or ("", "") if none. Both come from the SAME matched row of one
// (freshness-filtered) load.
pick_node(cell: ptr, browser: string) -> (string, string) {
    return _pick_node(_fresh(_read(snapshot.load(cell))), browser)
}

// hosts(cell, browser) — 1 if ANY LIVE node lists `browser`, regardless of free
// slots. The distributor uses this to tell "all matching nodes are busy"
// (hosts=1, pick empty -> QUEUE and retry) from "no live node hosts this browser
// at all" (hosts=0 -> fall back to a local driver, don't queue forever).
hosts(cell: ptr, browser: string) -> int {
    return _hosts(_fresh(_read(snapshot.load(cell))), browser)
}

// status_json(cell) — the node table as a JSON array.
// status_json(cell) — the LIVE node table as a JSON array
// [{id,address,browsers,max,inuse},...]. Freshness-filtered, so /se/grid/status
// never reports a dead node.
status_json(cell: ptr) -> string {
    return _to_json(_fresh(_read(snapshot.load(cell))))
}

// ---- reclamation: the displaced (successful-CAS) table --------------------
// snapshot's contract (std.snapshot module.ae:14-34): the cell never owns/frees
// its values; a CAS winner gets the displaced ptr back to reclaim, but only
// after a grace period — a concurrent reader (a lookup handler that did
// load()+_pick and then blocked on socket I/O) may still hold it across several
// swaps, so freeing it now is a use-after-free.
//
// A correct bounded retire ring needs shared mutable state across CAS winners
// (push displaced, free the N-generations-old one) — and successive winners run
// concurrently, so that ring itself needs a lock. Released Aether exposes NO
// mutex/lock to .ae (verified: no std.sync/std.mutex, no lock extern), so a
// race-free ring is not buildable here without hand-rolling hazard pointers —
// which the aether owner explicitly advised against for this case.
//
// So we take the documented safe default: DEFER-BY-LEAK. A displaced table is
// never freed; it is retained for the process lifetime. This is bounded and
// tiny: only Register/Remove/Slot/Heartbeat displace a table, each table is a
// few hundred bytes, and a hub sees a handful of registrations/heartbeats — the
// total is trivial next to the driver processes the hub spawns. The CAS-LOSER
// path (the high-frequency one under contention) does NOT leak — it eager-frees
// its rejected `next` in _commit. Only successful mutations retain, so the leak
// is O(number of successful registry writes), not O(requests).
//
// Two paths close this properly, whichever aether ships first:
//   (a) aether#2082 — expose a reclamation primitive (an atomic int) to .ae.
//       That lets this module build a bounded lock-free retire ring (refcount +
//       free the N-generations-old table), the smallest fix and the recommended
//       one. Filed as an issue; if greenlit, the pickup is here in _retire.
//   (b) the actor-return migration — once the foreign-thread send-path fix ships
//       and the registry is a single-writer ACTOR again, the actor owns its old
//       tables and frees them serially (one writer, no lock). Larger.
// Until either lands, DEFER-BY-LEAK (above) is the correct, bounded default.
_retire(displaced: ptr) {
    _kept = displaced   // intentionally retained (see above); freed never.
}

// ---- pure row helpers (unit-testable without an actor) ----------------------
// Rows: "id\taddress\tbrowsers\tmax\tinuse\tlast_ms\n". browsers is a
// space-joined list. Field access is by tab-split; the store never contains a
// tab or newline inside a field (ids/addresses/browser names don't).

_row(id: string, address: string, browsers: string, max: int, inuse: int, now_ms: long) -> string {
    return string.concat(id, string.concat("\t", string.concat(address, string.concat("\t",
        string.concat(browsers, string.concat("\t", string.concat(string.from_int(max), string.concat("\t",
        string.concat(string.from_int(inuse), string.concat("\t",
        string.concat(_long_str(now_ms), "\n")))))))))))
}

// _drop_row(rows, id) — rows with `id`'s row removed (line-anchored on the first
// tab-delimited field).
_drop_row(rows: string, id: string) -> string {
    key = string.concat(id, "\t")
    out = ""
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.starts_with(row, key) == 0 {
            if string.length(row) > 0 { out = string.concat(out, string.concat(row, "\n")) }
        }
        if nl < 0 { return out }
        at = line_end + 1
    }
    return out
}

// _touch(rows, id) — refresh last_ms for id (leaves other fields intact).
_touch(rows: string, id: string) -> string {
    r = _find_row(rows, id)
    if string.length(r) == 0 { return rows }
    f = _fields(r)
    return _drop_and_add(rows, id, _f(f, 0), _f(f, 1), _f(f, 2), _to_int(_f(f, 3)), _to_int(_f(f, 4)), _now_ms())
}

// _bump_inuse(rows, id, delta) — adjust the in-use slot count (clamped >= 0).
_bump_inuse(rows: string, id: string, delta: int) -> string {
    r = _find_row(rows, id)
    if string.length(r) == 0 { return rows }
    f = _fields(r)
    inuse = _to_int(_f(f, 4)) + delta
    if inuse < 0 { inuse = 0 }
    return _drop_and_add(rows, id, _f(f, 0), _f(f, 1), _f(f, 2), _to_int(_f(f, 3)), inuse, _to_long(_f(f, 5)))
}

_drop_and_add(rows: string, id: string, i: string, addr: string, br: string, max: int, inuse: int, last_ms: long) -> string {
    base = _drop_row(rows, id)
    return string.concat(base, _row(i, addr, br, max, inuse, last_ms))
}

// _pick(rows, browser) — the address of the first node that lists `browser` and
// has inuse < max; "" if none.
_pick(rows: string, browser: string) -> string {
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.length(row) > 0 {
            f = _fields(row)
            max = _to_int(_f(f, 3))
            inuse = _to_int(_f(f, 4))
            if inuse < max {
                if _list_has(_f(f, 2), browser) == 1 { return _f(f, 1) }
            }
        }
        if nl < 0 { return "" }
        at = line_end + 1
    }
    return ""
}

// _pick_node — like _pick but returns (id, address) from the matched row.
_pick_node(rows: string, browser: string) -> (string, string) {
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.length(row) > 0 {
            f = _fields(row)
            max = _to_int(_f(f, 3))
            inuse = _to_int(_f(f, 4))
            if inuse < max {
                if _list_has(_f(f, 2), browser) == 1 { return (_f(f, 0), _f(f, 1)) }
            }
        }
        if nl < 0 { return ("", "") }
        at = line_end + 1
    }
    return ("", "")
}

// _hosts — 1 if any row lists `browser` (ignores slot capacity).
_hosts(rows: string, browser: string) -> int {
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.length(row) > 0 {
            if _list_has(_f(_fields(row), 2), browser) == 1 { return 1 }
        }
        if nl < 0 { return 0 }
        at = line_end + 1
    }
    return 0
}

_row_count(rows: string) -> int {
    n = 0
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        if nl < 0 { return n }
        n = n + 1
        at = at + nl + 1
    }
    return n
}

// _to_json(rows) — the node table as a JSON array of {id,address,browsers,max,inuse}.
_to_json(rows: string) -> string {
    out = "["
    first = 1
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.length(row) > 0 {
            f = _fields(row)
            if first == 0 { out = string.concat(out, ",") }
            first = 0
            out = string.concat(out, string.concat("{\"id\":", string.concat(_qs(_f(f, 0)),
                string.concat(",\"address\":", string.concat(_qs(_f(f, 1)),
                string.concat(",\"browsers\":", string.concat(_qs(_f(f, 2)),
                string.concat(",\"max\":", string.concat(_f(f, 3),
                string.concat(",\"inuse\":", string.concat(_f(f, 4), "}")))))))))))
        }
        if nl < 0 { at = string.length(rows) } else { at = line_end + 1 }
    }
    return string.concat(out, "]")
}

// ---- tiny field helpers -----------------------------------------------------
_find_row(rows: string, id: string) -> string {
    key = string.concat(id, "\t")
    at = 0
    while at < string.length(rows) {
        nl = string.index_of(string.substring(rows, at, string.length(rows)), "\n")
        line_end = string.length(rows)
        if nl >= 0 { line_end = at + nl }
        row = string.substring(rows, at, line_end)
        if string.starts_with(row, key) == 1 { return row }
        if nl < 0 { return "" }
        at = line_end + 1
    }
    return ""
}

// _fields(row) — the row itself; _f indexes tab-separated fields of it.
_fields(row: string) -> string { return row }
_f(row: string, i: int) -> string {
    at = 0
    k = 0
    while k < i {
        tb = string.index_of(string.substring(row, at, string.length(row)), "\t")
        if tb < 0 { return "" }
        at = at + tb + 1
        k = k + 1
    }
    tb2 = string.index_of(string.substring(row, at, string.length(row)), "\t")
    if tb2 < 0 { return string.substring(row, at, string.length(row)) }
    return string.substring(row, at, at + tb2)
}

_list_has(space_list: string, item: string) -> int {
    // browsers are space-joined; match a whole token.
    padded = string.concat(" ", string.concat(space_list, " "))
    needle = string.concat(" ", string.concat(item, " "))
    if string.index_of(padded, needle) >= 0 { return 1 }
    return 0
}

_now_ms() -> long { return time.now_ms() }
_long_str(v: long) -> string { return _long_to_str(v) }
_long_to_str(v: long) -> string { return string.from_long(v) }
_to_int(s: string) -> int { v, e = string.to_int(s); if string.length(e) > 0 { return 0 } return v }
// last_ms is epoch-ms — well beyond 32-bit — so parse it as a real long, NOT via
// _to_int (which would overflow). string.to_long round-trips string.from_long.
_to_long(s: string) -> long { v, e = string.to_long(s); if string.length(e) > 0 { return 0 as long } return v }

_qs(v: string) -> string {
    out = "\""
    i = 0
    while i < string.length(v) {
        c = string.substring(v, i, i + 1)
        if c == "\"" { out = string.concat(out, "\\\"") }
        else { out = string.concat(out, c) }
        i = i + 1
    }
    return string.concat(out, "\"")
}
