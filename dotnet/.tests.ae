// .NET binding tests (P/Invoke over System.Runtime.InteropServices). The
// DllImport resolver honors SELENIUM_CORE_LIB, which we point at the shared
// engine artifact this node deps. Built with the `dotnet` on PATH; the projects
// target net8.0 but RUN with `--roll-forward Major` so they launch on whatever
// runtime the box has (e.g. a net8 app on a net10-only box — as on catchyos).
// Tests are a plain console harness (no xunit → no NuGet restore churn). The
// live test spawns its own chromedriver + in-process HttpListener and self-skips
// if chromedriver is absent. SKIPS LOUDLY if dotnet is not on PATH.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    ndir = "${root}/dotnet"
    dnet = "DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1"
    dll = "${ndir}/SeleniumCore.Tests/bin/Release/net8.0/SeleniumCore.Tests.dll"
    // net8-targeted app, launched on whatever runtime is present.
    run = "dotnet exec --roll-forward Major"

    have = os.system("command -v dotnet >/dev/null 2>&1")
    if have != 0 {
        println("dotnet tests: SKIPPED — dotnet not on PATH")
        return 0
    }

    cc = os.system("cd \"${ndir}\" && ${dnet} dotnet build SeleniumCore.Tests/SeleniumCore.Tests.csproj -c Release --nologo -v q")
    if cc != 0 {
        println("dotnet tests: build FAILED")
        return 1
    }
    rc = os.system("cd \"${ndir}\" && ${dnet} SELENIUM_CORE_LIB=\"${lib}\" ${run} \"${dll}\" ffi")
    if rc != 0 {
        println("dotnet tests: ffi FAILED")
        return 1
    }
    rc2 = os.system("cd \"${ndir}\" && ${dnet} SELENIUM_CORE_LIB=\"${lib}\" ${run} \"${dll}\" live")
    if rc2 != 0 {
        println("dotnet tests: live FAILED")
        return 1
    }
    println("dotnet tests: PASSED (ffi + live+surface)")
    return 0
}
