// .NET binding tests (P/Invoke over System.Runtime.InteropServices). The
// DllImport resolver honors SELENIUM_CORE_LIB, which we point at the shared
// engine artifact this node deps. Built + run with `dotnet` (net8.0); tests are
// a plain console harness (no xunit → no NuGet restore churn). The live test
// spawns its own chromedriver + in-process HttpListener and self-skips if
// chromedriver is absent. dotnet lives at ~/.dotnet on this box.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "selenium_core/.build.ae")
    lib = build.dep_artifact(b, "selenium_core/.build.ae", "shared_lib")
    root = build._get(b, "root")
    ndir = "${root}/dotnet"
    dnet = "PATH=\"$HOME/.dotnet:$PATH\" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1"
    dll = "${ndir}/SeleniumCore.Tests/bin/Release/net8.0/SeleniumCore.Tests.dll"

    cc = os.system("cd \"${ndir}\" && ${dnet} dotnet build SeleniumCore.Tests/SeleniumCore.Tests.csproj -c Release --nologo -v q")
    if cc != 0 {
        println("dotnet tests: build FAILED")
        return 1
    }
    rc = os.system("cd \"${ndir}\" && ${dnet} SELENIUM_CORE_LIB=\"${lib}\" dotnet \"${dll}\" ffi")
    if rc != 0 {
        println("dotnet tests: ffi FAILED")
        return 1
    }
    rc2 = os.system("cd \"${ndir}\" && ${dnet} SELENIUM_CORE_LIB=\"${lib}\" dotnet \"${dll}\" live")
    if rc2 != 0 {
        println("dotnet tests: live FAILED")
        return 1
    }
    println("dotnet tests: PASSED (ffi + live+surface)")
    return 0
}
