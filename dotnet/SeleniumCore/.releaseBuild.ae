// Release build: package the verified native matrix attached to this release.
// FreeBSD is excluded because NuGet has no standard FreeBSD RID.
import bldr
import dotnet

aeb(cap) {
    bldr.build() {
        prereq("dotnet:10")
        dep("selenium_core/.releaseNugetMatrix.ae")
        // Generate the release project so the native_runtime() declarations
        // become NuGet package items. build_project_existing() deliberately
        // leaves an existing .csproj untouched and therefore drops these
        // packaging declarations.
        dotnet.build_project() {
            target_framework("net8.0")
            root_namespace("OpenQA.Selenium")
            assembly_name("WebDriver")
            nullable()
            package_id("Selenium.WebDriver")
            package_version("0.1.0")
            native_runtime("linux-x64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "linux_x64"))
            native_runtime("linux-arm64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "linux_arm64"))
            native_runtime("linux-musl-x64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "linux_musl_x64"))
            native_runtime("linux-musl-arm64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "linux_musl_arm64"))
            native_runtime("osx-x64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "osx_x64"))
            native_runtime("osx-arm64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "osx_arm64"))
            native_runtime("win-x64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "win_x64"))
            native_runtime("win-arm64", dep_artifact("selenium_core/.releaseNugetMatrix.ae", "win_arm64"))
        }
    }
}
