// Third-party-consumer EXAMPLE test for the .NET binding.
//
// Restores a consumer app against ONLY a local NuGet feed holding the packaged
// SeleniumCore nupkg (from dotnet/.package.ae) — no source project reference,
// no nuget.org — into a clean dir, then runs it with SELENIUM_CORE_LIB unset
// (env -u) so ONLY the package's bundled runtimes/.../native/.so can satisfy the
// load. The honest "add the NuGet package and it just works" test the in-tree
// dotnet/.tests.ae cannot give (that one references the source project + env var).
//
// Three consumer modes, each in its own fresh process: ffi, discovery, live.
import build
import std.os

aeb(cap) {
    b = build.start()
    build.dep(b, "dotnet/.package.ae")
    nupkg_dir = build.dep_artifact(b, "dotnet/.package.ae", "nupkg_dir")
    root = build._get(b, "root")
    exsrc = "${root}/dotnet/example"
    consumer = "${root}/target/dotnet-consumer"
    // Use the machine's global NuGet cache (it already holds the framework ref
    // packs, so restore stays offline); SeleniumCore itself resolves only from
    // the local feed added by the generated nuget.config below.
    dnet = "DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1"

    // Fresh consumer project: copy the example + csproj, restore/build against
    // the local feed only (LocalFeed = the nupkg dir). Isolated NUGET_PACKAGES
    // so nothing leaks from the machine's global package cache.
    setup = os.system("rm -rf \"${consumer}\" && mkdir -p \"${consumer}\" && cp \"${exsrc}/Program.cs\" \"${consumer}/\" && cp \"${exsrc}/Consumer.csproj\" \"${consumer}/\"")
    if setup != 0 {
        println("dotnet example: staging the consumer project failed")
        return 1
    }
    // A nuget.config adding the local feed FIRST (so SeleniumCore resolves
    // there) while keeping the machine's existing sources for framework ref
    // packs. SeleniumCore is only in the local feed, so nuget.org is never
    // queried for it — the isolation the test needs — but framework packs still
    // resolve from the SDK / global cache.
    cfg = os.system("printf '<?xml version=\"1.0\"?><configuration><packageSources><add key=\"local\" value=\"%s\" /></packageSources></configuration>' \"${nupkg_dir}\" > \"${consumer}/nuget.config\"")
    if cfg != 0 {
        println("dotnet example: writing nuget.config failed")
        return 1
    }
    build_c = os.system("cd \"${consumer}\" && ${dnet} dotnet build Consumer.csproj -c Release --nologo -v q")
    if build_c != 0 {
        println("dotnet example: consumer build against the local feed failed")
        return 1
    }
    dll = "${consumer}/bin/Release/net8.0/linux-x64/Consumer.dll"
    // Sanity: the bundled .so must have been placed next to the app on build.
    rc_so = os.system("find \"${consumer}/bin\" -name libselenium_core.so 2>/dev/null | grep -q .")
    if rc_so != 0 {
        println("dotnet example: restored app is missing the bundled libselenium_core.so")
        return 1
    }

    pfx = "cd \"${consumer}\" && ${dnet} env -u SELENIUM_CORE_LIB dotnet exec --roll-forward Major \"${dll}\""
    rc2 = os.system("${pfx} ffi")
    if rc2 != 0 {
        println("dotnet example: ffi-mode consumer run failed")
        return 1
    }
    rc3 = os.system("${pfx} discovery")
    if rc3 != 0 {
        println("dotnet example: discovery-mode consumer run failed")
        return 1
    }
    rc4 = os.system("${pfx} live")
    if rc4 != 0 {
        println("dotnet example: live-mode consumer run failed")
        return 1
    }

    println("dotnet example: PASS — installed package loaded its bundled .so (ffi + discovery + live)")
    return 0
}
